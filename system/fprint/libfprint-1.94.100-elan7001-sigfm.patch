+/**
+ * fpi_print_sigfm_match:
+ * @print_template: A #FpPrint of type #FPI_PRINT_SIGFM with the enrolled samples
+ * @print: A newly scanned #FpPrint of type #FPI_PRINT_SIGFM (one sample)
+ * @threshold: Minimum geometric consistency score to accept
+ * @error: Return location for error
+ *
+ * Returns: Whether the prints match, @error will be set if #FPI_MATCH_ERROR is returned
+ */
+FpiMatchResult
+fpi_print_sigfm_match (FpPrint *print_template,
+                       FpPrint *print,
+                       gint     threshold,
+                       GError **error)
+{
+  const SigfmImgInfo *probe;
+  gint best = 0;
+
+  if (print_template->type != FPI_PRINT_SIGFM || print->type != FPI_PRINT_SIGFM)
+    {
+      *error = fpi_device_error_new_msg (FP_DEVICE_ERROR_NOT_SUPPORTED,
+                                         "It is only possible to match SIGFM type print data");
+      return FPI_MATCH_ERROR;
+    }
+
+  if (print->prints->len != 1)
+    {
+      *error = fpi_device_error_new_msg (FP_DEVICE_ERROR_GENERAL,
+                                         "New print contains more than one print!");
+      return FPI_MATCH_ERROR;
+    }
+
+  probe = g_ptr_array_index (print->prints, 0);
+
+  for (guint i = 0; i < print_template->prints->len; i++)
+    {
+      gint score = sigfm_match_score (probe, g_ptr_array_index (print_template->prints, i));
+
+      if (score < 0)
+        {
+          *error = fpi_device_error_new_msg (FP_DEVICE_ERROR_DATA_INVALID,
+                                             "SIGFM matcher failed");
+          return FPI_MATCH_ERROR;
+        }
+      best = MAX (best, score);
+    }
+
+  fp_dbg ("sigfm score %d/%d (best of %u samples)", best, threshold, print_template->prints->len);
+
+  return best >= threshold ? FPI_MATCH_SUCCESS : FPI_MATCH_FAIL;
+}
