+/* ---- SIGFM keypoint extraction (small-area sensors) ---- */
+
+#define SIGFM_MIN_KEYPOINTS 25
+
+static void
+sigfm_vflip (guint8 *data, gint width, gint height)
+{
+  g_autofree guint8 *row = g_malloc (width);
+
+  for (gint i = 0; i < height / 2; i++)
+    {
+      guint8 *a = data + i * width, *b = data + (height - i - 1) * width;
+      memcpy (row, a, width);
+      memcpy (a, b, width);
+      memcpy (b, row, width);
+    }
+}
+
+static void
+sigfm_hflip (guint8 *data, gint width, gint height)
+{
+  for (gint i = 0; i < height; i++)
+    for (gint j = 0; j < width / 2; j++)
+      {
+        guint8 t = data[i * width + j];
+        data[i * width + j] = data[i * width + width - j - 1];
+        data[i * width + width - j - 1] = t;
+      }
+}
+
+static void
+sigfm_invert (guint8 *data, gint width, gint height)
+{
+  for (gint i = 0; i < width * height; i++)
+    data[i] = 0xff - data[i];
+}
+static const gchar sigfm_task_marker = 's';
