--- /dev/null
+++ b/libfprint/sigfm/meson.build
@@ -0,0 +1,23 @@
+# SIGFM keypoint matcher. Only the OpenCV modules it uses are linked
+# (fprintd runs as root: keep the loaded code minimal).
+opencv_pc = dependency('opencv5', required: false)
+opencv_mods = ['opencv_core', 'opencv_imgproc', 'opencv_flann', 'opencv_features']
+if not opencv_pc.found()
+    opencv_pc = dependency('opencv4', version: '>=4.5.0')
+    opencv_mods = ['opencv_core', 'opencv_imgproc', 'opencv_flann', 'opencv_features2d']
+endif
+
+opencv_dep = [opencv_pc.partial_dependency(compile_args: true, includes: true)]
+foreach m : opencv_mods
+    opencv_dep += cpp.find_library(m)
+endforeach
+
+libsigfm = static_library('sigfm',
+    'sigfm.cpp',
+    dependencies: opencv_dep,
+    cpp_args: ['-std=c++17'],
+    gnu_symbol_visibility: 'hidden',
+    install: false)
+
+sigfm_dep = declare_dependency(link_with: libsigfm,
+    dependencies: opencv_dep)
diff --git a/libfprint/sigfm/sigfm.cpp b/libfprint/sigfm/sigfm.cpp
new file mode 100644
index 0000000..0251622
--- /dev/null
+++ b/libfprint/sigfm/sigfm.cpp
@@ -0,0 +1,345 @@
+/*
+ * SIGFM: SIFT keypoint matcher for small-area fingerprint sensors.
+ *
+ * Algorithm: Matthieu Charette, Natasha England-Elbro, Timur Mangliev
+ * (goodix-fp-linux-dev/libfprint, LGPL-2.1-or-later).
+ * This version: OpenCV 4/5, strict serialization, total match ordering,
+ * NaN-safe geometry and bounded work per comparison.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#include "sigfm.hpp"
+
+#include <opencv2/core.hpp>
+#if __has_include(<opencv2/features.hpp>)
+#include <opencv2/features.hpp> /* OpenCV 5 */
+#else
+#include <opencv2/features2d.hpp> /* OpenCV 4 */
+#endif
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <set>
+#include <tuple>
+#include <vector>
+
+struct SigfmImgInfo
+{
+  std::vector<cv::KeyPoint> keypoints;
+  cv::Mat                   descriptors; /* CV_32F, one row per keypoint */
+};
+
+namespace {
+
+constexpr double distance_match = 0.75;  /* Lowe ratio test */
+constexpr double length_match = 0.05;
+constexpr double angle_match = 0.05;
+constexpr std::size_t min_match = 5;
+
+/* Hard limits: protect against corrupted templates and runaway work. */
+constexpr std::uint32_t max_keypoints = 4096;
+constexpr std::uint32_t sift_desc_cols = 128;
+constexpr std::size_t max_pairs = 120;      /* unique matches considered (keeps a match < ~20 ms) */
+constexpr std::size_t max_angles = 3000;    /* angle pairs considered */
+
+constexpr char magic[4] = { 'S', 'G', 'F', '2' };
+constexpr std::size_t kp_bytes = 5 * sizeof (float) + 2 * sizeof (std::int32_t);
+
+struct Match
+{
+  cv::Point2i p1, p2;
+  bool operator< (const Match &o) const
+  {
+    /* Total order: the original compared only p1.y, silently merging
+     * distinct matches that shared a row. */
+    return std::tie (p1.y, p1.x, p2.y, p2.x) <
+           std::tie (o.p1.y, o.p1.x, o.p2.y, o.p2.x);
+  }
+};
+
+struct Angle
+{
+  double cos, sin;
+};
+
+inline double
+clamp1 (double v)
+{
+  return std::max (-1.0, std::min (1.0, v));
+}
+
+inline bool
+ratio_close (double a, double b, double tol)
+{
+  const double hi = std::max (a, b);
+  if (!(hi > 0.0))
+    return false;
+  return 1.0 - std::min (a, b) / hi <= tol;
+}
+
+template<typename T> void
+put (std::vector<unsigned char> &out, T v)
+{
+  const auto *p = reinterpret_cast<const unsigned char *> (&v);
+  out.insert (out.end (), p, p + sizeof (T));
+}
+
+template<typename T> bool
+get (const unsigned char *&cur, const unsigned char *end, T &v)
+{
+  if (static_cast<std::size_t> (end - cur) < sizeof (T))
+    return false;
+  std::memcpy (&v, cur, sizeof (T));
+  cur += sizeof (T);
+  return true;
+}
+
+} // namespace
+
+extern "C" {
+
+SigfmImgInfo *
+sigfm_extract (const unsigned char *pix, int width, int height)
+{
+  if (!pix || width <= 0 || height <= 0)
+    return nullptr;
+  try
+    {
+      cv::Mat img (height, width, CV_8UC1, const_cast<unsigned char *> (pix));
+      auto info = new SigfmImgInfo{};
+      cv::SIFT::create ()->detectAndCompute (img, cv::noArray (),
+                                             info->keypoints, info->descriptors);
+      if (info->keypoints.size () > max_keypoints)
+        {
+          /* keep the strongest responses */
+          std::vector<int> idx (info->keypoints.size ());
+          for (std::size_t i = 0; i < idx.size (); i++)
+            idx[i] = static_cast<int> (i);
+          std::sort (idx.begin (), idx.end (), [&] (int a, int b) {
+            return info->keypoints[a].response > info->keypoints[b].response;
+          });
+          idx.resize (max_keypoints);
+          std::vector<cv::KeyPoint> kp;
+          cv::Mat desc (static_cast<int> (max_keypoints), info->descriptors.cols, CV_32F);
+          for (std::size_t i = 0; i < idx.size (); i++)
+            {
+              kp.push_back (info->keypoints[idx[i]]);
+              info->descriptors.row (idx[i]).copyTo (desc.row (static_cast<int> (i)));
+            }
+          info->keypoints = std::move (kp);
+          info->descriptors = desc;
+        }
+      return info;
+    }
+  catch (...)
+    {
+      return nullptr;
+    }
+}
+
+void
+sigfm_free_info (SigfmImgInfo *info)
+{
+  delete info;
+}
+
+SigfmImgInfo *
+sigfm_copy_info (const SigfmImgInfo *info)
+{
+  if (!info)
+    return nullptr;
+  try
+    {
+      return new SigfmImgInfo{ info->keypoints, info->descriptors.clone () };
+    }
+  catch (...)
+    {
+      return nullptr;
+    }
+}
+
+int
+sigfm_keypoints_count (const SigfmImgInfo *info)
+{
+  return info ? static_cast<int> (info->keypoints.size ()) : 0;
+}
+
+int
+sigfm_match_score (const SigfmImgInfo *frame, const SigfmImgInfo *enrolled)
+{
+  if (!frame || !enrolled)
+    return -1;
+  try
+    {
+      if (frame->descriptors.empty () || enrolled->descriptors.empty ())
+        return 0;
+
+      std::vector<std::vector<cv::DMatch>> knn;
+      cv::BFMatcher::create ()->knnMatch (frame->descriptors,
+                                          enrolled->descriptors, knn, 2);
+
+      std::set<Match> unique;
+      for (const auto &pair : knn)
+        {
+          if (pair.size () < 2)
+            continue;
+          const cv::DMatch &m = pair[0];
+          if (m.distance < distance_match * pair[1].distance)
+            unique.insert (Match{ frame->keypoints.at (m.queryIdx).pt,
+                                  enrolled->keypoints.at (m.trainIdx).pt });
+        }
+      if (unique.size () < min_match)
+        return 0;
+
+      std::vector<Match> matches (unique.begin (), unique.end ());
+      if (matches.size () > max_pairs)
+        matches.resize (max_pairs);
+
+      std::vector<Angle> angles;
+      for (std::size_t j = 0; j < matches.size () && angles.size () < max_angles; j++)
+        for (std::size_t k = j + 1; k < matches.size () && angles.size () < max_angles; k++)
+          {
+            const Match &a = matches[j], &b = matches[k];
+            const double v1x = a.p1.x - b.p1.x, v1y = a.p1.y - b.p1.y;
+            const double v2x = a.p2.x - b.p2.x, v2y = a.p2.y - b.p2.y;
+            const double l1 = std::hypot (v1x, v1y), l2 = std::hypot (v2x, v2y);
+
+            if (l1 == 0.0 || l2 == 0.0 || !ratio_close (l1, l2, length_match))
+              continue;
+
+            const double prod = l1 * l2;
+            angles.push_back (Angle{
+              M_PI / 2 + std::asin (clamp1 ((v1x * v2x + v1y * v2y) / prod)),
+              std::acos (clamp1 ((v1x * v2y - v1y * v2x) / prod)) });
+          }
+
+      if (angles.size () < min_match)
+        return 0;
+
+      int count = 0;
+      for (std::size_t j = 0; j < angles.size (); j++)
+        for (std::size_t k = j + 1; k < angles.size (); k++)
+          if (ratio_close (angles[j].sin, angles[k].sin, angle_match) &&
+              ratio_close (angles[j].cos, angles[k].cos, angle_match))
+            count++;
+
+      return count;
+    }
+  catch (...)
+    {
+      return -1;
+    }
+}
+
+unsigned char *
+sigfm_serialize_binary (const SigfmImgInfo *info, int *outlen)
+{
+  if (!info || !outlen)
+    return nullptr;
+  try
+    {
+      const auto n = static_cast<std::uint32_t> (info->keypoints.size ());
+      const auto cols = static_cast<std::uint32_t> (info->descriptors.cols);
+      if (n > max_keypoints ||
+          (n > 0 && (cols != sift_desc_cols ||
+                     info->descriptors.type () != CV_32F ||
+                     static_cast<std::uint32_t> (info->descriptors.rows) != n)))
+        return nullptr;
+
+      std::vector<unsigned char> out;
+      out.insert (out.end (), magic, magic + sizeof (magic));
+      put<std::uint32_t> (out, n);
+      put<std::uint32_t> (out, n ? cols : 0);
+      for (const auto &kp : info->keypoints)
+        {
+          put<float> (out, kp.pt.x);
+          put<float> (out, kp.pt.y);
+          put<float> (out, kp.size);
+          put<float> (out, kp.angle);
+          put<float> (out, kp.response);
+          put<std::int32_t> (out, kp.octave);
+          put<std::int32_t> (out, kp.class_id);
+        }
+      if (n)
+        {
+          cv::Mat d = info->descriptors.isContinuous () ? info->descriptors
+                                                        : info->descriptors.clone ();
+          const auto *p = d.ptr<unsigned char> (0);
+          out.insert (out.end (), p, p + static_cast<std::size_t> (n) * cols * sizeof (float));
+        }
+
+      auto *buf = static_cast<unsigned char *> (std::malloc (out.size ()));
+      if (!buf)
+        return nullptr;
+      std::memcpy (buf, out.data (), out.size ());
+      *outlen = static_cast<int> (out.size ());
+      return buf;
+    }
+  catch (...)
+    {
+      return nullptr;
+    }
+}
+
+SigfmImgInfo *
+sigfm_deserialize_binary (const unsigned char *bytes, int len)
+{
+  if (!bytes || len < static_cast<int> (sizeof (magic) + 8))
+    return nullptr;
+  try
+    {
+      const unsigned char *cur = bytes, *end = bytes + len;
+      if (std::memcmp (cur, magic, sizeof (magic)) != 0)
+        return nullptr;
+      cur += sizeof (magic);
+
+      std::uint32_t n = 0, cols = 0;
+      if (!get (cur, end, n) || !get (cur, end, cols))
+        return nullptr;
+      if (n > max_keypoints || (n > 0 && cols != sift_desc_cols) || (n == 0 && cols != 0))
+        return nullptr;
+
+      const std::size_t need = static_cast<std::size_t> (n) * kp_bytes +
+                               static_cast<std::size_t> (n) * cols * sizeof (float);
+      if (static_cast<std::size_t> (end - cur) != need)
+        return nullptr;
+
+      auto info = new SigfmImgInfo{};
+      info->keypoints.reserve (n);
+      for (std::uint32_t i = 0; i < n; i++)
+        {
+          float x = 0, y = 0, size = 0, angle = 0, response = 0;
+          std::int32_t octave = 0, class_id = 0;
+          const bool ok = get (cur, end, x) && get (cur, end, y) &&
+                          get (cur, end, size) && get (cur, end, angle) &&
+                          get (cur, end, response) && get (cur, end, octave) &&
+                          get (cur, end, class_id);
+          if (!ok || !std::isfinite (x) || !std::isfinite (y) || !std::isfinite (size) ||
+              !std::isfinite (angle) || !std::isfinite (response))
+            {
+              delete info;
+              return nullptr;
+            }
+          info->keypoints.emplace_back (cv::Point2f (x, y), size, angle, response, octave, class_id);
+        }
+      if (n)
+        {
+          info->descriptors.create (static_cast<int> (n), static_cast<int> (cols), CV_32F);
+          std::memcpy (info->descriptors.data, cur, static_cast<std::size_t> (n) * cols * sizeof (float));
+        }
+      return info;
+    }
+  catch (...)
+    {
+      return nullptr;
+    }
+}
+
+} /* extern "C" */
