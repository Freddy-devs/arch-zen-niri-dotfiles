+/* Press sensor: average the newest frames of a still finger (sensor noise),
+ * then upscale bilinearly so SIFT gets enough scale space. No stitching:
+ * stitching near-identical frames of a still finger corrupts the image. */
+static void
+elanspi_fp_frame_press_submit (FpiDeviceElanSpi *self)
+{
+  const gint w = self->frame_width, h = self->frame_height;
+  const gint s = ELANSPI_PRESS_UPSCALE;
+  guint n = MIN (g_slist_length (self->fp_frame_list), ELANSPI_PRESS_AVG_FRAMES);
+  g_autofree guint8 *avg = g_malloc (w * h);
+  FpImage *img;
+
+  for (gint px = 0; px < w * h; px++)
+    {
+      guint sum = 0;
+      GSList *l = self->fp_frame_list;   /* prepended: head is newest */
+      for (guint i = 0; i < n; i++, l = l->next)
+        sum += ((struct fpi_frame *) l->data)->data[px];
+      avg[px] = sum / n;
+    }
+
+  img = fp_image_new (w * s, h * s);
+  for (gint y = 0; y < h * s; y++)
+    for (gint x = 0; x < w * s; x++)
+      {
+        gdouble fx = MAX (0.0, (x + 0.5) / s - 0.5), fy = MAX (0.0, (y + 0.5) / s - 0.5);
+        gint x0 = MIN ((gint) fx, w - 1), y0 = MIN ((gint) fy, h - 1);
+        gint x1 = MIN (x0 + 1, w - 1), y1 = MIN (y0 + 1, h - 1);
+        gdouble ax = fx - x0, ay = fy - y0;
+        gdouble v = (1 - ay) * ((1 - ax) * avg[y0 * w + x0] + ax * avg[y0 * w + x1]) +
+                    ay * ((1 - ax) * avg[y1 * w + x0] + ax * avg[y1 * w + x1]);
+        img->data[y * w * s + x] = (guint8) CLAMP (v + 0.5, 0, 255);
+      }
+  img->flags |= FPI_IMAGE_COLORS_INVERTED;
+
+  fp_dbg ("<fp_frame> press capture: %u/%u frames averaged, %dx%d image",
+          n, g_slist_length (self->fp_frame_list), w * s, h * s);
+  fpi_image_device_image_captured (FP_IMAGE_DEVICE (self), img);
+
+  g_slist_free_full (g_steal_pointer (&self->fp_frame_list), g_free);
+}
