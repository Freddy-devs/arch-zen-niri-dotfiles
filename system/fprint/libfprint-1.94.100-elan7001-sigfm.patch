+  SigfmImgInfo  *info;
+  unsigned char *image;
+  FpiImageFlags  flags;
+  gboolean       image_changed;
+} DetectSigfmData;
+
+static void
+fp_image_detect_sigfm_free (DetectSigfmData *data)
+{
+  g_clear_pointer (&data->info, sigfm_free_info);
+  if (data->image_changed)
+    g_clear_pointer (&data->image, g_free);
+  g_free (data);
+}
+
+static void
+fp_image_detect_sigfm_thread_func (GTask        *task,
+                                   gpointer      source_object,
+                                   gpointer      task_data,
+                                   GCancellable *cancellable)
+{
+  g_autoptr(GTimer) timer = g_timer_new ();
+  g_autoptr(GTask) thread_task = g_steal_pointer (&task);
+  FpImage *self = source_object;
+  DetectSigfmData *ret = g_new0 (DetectSigfmData, 1);
+  FpiImageFlags norm = FPI_IMAGE_H_FLIPPED | FPI_IMAGE_V_FLIPPED | FPI_IMAGE_COLORS_INVERTED;
+  int kps;
+
+  ret->flags = self->flags & ~norm;
+  ret->image = self->data;
+  if (self->flags & norm)
+    {
+      ret->image = g_memdup2 (self->data, self->width * self->height);
+      ret->image_changed = TRUE;
+      if (self->flags & FPI_IMAGE_H_FLIPPED)
+        sigfm_hflip (ret->image, self->width, self->height);
+      if (self->flags & FPI_IMAGE_V_FLIPPED)
+        sigfm_vflip (ret->image, self->width, self->height);
+      if (self->flags & FPI_IMAGE_COLORS_INVERTED)
+        sigfm_invert (ret->image, self->width, self->height);
+    }
+
+  ret->info = sigfm_extract (ret->image, self->width, self->height);
+  kps = sigfm_keypoints_count (ret->info);
+  fp_dbg ("sigfm extract: %d keypoints in %f secs", kps, g_timer_elapsed (timer, NULL));
+
+  if (g_task_had_error (thread_task))
+    {
+      fp_image_detect_sigfm_free (ret);
+      return;
+    }
+
+  if (!ret->info || kps < SIGFM_MIN_KEYPOINTS)
+    {
+      fp_image_detect_sigfm_free (ret);
+      g_task_return_new_error (thread_task, G_IO_ERROR, G_IO_ERROR_FAILED,
+                               "Not enough keypoints found (%d)", kps);
+      return;
+    }
+
+  g_task_return_pointer (thread_task, ret, (GDestroyNotify) fp_image_detect_sigfm_free);
+}
+
+gboolean
+fpi_image_task_is_sigfm (GTask *task)
+{
+  return g_task_get_task_data (task) == &sigfm_task_marker;
+}
+
+gboolean
+fpi_image_detect_sigfm_finish (FpImage *self, GTask *task, GError **error)
+{
+  DetectSigfmData *data = g_task_propagate_pointer (task, error);
+
+  if (!data)
+    return FALSE;
+
+  self->flags = data->flags;
+  if (data->image_changed)
+    {
+      g_clear_pointer (&self->data, g_free);
+      self->data = g_steal_pointer (&data->image);
+      data->image_changed = FALSE;
+    }
+  g_clear_pointer (&self->sigfm_info, sigfm_free_info);
+  self->sigfm_info = g_steal_pointer (&data->info);
+  fp_image_detect_sigfm_free (data);
+  return TRUE;
+}
+
+/**
+ * fpi_image_detect_sigfm:
+ *
+ * Like fp_image_detect_minutiae() but extracts SIGFM keypoints instead.
+ * Finish with fp_image_detect_minutiae_finish().
+ */
+void
+fpi_image_detect_sigfm (FpImage            *self,
+                        GCancellable       *cancellable,
+                        GAsyncReadyCallback callback,
+                        gpointer            user_data)
+{
+  g_autoptr(GTask) task = NULL;
+
+  g_return_if_fail (FP_IS_IMAGE (self));
+  g_return_if_fail (callback != NULL);
+
+  task = g_task_new (self, cancellable, callback, user_data);
+  g_task_set_source_tag (task, fp_image_detect_minutiae);
+  g_task_set_task_data (task, (gpointer) &sigfm_task_marker, NULL);
+  g_task_set_check_cancellable (task, TRUE);
+
+  if (!g_atomic_int_compare_and_exchange (&self->detection_in_progress,
+                                          FALSE, TRUE))
+    {
+      g_task_return_new_error (task, G_IO_ERROR, G_IO_ERROR_ADDRESS_IN_USE,
+                               "Minutiae detection is already in progress");
+      return;
+    }
+
+  g_task_run_in_thread (g_steal_pointer (&task), fp_image_detect_sigfm_thread_func);
+}
+
+const SigfmImgInfo *
+fpi_image_get_sigfm_info (FpImage *self)
+{
+  return self->sigfm_info;
+}
+
