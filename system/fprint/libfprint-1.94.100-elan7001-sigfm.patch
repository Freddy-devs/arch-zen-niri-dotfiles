+/*
+ * SIGFM: SIFT keypoint matcher for small-area fingerprint sensors.
+ *
+ * Based on the SIGFM algorithm by Matthieu Charette, Natasha England-Elbro
+ * and Timur Mangliev (goodix-fp-linux-dev/libfprint, LGPL-2.1-or-later).
+ * Rewritten for libfprint 1.94.100 and OpenCV 4/5: bounds-checked versioned
+ * serialization, total ordering of matches, NaN-safe geometry.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#pragma once
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct SigfmImgInfo SigfmImgInfo;
+
+/* Extracts SIFT keypoints/descriptors from an 8-bit greyscale image.
+ * Returns NULL on failure. */
+SigfmImgInfo *sigfm_extract (const unsigned char *pix,
+                             int                  width,
+                             int                  height);
+
+void sigfm_free_info (SigfmImgInfo *info);
+
+SigfmImgInfo *sigfm_copy_info (const SigfmImgInfo *info);
+
+int sigfm_keypoints_count (const SigfmImgInfo *info);
+
+/* Geometric consistency score between two prints (>= 0), or -1 on error. */
+int sigfm_match_score (const SigfmImgInfo *frame,
+                       const SigfmImgInfo *enrolled);
+
+/* Serialized buffer must be released with g_free()/free(). NULL on error. */
+unsigned char *sigfm_serialize_binary (const SigfmImgInfo *info,
+                                       int                *outlen);
+
+/* Strictly validated; returns NULL for any malformed or oversized input. */
+SigfmImgInfo *sigfm_deserialize_binary (const unsigned char *bytes,
+                                        int                  len);
+
+#ifdef __cplusplus
+}
+#endif
