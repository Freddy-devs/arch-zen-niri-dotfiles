#!/usr/bin/env python3
# Personaliza Brave Origin (brave-origin-bin) para que combine con el escritorio:
#   - toma los colores del tema GTK del sistema (Colloid-Dark-Nord) y sigue su modo oscuro
#   - pestañas verticales a la izquierda, colapsadas (solo iconos, no se abren al pasar el
#     cursor; se despliegan con el botón de arriba), sin barra de título
#   - al abrir, continúa donde lo dejaste (ventanas y pestañas)
#   - ahorro de memoria: duerme las pestañas que no usas, salvo WhatsApp, Teams y Outlook
#     (esas quedan siempre activas para recibir notificaciones al instante)
#   - zen-tab-sleep (~/.local/share/zen-tab-sleep): extensión que duerme cada pestaña que no
#     usas hace 2 minutos; el Ahorro de memoria de Brave solo lo hace tras horas. Se carga con
#     --load-extension en ~/.config/brave-origin-flags.conf (este script añade la línea)
# Brave debe estar cerrado: si está abierto sobrescribe las preferencias al salir.
# Uso: zen-brave-theme [--wait]   (--wait espera a que cierres Brave y luego aplica)

import glob, json, os, subprocess, sys, time

# sitios que nunca se duermen (notificaciones en tiempo real)
SIEMPRE_ACTIVOS = [
    "web.whatsapp.com",
    "teams.microsoft.com", "teams.live.com", "teams.cloud.microsoft",
    "outlook.office.com", "outlook.office365.com", "outlook.live.com", "outlook.cloud.microsoft",
]

# carpeta del perfil de Origin (se busca por si Brave cambia el nombre)
_found = sorted(glob.glob(os.path.expanduser("~/.config/BraveSoftware/*Origin*")))
BASE = _found[0] if _found else os.path.expanduser("~/.config/BraveSoftware/Brave-Origin")
PREFS = os.path.join(BASE, "Default", "Preferences")
FLAGS = os.path.expanduser("~/.config/brave-origin-flags.conf")
TAB_SLEEP = os.path.expanduser("~/.local/share/zen-tab-sleep")
STATE = os.path.join(BASE, "Local State")


def running():
    return subprocess.run(["pgrep", "-f", "^/opt/brave-origin-bin/"], capture_output=True).returncode == 0


def patch(path, changes):
    data = {}
    if os.path.exists(path):
        with open(path) as f:
            data = json.load(f)
    for key, value in changes.items():
        node = data
        *parents, leaf = key.split(".")
        for p in parents:
            node = node.setdefault(p, {})
        node[leaf] = value
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".zen-tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, separators=(",", ":"))
    os.replace(tmp, path)


def add_tab_sleep_flag():
    # brave-origin lee el archivo línea a línea sin expandir ~, por eso la ruta va completa
    if not os.path.isfile(os.path.join(TAB_SLEEP, "manifest.json")):
        return
    lines = open(FLAGS).read().splitlines() if os.path.exists(FLAGS) else []
    lines = [l for l in lines if not l.startswith("--load-extension=")]
    lines.append("--load-extension=" + TAB_SLEEP)
    with open(FLAGS, "w") as f:
        f.write("\n".join(lines) + "\n")


add_tab_sleep_flag()          # no toca el perfil: vale aunque Brave esté abierto (aplica al reiniciarlo)

if running():
    if "--wait" not in sys.argv:
        sys.exit("Cierra Brave primero (o usa: zen-brave-theme --wait)")
    print("Esperando a que cierres Brave…")
    while running():
        time.sleep(1)
    time.sleep(1)

patch(PREFS, {
    "extensions.theme.id": "",
    "extensions.theme.system_theme": 1,                 # 1 = colores del tema GTK
    "browser.custom_chrome_frame": True,                # sin barra de título del sistema
    "brave.tabs.vertical_tabs_enabled": True,
    "brave.tabs.vertical_tabs_on_right": False,
    "brave.tabs.vertical_tabs_collapsed": True,                 # solo iconos
    "brave.tabs.vertical_tabs_floating_enabled": False,         # no se despliega al pasar el cursor
    "brave.tabs.vertical_tabs_expanded_state_per_window": False,
    "brave.tabs.vertical_tabs_show_title_on_window": False,
    "session.restore_on_startup": 1,                    # 1 = continuar donde lo dejaste
    "performance_tuning.tab_discarding.exceptions": SIEMPRE_ACTIVOS,
    "performance_tuning.tab_discarding.exceptions_with_time": {s: time.time() for s in SIEMPRE_ACTIVOS},
})
patch(STATE, {
    "brave.dark_mode": 0,                               # 0 = seguir al sistema (prefer-dark)
    "performance_tuning.high_efficiency_mode.state": 2,         # 2 = ahorro de memoria activado
    "performance_tuning.high_efficiency_mode.aggressiveness": 1,  # 1 = equilibrado
})
print("Listo: abre Brave Origin para ver el tema del sistema y las pestañas a la izquierda.")
