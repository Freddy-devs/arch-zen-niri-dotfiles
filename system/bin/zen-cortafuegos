#!/usr/bin/env bash
# zen-cortafuegos — deja ufw como el ÚNICO cortafuegos, con la "caja fuerte" de arch-zen-niri:
#   ENTRADA cerrada (sin puertos abiertos), SALIDA libre, no responde a ping (invisible en la red),
#   registro de bloqueos bajo (journalctl -k -g UFW). Se puede correr las veces que sea: no borra
#   las reglas propias que ya tenga ufw. Lo llama install.sh; a mano: sudo zen-cortafuegos
#   Estado: sudo ufw status verbose
# nftables.service se desactiva: su nftables.conf empieza con "flush ruleset" y al arrancar borraría
# las reglas de ufw (ufw también vive en nftables, vía iptables-nft).
# Los túneles de zen-traspaso abren/cierran sus reglas en ufw al encender/apagar.
set -eu
((EUID == 0)) || { echo "Usa: sudo zen-cortafuegos" >&2; exit 1; }

pacman -S --needed --noconfirm ufw >/dev/null

systemctl disable --now nftables >/dev/null 2>&1 || true
nft list table inet zen_filter >/dev/null 2>&1 && nft delete table inet zen_filter

ufw default deny incoming >/dev/null
ufw default allow outgoing >/dev/null
ufw default deny routed >/dev/null      # nada se reenvía (si algún día usas podman: ufw default allow routed)
ufw logging low >/dev/null

# sin responder a ping (IPv4 e IPv6), salvo dentro del túnel de zen-traspaso para probar la conexión
sed -i 's/^\(-A ufw-before-input -p icmp --icmp-type echo-request -j\) ACCEPT$/\1 DROP/' /etc/ufw/before.rules
sed -i 's/^\(-A ufw6-before-input -p icmpv6 --icmpv6-type echo-request -j\) ACCEPT$/\1 DROP/' /etc/ufw/before6.rules
grep -q 'zen-traspaso' /etc/ufw/before.rules ||
    sed -i '/^-A ufw-before-input -p icmp --icmp-type echo-request -j DROP$/i -A ufw-before-input -i zen-traspaso -p icmp --icmp-type echo-request -j ACCEPT' /etc/ufw/before.rules

ufw --force enable >/dev/null
systemctl enable --now ufw >/dev/null 2>&1 || true
ufw reload >/dev/null

LC_ALL=C ufw status verbose | sed -n '1,4p'
echo "✔ ufw es el cortafuegos: entrada cerrada, salida libre, sin ping"
