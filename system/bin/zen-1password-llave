#!/usr/bin/env bash
# zen-1password-llave: guarda la contraseña de 1Password de cada usuario cifrada con el TPM
# (systemd-creds, host+tpm2) y la entrega solo tras pasar por polkit (huella con zen-polkit).
# Se llama con pkexec desde ~/.local/bin/zen-1password-unlock; nunca recibe la contraseña por argumentos.
#   guardar  lee la contraseña por stdin y la cifra
#   leer     la descifra por stdout
#   borrar   la elimina
set -euo pipefail
umask 077

[[ $EUID -eq 0 ]] || { echo "zen-1password-llave: ejecútalo con pkexec" >&2; exit 1; }
uid=${PKEXEC_UID:-}
[[ $uid =~ ^[0-9]+$ ]] && (( uid >= 1000 )) || { echo "zen-1password-llave: solo vía pkexec desde un usuario" >&2; exit 1; }

dir=/var/lib/zen-1password
cred="$dir/$uid.cred"
name="zen-1password-$uid"

case ${1:-} in
    guardar)
        install -d -m711 "$dir"   # 711: cada usuario puede ver si existe su .cred, no leerlo
        pass=$(cat)
        [[ -n $pass ]] || { echo "contraseña vacía" >&2; exit 1; }
        printf '%s' "$pass" | systemd-creds encrypt --with-key=host+tpm2 --name="$name" - "$cred.tmp"
        mv -f "$cred.tmp" "$cred"
        ;;
    leer)
        [[ -f $cred ]] || { echo "no hay contraseña guardada" >&2; exit 2; }
        systemd-creds decrypt --name="$name" "$cred" -
        ;;
    borrar)
        rm -f "$cred"
        ;;
    *)
        echo "uso: pkexec zen-1password-llave guardar|leer|borrar" >&2; exit 1 ;;
esac
