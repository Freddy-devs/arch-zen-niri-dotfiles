#!/usr/bin/env bash
# Primer inicio de sesión: bienvenida. El sistema trae solo lo mínimo; aquí se sugiere qué instalar
# con zen-apps y no se instala nada sin que el usuario lo pida. Se ejecuta una sola vez.

MARK="$HOME/.config/zen-niri-first-login.done"
[[ -e $MARK ]] && exit 0

if [[ "${1:-}" != --run ]]; then
    exec alacritty --title "Bienvenida" -e "$0" --run
fi

set -u
mkdir -p "$(dirname "$MARK")" && touch "$MARK"

cat <<'EOF'

  Bienvenido a arch-zen-niri

  El sistema viene con lo mínimo para ir rápido y gastar pocos recursos:
  escritorio, terminal, red, audio, Bluetooth y seguridad. Lo demás lo eliges tú.

  Instalar aplicaciones (navegador, oficina, bases de datos, lenguajes…):

      zen-apps                 menú: Tab marca varias, Enter instala
      zen-apps brave wps       directo por nombre
      zen-apps --list          ver todo lo disponible

  Sugeridas:  brave · wps · claude · herdr · php · mariadb · postgresql · podman · node

  Atajos: Super+Enter terminal · Super+Space lanzador · Super+A calendario · Super+F1 todos

EOF
read -rp "  ¿Abrir el menú de zen-apps ahora? [s/N] " ans
if [[ $ans == [sSyY]* ]]; then
    zen-apps
    read -rp "  Enter para cerrar " _
fi
