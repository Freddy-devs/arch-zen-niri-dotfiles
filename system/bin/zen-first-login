#!/usr/bin/env bash
# Primer inicio de sesión: instala Claude Code y herdr con sus instaladores oficiales
# en ~/.local/bin (por usuario, se auto-actualizan). Se ejecuta una sola vez.

MARK="$HOME/.config/zen-niri-first-login.done"
[[ -e $MARK ]] && exit 0

if [[ "${1:-}" != --run ]]; then
    exec alacritty --title "Configuración inicial" -e "$0" --run
fi

set -u
echo "== Configuración inicial de arch-zen-niri =="
echo

until curl -fsS --max-time 5 -o /dev/null https://claude.ai; do
    echo "Sin conexión a internet. Conéctate (icono de red en la barra) y pulsa Enter..."
    read -r
done

ok=1
echo "--> Claude Code (instalador nativo oficial de Anthropic)"
if command -v claude >/dev/null || [[ -x $HOME/.local/bin/claude ]]; then
    echo "    ya instalado"
else
    curl -fsSL https://claude.ai/install.sh | bash || ok=0
fi

echo
echo "--> herdr (instalador oficial de herdr.dev)"
if [[ -x $HOME/.local/bin/herdr ]]; then
    echo "    ya instalado"
else
    curl -fsSL https://herdr.dev/install.sh | sh || ok=0
fi

echo
if (( ok )); then
    mkdir -p "$(dirname "$MARK")" && touch "$MARK"
    echo "Listo. Abre una terminal (Super+Enter) y ejecuta: claude  /  herdr"
else
    echo "Hubo errores; se volverá a intentar en el próximo inicio de sesión."
fi
echo "Pulsa Enter para cerrar."
read -r
