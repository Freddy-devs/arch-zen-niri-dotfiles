#!/usr/bin/env bash
# zen-traspaso — túneles WireGuard a pedido con los PCs de la red local (pasar archivos, entrar por SSH).
#
# Respeta la "caja fuerte" del cortafuegos: no queda nada abierto ni habilitado al arrancar.
# Cada PC se registra una vez con su código (solo datos públicos) y luego se conecta o apaga
# desde el panel de la barra (zen-tuneles) o aquí:
#   zen-traspaso codigo               código de este PC para pegarlo en el otro (no necesita root)
#   sudo zen-traspaso preparar        llaves de este PC (una vez)
#   sudo zen-traspaso agregar CODIGO  registra otro PC con el código que copiaste de él
#   sudo zen-traspaso quitar PC       lo borra de la lista (y lo desconecta)
#   sudo zen-traspaso conectar PC     túnel + SSH solo dentro del túnel + reglas de cortafuegos
#   sudo zen-traspaso desconectar PC  corta ese PC; si era el último, apaga todo
#   sudo zen-traspaso apagar          quita todo: túnel, SSH y reglas
#   zen-traspaso estado               lista de PCs y cuáles están conectados
#
# Para que dos PCs se vean, los dos aprietan «Conectar» (cada uno abre su lado). Abre solo:
# UDP 51820 desde la red local (WireGuard no responde a quien no tenga una llave registrada) y
# TCP 22 desde dentro del túnel. sshd escucha solo en la IP del túnel, sin contraseñas, solo con
# la llave del PC conectado (from= su IP del túnel) y solo para tu usuario. El sshd del sistema no se toca.
# La IP del túnel de cada PC (10.77.x.y) sale de su llave pública: no hay que repartir IPs.
# Copiar:  rsync -avP carpeta/ USUARIO@IP_DEL_TUNEL:~/Recibido/
set -u

IF=zen-traspaso
PORT=51820
DIR=/etc/wireguard
KEY=$DIR/$IF.key
ETC=/etc/zen-traspaso                  # yo.pub, yo.ip y pcs/NOMBRE (todo público)
RUN=/run/zen-traspaso/activos          # un archivo por PC conectado (lo lee la barra)
SSH_UNIT=zen-traspaso-ssh
TAG=zen-traspaso                       # comentario de las reglas nft y de authorized_keys
if [[ -n ${PKEXEC_UID:-} ]]; then USUARIO=$(id -nu "$PKEXEC_UID"); else USUARIO=${SUDO_USER:-$(id -un)}; fi
CASA=$(getent passwd "$USUARIO" | cut -d: -f6)

ok()   { printf '\e[32m✔\e[0m %s\n' "$*"; }
warn() { printf '\e[33m!\e[0m %s\n' "$*"; }
die()  { printf '\e[31m✘\e[0m %s\n' "$*" >&2; exit 1; }
root() { ((EUID == 0)) || die "Usa: sudo zen-traspaso $1"; }

# interfaz y red de la ruta por defecto (la LAN real, sea cable o Wi-Fi)
lan_dev() { ip -4 route show default | awk '{for (i=1;i<NF;i++) if ($i=="dev") {print $(i+1); exit}}'; }
lan_ip()  { ip -4 -br addr show dev "$(lan_dev)" | awk '{split($3,a,"/"); print a[1]}'; }
lan_net() { ip -4 route show dev "$(lan_dev)" scope link | awk '/proto kernel/ {print $1; exit}'; }

# IP del túnel a partir de la llave pública: los dos lados la calculan igual sin ponerse de acuerdo
tunel_ip() {
    local h; h=$(printf %s "$1" | sha256sum)
    echo "10.77.$((16#${h:0:2} % 254 + 1)).$((16#${h:2:2} % 254 + 1))"
}

nombre_valido() { [[ $1 =~ ^[a-z0-9][a-z0-9-]{0,31}$ ]]; }
campo() { sed -n "s/^$2=//p" "$ETC/pcs/$1" | head -1; }

reglas_handles() { nft -a list chain inet zen_filter input 2>/dev/null | awk -v t="\"$TAG\"" '$0 ~ "comment " t {print $NF}'; }

preparar() {
    root preparar
    install -d -m700 "$DIR"
    install -d -m755 "$ETC" "$ETC/pcs"
    [[ -s $KEY ]] || (umask 077; wg genkey > "$KEY")
    ssh-keygen -A >/dev/null                         # llaves de host de sshd si faltan
    local pub; pub=$(wg pubkey < "$KEY")
    echo "$pub" > "$ETC/yo.pub"
    tunel_ip "$pub" > "$ETC/yo.ip"
    chmod 644 "$ETC/yo.pub" "$ETC/yo.ip"
    # la configuración de wg-quick de la versión anterior (un solo PC fijo) ya no se usa
    rm -f "$DIR/$IF.conf"
    ok "Este PC está listo (IP del túnel: $(cat "$ETC/yo.ip"))"
}

# zt1:nombre:usuario:ip_lan:llave_wg:llave_ssh — todo público, se puede mandar por chat
codigo() {
    [[ -s $ETC/yo.pub ]] || die "Primero: sudo zen-traspaso preparar"
    local ssh=$CASA/.ssh/id_ed25519 ip; ip=$(lan_ip)
    [[ -n $ip ]] || die "Sin red: conéctate a la red local primero"
    if [[ ! -s $ssh.pub ]]; then
        ((EUID == 0)) && die "Genera tu llave SSH sin sudo: zen-traspaso codigo"
        install -d -m700 "$CASA/.ssh"
        ssh-keygen -q -t ed25519 -N '' -f "$ssh" -C "$USUARIO@$(uname -n)" || die "No se pudo crear tu llave SSH"
    fi
    local nombre; nombre=$(uname -n | tr 'A-Z_' 'a-z-' | tr -cd 'a-z0-9-' | cut -c1-32)
    echo "zt1:${nombre:-pc}:$USUARIO:$ip:$(cat "$ETC/yo.pub"):$(awk '{print $2}' "$ssh.pub")"
}

agregar() {
    root agregar
    [[ -s $ETC/yo.pub ]] || preparar >/dev/null
    local cod=${1:-} v nombre usuario ip wg ssh
    IFS=: read -r v nombre usuario ip wg ssh <<<"$cod"
    [[ $v == zt1 ]] || die "Código inválido (debe empezar con zt1:)"
    nombre_valido "$nombre" || die "Nombre de PC inválido: «$nombre»"
    [[ $usuario =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || die "Usuario inválido: «$usuario»"
    [[ $ip =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || die "IP inválida: «$ip»"
    [[ $wg =~ ^[A-Za-z0-9+/]{43}=$ ]] || die "Llave WireGuard inválida"
    [[ $ssh =~ ^AAAAC3NzaC1lZDI1NTE5[A-Za-z0-9+/=]+$ ]] || die "Llave SSH inválida (debe ser ed25519)"
    [[ $wg != "$(cat "$ETC/yo.pub")" ]] || die "Ese es el código de este mismo PC: pega el del otro"
    local tip; tip=$(tunel_ip "$wg")
    [[ $tip != "$(cat "$ETC/yo.ip")" ]] || die "Choque de IPs del túnel ($tip): vuelve a generar la llave de un PC"
    # el mismo PC (misma llave) con otro nombre: se renombra; otro PC con el mismo nombre: se numera
    local f
    for f in "$ETC"/pcs/*; do
        [[ -e $f ]] || continue
        [[ $(sed -n 's/^wg=//p' "$f") == "$wg" && ${f##*/} != "$nombre" ]] && { desconectar "${f##*/}" >/dev/null; rm -f "$f"; }
    done
    if [[ -e $ETC/pcs/$nombre && $(campo "$nombre" wg) != "$wg" ]]; then
        local n=2; while [[ -e $ETC/pcs/$nombre-$n ]]; do ((n++)); done; nombre=$nombre-$n
    fi
    printf 'usuario=%s\nip=%s\nwg=%s\nssh=%s\ntunel=%s\n' "$usuario" "$ip" "$wg" "$ssh" "$tip" > "$ETC/pcs/$nombre"
    chmod 644 "$ETC/pcs/$nombre"
    # si ya estaba conectado (p. ej. cambió su IP), se actualiza al vuelo
    [[ -e $RUN/$nombre ]] && conectar "$nombre" >/dev/null
    ok "PC «$nombre» registrado (IP del túnel: $tip). Conéctalo con: sudo zen-traspaso conectar $nombre"
}

quitar() {
    root quitar
    local pc=${1:-}
    nombre_valido "$pc" && [[ -e $ETC/pcs/$pc ]] || die "No existe el PC «$pc»"
    desconectar "$pc" >/dev/null
    rm -f "$ETC/pcs/$pc"
    ok "PC «$pc» borrado de la lista"
}

encender_base() {
    nft list chain inet zen_filter input >/dev/null 2>&1 || die "El cortafuegos zen_filter no está cargado (sudo systemctl restart nftables)"
    local net yo; net=$(lan_net); yo=$(cat "$ETC/yo.ip")
    [[ -n $net ]] || die "Sin red local"
    # una interfaz de la versión anterior (wg-quick, IP fija 10.77.0.x) se rehace
    if ip link show "$IF" >/dev/null 2>&1 && ! ip -4 -br addr show dev "$IF" | grep -q " $yo/"; then
        ip link del "$IF"
    fi
    if ! ip link show "$IF" >/dev/null 2>&1; then
        ip link add "$IF" type wireguard || die "No se pudo crear la interfaz $IF"
        wg set "$IF" private-key "$KEY" listen-port "$PORT" || { ip link del "$IF"; die "No se pudo configurar WireGuard"; }
        ip -4 addr add "$yo/16" dev "$IF"
        ip link set "$IF" up
    fi
    if [[ -z $(reglas_handles) ]]; then
        nft insert rule inet zen_filter input ip saddr "$net" udp dport "$PORT" accept comment "\"$TAG\""
        nft insert rule inet zen_filter input iifname "$IF" tcp dport 22 accept comment "\"$TAG\""
        nft insert rule inet zen_filter input iifname "$IF" icmp type echo-request accept comment "\"$TAG\""
    fi
    if ! systemctl is-active -q "$SSH_UNIT"; then
        systemctl reset-failed "$SSH_UNIT" 2>/dev/null
        systemd-run -q --unit="$SSH_UNIT" --description="SSH solo dentro del túnel zen-traspaso" \
            /usr/bin/sshd -D -e -o ListenAddress="$yo" -o PasswordAuthentication=no \
            -o KbdInteractiveAuthentication=no -o PermitRootLogin=no -o AllowUsers="$USUARIO" \
            -o AuthenticationMethods=publickey -o X11Forwarding=no -o AllowTcpForwarding=no \
            || die "No arrancó sshd del túnel (journalctl -u $SSH_UNIT)"
        sleep 1
        systemctl is-active -q "$SSH_UNIT" || die "sshd del túnel se cayó: journalctl -u $SSH_UNIT"
    fi
}

conectar() {
    root conectar
    local pc=${1:-}
    nombre_valido "$pc" && [[ -e $ETC/pcs/$pc ]] || die "No existe el PC «$pc» (agrégalo primero)"
    [[ -s $KEY && -s $ETC/yo.ip ]] || preparar >/dev/null
    encender_base
    local wg tip
    wg=$(campo "$pc" wg); tip=$(campo "$pc" tunel)
    wg set "$IF" peer "$wg" endpoint "$(campo "$pc" ip):$PORT" allowed-ips "$tip/32" persistent-keepalive 25 \
        || die "No se pudo agregar el PC al túnel"
    # su llave SSH solo vale desde su IP del túnel, sin reenvíos, y solo mientras esté conectado
    local ak=$CASA/.ssh/authorized_keys
    install -d -m700 -o "$USUARIO" -g "$(id -gn "$USUARIO")" "$CASA/.ssh"
    [[ -f $ak ]] && sed -i "/ $TAG:$pc\$/d; / $TAG\$/d" "$ak"   # la línea anterior de este PC (y la de la versión vieja)
    printf 'from="%s",no-port-forwarding,no-agent-forwarding,no-X11-forwarding ssh-ed25519 %s %s:%s\n' \
        "$tip" "$(campo "$pc" ssh)" "$TAG" "$pc" >> "$ak"
    chown "$USUARIO": "$ak"; chmod 600 "$ak"
    install -d -m755 -o "$USUARIO" -g "$(id -gn "$USUARIO")" "$CASA/Recibido"
    install -d -m755 "$RUN"
    : > "$RUN/$pc"
    ok "conectado con «$pc»: entra con  ssh $(campo "$pc" usuario)@$tip  (él a ti: $USUARIO@$(cat "$ETC/yo.ip"))"
    echo "  El otro PC también tiene que conectar este lado. Al terminar: sudo zen-traspaso desconectar $pc"
}

desconectar() {
    root desconectar
    local pc=${1:-}
    nombre_valido "$pc" || die "Nombre de PC inválido"
    if [[ -e $ETC/pcs/$pc ]] && ip link show "$IF" >/dev/null 2>&1; then
        wg set "$IF" peer "$(campo "$pc" wg)" remove 2>/dev/null
    fi
    [[ -f $CASA/.ssh/authorized_keys ]] && sed -i "/ $TAG:$pc\$/d" "$CASA/.ssh/authorized_keys"
    rm -f "$RUN/$pc"
    if [[ -z $(ls -A "$RUN" 2>/dev/null) ]]; then
        apagar >/dev/null
        ok "«$pc» desconectado; no quedaba ningún otro: túnel apagado"
    else
        ok "«$pc» desconectado"
    fi
}

apagar() {
    root apagar
    systemctl stop "$SSH_UNIT" 2>/dev/null
    systemctl reset-failed "$SSH_UNIT" 2>/dev/null
    local h; for h in $(reglas_handles); do nft delete rule inet zen_filter input handle "$h"; done
    ip link show "$IF" >/dev/null 2>&1 && ip link del "$IF"
    [[ -f $CASA/.ssh/authorized_keys ]] && sed -i "/ $TAG:[a-z0-9-]*\$/d; / $TAG\$/d" "$CASA/.ssh/authorized_keys"
    rm -rf "$RUN"
    ok "apagado: sin túnel, sin SSH y el cortafuegos vuelve a estar cerrado"
}

estado() {
    [[ -s $ETC/yo.ip ]] && echo "Este PC: $(cat "$ETC/yo.ip")" || echo "Este PC aún no está preparado (sudo zen-traspaso preparar)"
    ip link show "$IF" >/dev/null 2>&1 && ok "túnel $IF arriba" || echo "túnel apagado"
    systemctl is-active -q "$SSH_UNIT" && ok "SSH del túnel escuchando" || echo "SSH del túnel apagado"
    local f pc
    for f in "$ETC"/pcs/*; do
        [[ -e $f ]] || continue
        pc=${f##*/}
        printf '  %-20s %-16s %s\n' "$pc" "$(campo "$pc" tunel)" "$([[ -e $RUN/$pc ]] && echo conectado || echo apagado)"
    done
    ((EUID == 0)) && ip link show "$IF" >/dev/null 2>&1 && wg show "$IF" | sed 's/^/  /'
    return 0
}

case ${1:-} in
    codigo) codigo ;;
    preparar) preparar ;;
    agregar) shift; agregar "$@" ;;
    quitar) shift; quitar "$@" ;;
    conectar) shift; conectar "$@" ;;
    desconectar) shift; desconectar "$@" ;;
    apagar) apagar ;;
    estado|"") estado ;;
    *) sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
