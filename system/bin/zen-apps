#!/usr/bin/env bash
# zen-apps — instala aplicaciones opcionales. La ISO trae solo lo mínimo; cada quien elige lo suyo.
#
# Uso:
#   zen-apps                 menú (Tab marca varias, Enter instala)
#   zen-apps brave wps ...   instala esas directamente
#   zen-apps --list          lista lo disponible
#
# Nada de lo que instala arranca solo en segundo plano: los servicios (MariaDB, PostgreSQL, php-fpm,
# Podman) quedan apagados hasta que el usuario los encienda con el comando que se muestra al final.
set -uo pipefail

[[ $EUID -eq 0 ]] && { echo "Ejecútalo como tu usuario (sin sudo); pedirá la contraseña cuando haga falta."; exit 1; }

c_b=$'\033[1;34m'; c_g=$'\033[1;32m'; c_y=$'\033[1;33m'; c_r=$'\033[1;31m'; c_d=$'\033[2m'; c_0=$'\033[0m'
log()  { printf '%s==>%s %s\n' "$c_b" "$c_0" "$*"; }
ok()   { printf '%s ✓ %s %s\n' "$c_g" "$c_0" "$*"; }
warn() { printf '%s ! %s %s\n' "$c_y" "$c_0" "$*"; }
NEXT=()   # comandos sugeridos al terminar
pac()  { sudo pacman -S --needed --noconfirm "$@"; }
aur()  { yay -S --needed --noconfirm --answerclean None --answerdiff None "$@"; }

# id | descripción | tamaño aproximado
CATALOG=(
    "brave|Navegador Brave|~400 MB"
    "wps|WPS Office en español (Writer, Spreadsheets, Presentation)|~1 GB"
    "claude|Claude Code (instalador oficial, se actualiza solo)|~200 MB"
    "herdr|herdr (instalador oficial)|~30 MB"
    "php|PHP + php-fpm + Composer (mysql, pgsql, gd, intl, sqlite…)|~60 MB"
    "mariadb|MariaDB (cliente mysql) solo en localhost, apagada|~250 MB"
    "postgresql|PostgreSQL, apagado|~60 MB"
    "podman|Podman sin root + compose + buildah (alias docker)|~150 MB"
    "node|Node.js + npm|~80 MB"
    "go|Go|~250 MB"
    "rust|Rust (rustup: cargo, rustc)|~600 MB"
    "gh|GitHub CLI|~40 MB"
    "huella|Lector de huella (fprintd) para login y sudo|~10 MB"
    "gui|Herramientas gráficas: pavucontrol, blueman, nwg-look|~40 MB"
)

install_one() {
    case "$1" in
        brave)  aur brave-bin ;;
        wps)    aur wps-office wps-office-mui-es-es ttf-wps-fonts ;;
        claude) curl -fsSL https://claude.ai/install.sh | bash ;;
        herdr)  curl -fsSL https://herdr.dev/install.sh | sh ;;
        php)
            pac php php-fpm php-pgsql php-gd php-intl php-sqlite composer || return
            for ext in mysqli pdo_mysql pgsql pdo_pgsql gd intl sqlite3 pdo_sqlite iconv bcmath zip sodium; do
                sudo sed -i "s/^;extension=$ext$/extension=$ext/" /etc/php/php.ini
            done
            tz=$(timedatectl show -p Timezone --value 2>/dev/null || echo America/Lima)
            sudo sed -i "s|^;date.timezone =.*|date.timezone = $tz|" /etc/php/php.ini
            NEXT+=("php-fpm (solo si lo usas):  sudo systemctl start php-fpm")
            ;;
        mariadb)
            pac mariadb || return
            # solo escucha en la propia laptop (nunca en la red)
            sudo install -Dm644 /dev/stdin /etc/my.cnf.d/zen-mariadb.cnf <<'EOF'
[mysqld]
bind-address = 127.0.0.1
skip-name-resolve
local-infile = 0
EOF
            if [[ ! -d /var/lib/mysql/mysql ]]; then
                sudo chattr +C /var/lib/mysql 2>/dev/null || true
                sudo mariadb-install-db --user=mysql --basedir=/usr --datadir=/var/lib/mysql >/dev/null
            fi
            NEXT+=("MariaDB:  sudo systemctl start mariadb   (al arrancar el equipo: enable --now)")
            ;;
        postgresql)
            pac postgresql || return
            if [[ ! -f /var/lib/postgres/data/PG_VERSION ]]; then
                sudo chattr +C /var/lib/postgres 2>/dev/null || true
                sudo install -d -o postgres -g postgres /var/lib/postgres/data
                sudo -u postgres initdb --locale=C.UTF-8 --encoding=UTF8 -D /var/lib/postgres/data >/dev/null
            fi
            NEXT+=("PostgreSQL:  sudo systemctl start postgresql")
            ;;
        podman)
            pac podman podman-compose buildah passt netavark aardvark-dns || return
            # imágenes cortas ("nginx") resuelven a Docker Hub
            echo 'unqualified-search-registries = ["docker.io"]' \
                | sudo install -Dm644 /dev/stdin /etc/containers/registries.conf.d/10-docker-hub.conf
            grep -q "^$USER:" /etc/subuid || sudo usermod --add-subuids 100000-165535 --add-subgids 100000-165535 "$USER"
            NEXT+=("Podman no necesita servicio. API compatible con Docker (solo si la pides):  systemctl --user start podman.socket")
            ;;
        node)   pac nodejs npm ;;
        go)     pac go ;;
        rust)
            pac rustup || return
            rustup default stable
            ;;
        gh)     pac github-cli ;;
        huella)
            pac fprintd || return
            NEXT+=("Registrar la huella:  sudo zen-hwsetup  → opción 5")
            ;;
        gui)    pac pavucontrol blueman nwg-look ;;
        *)      warn "No conozco «$1». Mira: zen-apps --list"; return 1 ;;
    esac
}

list() {
    for e in "${CATALOG[@]}"; do
        IFS='|' read -r id desc size <<<"$e"
        printf '  %s%-11s%s %-62s %s%s%s\n' "$c_g" "$id" "$c_0" "$desc" "$c_d" "$size" "$c_0"
    done
}

case "${1:-}" in
    -h|--help) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -l|--list) list; exit 0 ;;
esac

if (( $# )); then
    PICK=("$@")
else
    command -v fzf >/dev/null || { list; echo; echo "Instala con: zen-apps <nombre> ..."; exit 0; }
    mapfile -t PICK < <(list | fzf --multi --ansi --reverse --height 70% --border rounded \
        --prompt "apps › " --header "Tab: marcar varias · Enter: instalar · Esc: salir" \
        | sed 's/\x1b\[[0-9;]*m//g' | awk '{print $1}')
    (( ${#PICK[@]} )) || exit 0
fi

curl -fsS --max-time 8 -o /dev/null https://archlinux.org || { echo "${c_r}Sin internet.${c_0} Conéctate (clic en la red de la barra) y reintenta."; exit 1; }

FAILED=()
for app in "${PICK[@]}"; do
    echo
    log "$app"
    if install_one "$app"; then ok "$app instalado"; else FAILED+=("$app"); fi
done

echo
if (( ${#NEXT[@]} )); then
    log "Para encender lo que instalaste (nada arranca solo):"
    printf '    %s\n' "${NEXT[@]}"
fi
(( ${#FAILED[@]} )) && { warn "Fallaron: ${FAILED[*]} (puedes reintentar: zen-apps ${FAILED[*]})"; exit 1; }
exit 0
