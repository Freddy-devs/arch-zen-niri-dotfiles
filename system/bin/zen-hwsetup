#!/usr/bin/env bash
# zen-hwsetup — ajustes de hardware para el sistema instalado (ASUS VivoBook X510UNO y similares).
# Uso:  zen-hwsetup              menú interactivo
#       zen-hwsetup --auto       solo los ajustes seguros (térmico + energía + GPU en ahorro), sin preguntas
#       zen-hwsetup --nvidia     instala el driver propietario NVIDIA 580xx sin menú
#       zen-hwsetup --nvidia-off apaga la NVIDIA (no carga su driver)  ·  --nvidia-on la vuelve a encender
# Todo es local: no descarga nada salvo la opción "NVIDIA propietario", que usa yay.
set -euo pipefail

[[ $EUID -eq 0 ]] || exec sudo "$0" "$@"
# en la ISO live no se aplica (solo en un chroot o en el sistema instalado)
[[ -d /run/archiso ]] && ! systemd-detect-virt -q --chroot && { echo "Ejecútalo en el sistema instalado (en la ISO live usa zen-hwcheck)."; exit 1; }

USR="${SUDO_USER:-$(logname 2>/dev/null || echo root)}"
c_b=$'\033[1;34m'; c_g=$'\033[1;32m'; c_y=$'\033[1;33m'; c_0=$'\033[0m'
log()  { printf '%s==>%s %s\n' "$c_b" "$c_0" "$*"; }
done_(){ printf '  %s✓%s %s\n' "$c_g" "$c_0" "$*"; }
warn() { printf '  %s!%s %s\n' "$c_y" "$c_0" "$*"; }
ask()  { local v; read -rp "$1 [$2]: " v; printf '%s' "${v:-$2}"; }
confirm() { [[ $(ask "$1 (s/n)" "${2:-s}") =~ ^[sSyY] ]]; }

BAT=$(ls -d /sys/class/power_supply/BAT* 2>/dev/null | head -1 || true)
NV=$(lspci -D -d 10de: 2>/dev/null | awk '/3D|VGA/{print $1; exit}')
# dentro de arch-chroot solo se habilitan servicios, no se arrancan
NOW=--now; systemd-detect-virt -q --chroot && NOW=""

# ---------------------------------------------------------------- térmico y energía
setup_power() {
    log "Control térmico y perfiles de energía"
    systemctl enable $NOW thermald.service >/dev/null 2>&1 && done_ "thermald activo (evita sobrecalentamiento del i5)" || warn "thermald no disponible"
    systemctl enable $NOW power-profiles-daemon.service >/dev/null 2>&1 && done_ "power-profiles-daemon activo (perfil: $(powerprofilesctl get 2>/dev/null || echo '?'))" || warn "power-profiles-daemon no disponible"
    # el touchpad, wifi y bluetooth entran en ahorro sin cortar la conexión
    install -Dm644 /dev/stdin /etc/NetworkManager/conf.d/10-zen-wifi-powersave.conf <<'EOF'
[connection]
# 3 = ahorro activado (iwlwifi lo gestiona bien en la AC 8265)
wifi.powersave = 3
EOF
    done_ "Ahorro de energía del Wi-Fi activado"
}

# ---------------------------------------------------------------- GPU NVIDIA
gpu_powersave() {
    [[ -n $NV ]] || return 0
    # con nouveau o sin driver, la MX150 se apaga sola si el control de energía está en "auto"
    install -Dm644 /dev/stdin /etc/udev/rules.d/80-zen-nvidia-pm.rules <<'EOF'
# GPU NVIDIA en ahorro automático (se apaga cuando nada la usa)
ACTION=="add|bind", SUBSYSTEM=="pci", ATTR{vendor}=="0x10de", ATTR{class}=="0x030000|0x030200", TEST=="power/control", ATTR{power/control}="auto"
EOF
    echo auto > "/sys/bus/pci/devices/$NV/power/control" 2>/dev/null || true
    done_ "GPU NVIDIA en ahorro automático (estado: $(cat "/sys/bus/pci/devices/$NV/power/runtime_status" 2>/dev/null || echo '?'))"
}

# con el driver propietario cargado la MX150 (Pascal) nunca se apaga; sin él, gpu_powersave la apaga.
# El paquete queda instalado: 'sudo modprobe nvidia' o --nvidia-on la vuelven a usar
gpu_off() {
    [[ -n $NV ]] || { warn "No hay GPU NVIDIA"; return; }
    install -Dm644 /dev/stdin /etc/modprobe.d/zen-nvidia-off.conf <<'EOF'
# NVIDIA apagada: el driver no se carga al arrancar (se revierte con: sudo zen-hwsetup --nvidia-on)
blacklist nvidia
blacklist nvidia_drm
blacklist nvidia_modeset
blacklist nvidia_uvm
EOF
    gpu_powersave
    done_ "NVIDIA apagada desde el próximo arranque (todo va en la Intel). Reinicia para aplicarlo"
}

gpu_on() {
    rm -f /etc/modprobe.d/zen-nvidia-off.conf
    modprobe nvidia 2>/dev/null && modprobe nvidia_drm 2>/dev/null && modprobe nvidia_uvm 2>/dev/null \
        && done_ "Driver NVIDIA cargado de nuevo" || warn "No se pudo cargar el driver NVIDIA ahora; reinicia"
}

# quita lockdown= de los parámetros del kernel, sea cual sea el gestor de arranque
kernel_param_drop() {
    local f n=0
    for f in /boot/loader/entries/*.conf /efi/loader/entries/*.conf; do
        [[ -f $f ]] && grep -q "lockdown=" "$f" || continue
        sed -i -E "/^options/ s/ ?$1=[^ ]*//" "$f"; n=$((n + 1))
    done
    if [[ -f /etc/kernel/cmdline ]] && grep -q "$1=" /etc/kernel/cmdline; then
        sed -i -E "s/ ?$1=[^ ]*//" /etc/kernel/cmdline; n=$((n + 1))
    fi
    if [[ -f /etc/default/grub ]] && grep -q "$1=" /etc/default/grub; then
        sed -i -E "s/ ?$1=[^ \"]*//" /etc/default/grub
        grub-mkconfig -o /boot/grub/grub.cfg >/dev/null; n=$((n + 1))
    fi
    ((n > 0)) && done_ "Parámetro $1 quitado del arranque ($n archivos)" || done_ "El arranque no tenía $1"
}

install_nvidia() {
    [[ -n $NV ]] || { warn "No hay GPU NVIDIA"; return; }
    log "Driver propietario NVIDIA 580xx para $(lspci -s "$NV" | sed 's/.*: //')"
    # DKMS compila el módulo para cada kernel con headers (zen y el de respaldo lts)
    local hdr=() k
    for k in $(pacman -Qq | grep -E '^linux(-zen|-lts)?$'); do hdr+=("$k-headers"); done
    pacman -S --needed --noconfirm dkms "${hdr[@]}"
    # el nvidia-utils oficial (590+) ya no soporta Pascal y choca con el 580xx: se cambia por este
    # (-dd: nvidia-prime depende de "nvidia-utils", que el 580xx también provee)
    pacman -Q nvidia-utils &>/dev/null && pacman -Rdd --noconfirm nvidia-utils
    sudo -u "$USR" yay -S --needed --noconfirm nvidia-580xx-dkms nvidia-580xx-utils
    pacman -Q nvidia-580xx-utils &>/dev/null || { warn "No se instaló nvidia-580xx-utils"; return 1; }
    # prime-run, ya con el 580xx instalado (si no, arrastraría el nvidia-utils oficial)
    pacman -S --needed --noconfirm nvidia-prime
    modinfo -k "$(uname -r)" nvidia >/dev/null 2>&1 || { warn "El módulo nvidia no se compiló: revisa la salida de dkms"; return 1; }
    # el hook kms metería nouveau en el initramfs; la Intel sigue con arranque gráfico temprano
    sed -i -E 's/^(HOOKS=.*) kms /\1 /' /etc/mkinitcpio.conf
    grep -qE '^MODULES=\(.*i915' /etc/mkinitcpio.conf || sed -i -E 's/^MODULES=\((.*)\)/MODULES=(\1 i915)/; s/^MODULES=\( /MODULES=(/' /etc/mkinitcpio.conf
    mkinitcpio -P >/dev/null
    done_ "initramfs regenerado (nouveau fuera, i915 temprano)"
    # el módulo DKMS no está firmado: con lockdown el kernel se negaría a cargarlo
    kernel_param_drop lockdown
    gpu_powersave
    done_ "Driver NVIDIA instalado. Reinicia; luego: prime-run <app>  ·  nvidia-smi"
}

setup_nvidia() {
    [[ -n $NV ]] || { warn "No hay GPU NVIDIA"; return; }
    log "GPU NVIDIA $(lspci -s "$NV" | sed 's/.*: //')"
    cat <<'EOT'
  1) Solo Intel + NVIDIA en ahorro  (más batería, todo el escritorio va en la Intel)
  2) Driver propietario NVIDIA 580xx (juegos/CUDA 12/3D con 'prime-run app'; la MX150 es Pascal
     y los drivers actuales de Arch ya no la soportan; se compila desde el AUR, necesita internet;
     Pascal no se apaga sola con este driver y se quita lockdown del kernel)
  3) Apagar la NVIDIA dejando el driver instalado (se revierte con: zen-hwsetup --nvidia-on)
EOT
    case "$(ask "Elige" 1)" in
        2) install_nvidia ;;
        3) gpu_off ;;
        *) gpu_powersave ;;
    esac
}

# ---------------------------------------------------------------- batería
setup_battery() {
    [[ -n $BAT && -w $BAT/charge_control_end_threshold ]] || { warn "Este equipo no permite limitar la carga"; return; }
    local MIN=60 MAX=90
    [[ -r /etc/zen-charge-limit.conf ]] && . /etc/zen-charge-limit.conf
    log "Rango de carga de la batería (actual: $MIN–$MAX%)"
    echo "  Con el cargador siempre enchufado: carga hasta el máximo y no vuelve a cargar hasta bajar al mínimo."
    local max min
    max=$(ask "Porcentaje máximo (60-100)" "$MAX")
    min=$(ask "Porcentaje mínimo para volver a cargar (20-$max)" "$MIN")
    [[ $max =~ ^[0-9]+$ && $min =~ ^[0-9]+$ ]] && ((max >= 60 && max <= 100 && min >= 20 && min < max)) ||
        { warn "Valores inválidos"; return; }
    printf '# Rango de carga de la batería (zen-charge-limit.service). Cambia con: sudo zen-hwsetup\nMIN=%s\nMAX=%s\n' \
        "$min" "$max" > /etc/zen-charge-limit.conf
    rm -f /etc/udev/rules.d/90-zen-battery.rules      # el tope fijo de antes chocaría con el servicio
    systemctl enable zen-charge-limit.service >/dev/null 2>&1
    systemctl restart zen-charge-limit.service
    done_ "La batería se mantendrá entre $min% y $max%"
}

# ---------------------------------------------------------------- huella
setup_fingerprint() {
    command -v fprintd-enroll >/dev/null || { warn "fprintd no instalado: zen-apps huella"; return; }
    if fprintd-list "$USR" 2>&1 | grep -qi 'No devices available'; then
        warn "libfprint no reconoce el sensor de huella de este equipo"; return
    fi
    log "Lector de huella"
    if confirm "¿Registrar la huella de $USR ahora? (pon el dedo varias veces)" s; then
        fprintd-enroll "$USR" && done_ "Huella registrada"
    fi
    if confirm "¿Usar la huella para sudo? (la contraseña sigue funcionando)" s; then
        grep -q pam_fprintd /etc/pam.d/sudo || sed -i '1a auth      sufficient pam_fprintd.so' /etc/pam.d/sudo
        done_ "sudo acepta huella"
    fi
}

# ---------------------------------------------------------------- touchpad
check_touchpad() {
    log "Touchpad"
    local tp; tp=$(awk -v RS= '/[Tt]ouchpad/' /proc/bus/input/devices | awk -F'"' '/^N:/{print $2; exit}')
    [[ -n $tp ]] && done_ "$tp: tap, scroll natural con 2 dedos y desactivado al escribir (config de niri)" \
                 || warn "No se detectó touchpad"
}

summary() {
    echo; log "Listo. Comprueba todo con: zen-hwcheck"
}

if [[ ${1:-} == --auto ]]; then
    setup_power; gpu_powersave; exit 0
fi
if [[ ${1:-} == --nvidia ]]; then
    rm -f /etc/modprobe.d/zen-nvidia-off.conf; install_nvidia; exit
fi
if [[ ${1:-} == --nvidia-off ]]; then
    gpu_off; exit
fi
if [[ ${1:-} == --nvidia-on ]]; then
    gpu_on; exit
fi

cat <<'EOF'

  ┌──────────────────────────────────────────┐
  │   zen-hwsetup · ajustes de hardware      │
  └──────────────────────────────────────────┘
  1) Todo (recomendado)
  2) Térmico y energía
  3) GPU NVIDIA
  4) Límite de carga de batería
  5) Lector de huella
  0) Salir
EOF
case "$(ask "Elige" 1)" in
    1) setup_power; setup_nvidia; setup_battery; setup_fingerprint; check_touchpad ;;
    2) setup_power ;;
    3) setup_nvidia ;;
    4) setup_battery ;;
    5) setup_fingerprint ;;
    *) exit 0 ;;
esac
summary
