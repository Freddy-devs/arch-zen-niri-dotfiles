#!/usr/bin/env bash
# zen-install — instala arch-zen-niri en disco desde la ISO live.
#   btrfs (@ @home @log @pkg @snapshots) + snapper + grub-btrfs
#   linux-zen (+ linux-lts de respaldo), niri, greetd/ReGreet, entorno de desarrollo.
# Requiere internet (los paquetes se descargan de los mirrors oficiales).
set -euo pipefail

SHARE=/usr/share/zen-niri
LOCAL_REPO=/opt/zen-niri/repo
MNT=/mnt

c_b=$'\033[1;34m'; c_r=$'\033[1;31m'; c_y=$'\033[1;33m'; c_0=$'\033[0m'
log()  { printf '%s==>%s %s\n' "$c_b" "$c_0" "$*"; }
warn() { printf '%s!!%s %s\n' "$c_y" "$c_0" "$*"; }
die()  { printf '%sERROR:%s %s\n' "$c_r" "$c_0" "$*" >&2; exit 1; }
ask()  { local v; read -rp "$1 [$2]: " v; printf '%s' "${v:-$2}"; }
ask_pass() {
    local a b
    while true; do
        # stdout solo lleva la contraseña (se usa con $(...)); el resto va a stderr
        read -rsp "$1: " a; echo >&2
        read -rsp "Repite: " b; echo >&2
        [[ -n $a && $a == "$b" ]] && { printf '%s' "$a"; return; }
        warn "No coinciden o vacía, intenta de nuevo." >&2
    done
}
part() { [[ $1 =~ [0-9]$ ]] && echo "${1}p$2" || echo "${1}$2"; }

[[ $EUID -eq 0 ]] || exec sudo "$0" "$@"
curl -fsS --max-time 8 -o /dev/null https://archlinux.org || die "Sin internet. Conéctate (nmtui) y reintenta."

clear 2>/dev/null || true
cat <<'EOF'
  ┌──────────────────────────────────────────────┐
  │   arch-zen-niri · instalador                 │
  │   linux-zen · niri · greetd/ReGreet · btrfs  │
  └──────────────────────────────────────────────┘
EOF

# ---------- preguntas ----------
echo; lsblk -dpno NAME,SIZE,MODEL,TYPE | awk '$NF=="disk"'; echo
DISK=$(ask "Disco destino (SE BORRARÁ COMPLETO)" "")
[[ $DISK == /dev/* ]] || DISK="/dev/$DISK"   # acepta "sda" o "nvme0n1"
[[ -b $DISK ]] || die "No existe el disco '$DISK'"
HOSTNAME_=$(ask "Nombre del equipo" "zen-niri")
USERNAME=$(ask "Usuario" "freddy")
[[ $USERNAME =~ ^[a-z_][a-z0-9_-]*$ ]] || die "Usuario inválido"
USERPASS=$(ask_pass "Contraseña de $USERNAME")
ROOTPASS=$(ask_pass "Contraseña de root")
echo
warn "El disco se CIFRA (LUKS2). Esta contraseña se pide al encender."
warn "Si la olvidas, los datos NO se pueden recuperar. Anótala en un lugar seguro."
LUKSPASS=$(ask_pass "Contraseña de cifrado del disco")
TIMEZONE=$(ask "Zona horaria" "America/Lima")
[[ -f /usr/share/zoneinfo/$TIMEZONE ]] || die "Zona horaria inválida"
LOCALE=$(ask "Idioma (locale)" "es_PE.UTF-8")
KEYMAP=$(ask "Teclado consola (la-latin1, es, us)" "la-latin1")
XKB=$(ask "Teclado gráfico XKB (latam, es, us)" "latam")

if [[ -d /sys/firmware/efi ]]; then BOOTMODE=uefi; else BOOTMODE=bios; fi

echo
warn "Se BORRARÁ TODO en $DISK  (modo de arranque: $BOOTMODE, disco cifrado)"
[[ $(ask "Escribe SI para continuar" "no") == SI ]] || die "Cancelado"

# ---------- particiones ----------
# UEFI: p1 EFI (FAT, /boot con los kernels) · p2 LUKS2 → btrfs
# BIOS: p1 BIOSBOOT · p2 ext4 /boot · p3 LUKS2 → btrfs
log "Particionando $DISK"
umount -R "$MNT" 2>/dev/null || true
cryptsetup close cryptroot 2>/dev/null || true
wipefs -af "$DISK"
sgdisk -Z "$DISK"
if [[ $BOOTMODE == uefi ]]; then
    sgdisk -n1:0:+1G -t1:ef00 -c1:EFI -n2:0:0 -t2:8309 -c2:CRYPT "$DISK"
    partprobe "$DISK"; udevadm settle
    BOOTP=$(part "$DISK" 1); CRYPTP=$(part "$DISK" 2)
    mkfs.fat -F32 -n EFI "$BOOTP"
else
    sgdisk -n1:0:+1M -t1:ef02 -c1:BIOSBOOT -n2:0:+1G -t2:8300 -c2:BOOT -n3:0:0 -t3:8309 -c3:CRYPT "$DISK"
    partprobe "$DISK"; udevadm settle
    BOOTP=$(part "$DISK" 2); CRYPTP=$(part "$DISK" 3)
    mkfs.ext4 -F -L BOOT "$BOOTP"
fi

log "Cifrando el disco (LUKS2 + argon2id)"
printf '%s' "$LUKSPASS" | cryptsetup luksFormat --type luks2 --pbkdf argon2id --label CRYPT \
    --batch-mode --key-file=- "$CRYPTP"
# allow-discards: TRIM en el SSD; --persistent lo guarda en la cabecera LUKS
printf '%s' "$LUKSPASS" | cryptsetup open --allow-discards --persistent --key-file=- "$CRYPTP" cryptroot
ROOTP=/dev/mapper/cryptroot
CRYPTUUID=$(blkid -s UUID -o value "$CRYPTP")
mkfs.btrfs -f -L ARCH "$ROOTP"

log "Subvolúmenes btrfs"
mount "$ROOTP" "$MNT"
for sv in @ @home @log @pkg @snapshots; do btrfs subvolume create "$MNT/$sv"; done
umount "$MNT"

OPTS=noatime,compress=zstd:3
mount -o "$OPTS,subvol=@" "$ROOTP" "$MNT"
mkdir -p "$MNT"/{home,var/log,var/cache/pacman/pkg,.snapshots,boot}
mount -o "$OPTS,subvol=@home"      "$ROOTP" "$MNT/home"
mount -o "$OPTS,subvol=@log"       "$ROOTP" "$MNT/var/log"
mount -o "$OPTS,subvol=@pkg"       "$ROOTP" "$MNT/var/cache/pacman/pkg"
mount -o "$OPTS,subvol=@snapshots" "$ROOTP" "$MNT/.snapshots"
if [[ $BOOTMODE == uefi ]]; then
    mount -o fmask=0077,dmask=0077 "$BOOTP" "$MNT/boot"
else
    mount "$BOOTP" "$MNT/boot"
fi

# ---------- paquetes ----------
log "Instalando paquetes (pacstrap)"
cp /usr/share/zen-niri/system/pacman.d/mirrorlist /etc/pacman.d/mirrorlist
mapfile -t PKGS < <(cat "$SHARE/install-base.txt" "$SHARE/desktop.txt" | grep -vE '^\s*(#|$)')
pacstrap -K "$MNT" "${PKGS[@]}"

log "Paquetes AUR precompilados (brave-bin, yay-bin, wps-office)"
mkdir -p "$MNT/var/tmp/zen-pkgs"
cp "$LOCAL_REPO"/*.pkg.tar.zst "$MNT/var/tmp/zen-pkgs/"
arch-chroot "$MNT" sh -c 'pacman -U --noconfirm /var/tmp/zen-pkgs/*.pkg.tar.zst && rm -rf /var/tmp/zen-pkgs'

genfstab -U "$MNT" >> "$MNT/etc/fstab"
# sin subvolid: permite restaurar snapshots sobre @ sin tocar fstab
sed -i 's/subvolid=[0-9]*,//g' "$MNT/etc/fstab"

# ---------- archivos del sistema ----------
log "Copiando configuración"
S="$SHARE/system"
install -d "$MNT/etc/greetd" "$MNT/etc/pacman.d/hooks" "$MNT/etc/xdg/reflector" \
           "$MNT/usr/share/backgrounds/zen-niri" "$MNT/usr/local/bin" "$MNT/etc/skel"
install -m644 "$S"/greetd/* "$MNT/etc/greetd/"
install -m644 "$S/pacman.d/mirrorlist" "$MNT/etc/pacman.d/mirrorlist"
install -m644 "$S"/pacman.d/hooks/*.hook "$MNT/etc/pacman.d/hooks/"
install -m644 "$S/reflector.conf" "$MNT/etc/xdg/reflector/reflector.conf"
install -m644 "$S"/tmpfiles.d/*.conf "$MNT/etc/tmpfiles.d/"
install -m755 "$S"/bin/arch-news "$S"/bin/zen-first-login "$S"/bin/zen-power \
               "$S"/bin/zen-hwcheck "$S"/bin/zen-hwsetup "$MNT/usr/local/bin/"
install -m644 /usr/share/backgrounds/zen-niri/wallpaper.png "$MNT/usr/share/backgrounds/zen-niri/"
install -Dm755 "$S/environment/90-zen-vm-render" "$MNT/usr/lib/systemd/user-environment-generators/90-zen-vm-render"
# seguridad: cortafuegos, sysctl, privacidad de red, DNS cifrado, MariaDB solo local
install -Dm644 "$S/security/nftables.conf"          "$MNT/etc/nftables.conf"
install -Dm644 "$S/security/90-zen-hardening.conf"  "$MNT/etc/sysctl.d/90-zen-hardening.conf"
install -Dm644 "$S/security/20-zen-privacy.conf"    "$MNT/etc/NetworkManager/conf.d/20-zen-privacy.conf"
install -Dm644 "$S/security/zen-dns.conf"           "$MNT/etc/systemd/resolved.conf.d/zen-dns.conf"
install -Dm644 "$S/security/zen-mariadb.cnf"        "$MNT/etc/my.cnf.d/zen-mariadb.cnf"
cp -rT /etc/skel "$MNT/etc/skel"
rm -f "$MNT/etc/skel/.config/zen-niri-first-login.done"
sed -i "s/layout \"latam\"/layout \"$XKB\"/" "$MNT/etc/skel/.config/niri/config.kdl" "$MNT/etc/greetd/niri-greeter.kdl"

# ---------- configuración dentro del sistema ----------
log "Configurando el sistema (chroot)"
arch-chroot "$MNT" env \
    HOSTNAME_="$HOSTNAME_" USERNAME="$USERNAME" USERPASS="$USERPASS" ROOTPASS="$ROOTPASS" \
    TIMEZONE="$TIMEZONE" LOCALE="$LOCALE" KEYMAP="$KEYMAP" XKB="$XKB" \
    BOOTMODE="$BOOTMODE" DISK="$DISK" CRYPTUUID="$CRYPTUUID" \
    bash -euo pipefail <<'CHROOT'
# Hora / idioma / teclado
ln -sf "/usr/share/zoneinfo/$TIMEZONE" /etc/localtime
hwclock --systohc
sed -i "s/^#\(en_US.UTF-8\)/\1/; s/^#\($LOCALE\)/\1/" /etc/locale.gen
locale-gen
echo "LANG=$LOCALE" > /etc/locale.conf
echo "KEYMAP=$KEYMAP" > /etc/vconsole.conf
mkdir -p /etc/X11/xorg.conf.d
cat > /etc/X11/xorg.conf.d/00-keyboard.conf <<EOF
Section "InputClass"
    Identifier "system-keyboard"
    MatchIsKeyboard "on"
    Option "XkbLayout" "$XKB"
EndSection
EOF

# Red / host
echo "$HOSTNAME_" > /etc/hostname
cat > /etc/hosts <<EOF
127.0.0.1   localhost
::1         localhost
127.0.1.1   $HOSTNAME_.localdomain $HOSTNAME_
EOF

# pacman: descargas paralelas, color, multilib
sed -i 's/^#\?ParallelDownloads.*/ParallelDownloads = 10/; s/^#Color/Color\nILoveCandy/' /etc/pacman.conf
sed -i '/^#\[multilib\]/{N;s/#//g}' /etc/pacman.conf

# Usuarios
echo "root:$ROOTPASS" | chpasswd
useradd -m -G wheel -s /usr/bin/zsh "$USERNAME"
echo "$USERNAME:$USERPASS" | chpasswd
chsh -s /usr/bin/zsh root
echo '%wheel ALL=(ALL:ALL) ALL' > /etc/sudoers.d/10-wheel
chmod 440 /etc/sudoers.d/10-wheel
grep -q "^$USERNAME:" /etc/subuid || usermod --add-subuids 100000-165535 --add-subgids 100000-165535 "$USERNAME"

# initramfs con desbloqueo del disco cifrado (pide la contraseña con el teclado de vconsole)
if grep -qE '^HOOKS=.*\bsystemd\b' /etc/mkinitcpio.conf; then
    sed -i -E '/^HOOKS=/ s/\bblock\b/block sd-encrypt/' /etc/mkinitcpio.conf
    CRYPT_CMDLINE="rd.luks.name=$CRYPTUUID=cryptroot rd.luks.options=discard"
else
    sed -i -E '/^HOOKS=/ s/\bblock\b/block encrypt/' /etc/mkinitcpio.conf
    CRYPT_CMDLINE="cryptdevice=UUID=$CRYPTUUID:cryptroot:allow-discards"
fi
grep '^HOOKS=' /etc/mkinitcpio.conf
mkinitcpio -P

# GRUB: kernels en /boot sin cifrar; la raíz se abre en el initramfs
sed -i 's/^GRUB_TIMEOUT=.*/GRUB_TIMEOUT=3/' /etc/default/grub
sed -i 's|^#\?GRUB_TOP_LEVEL=.*||' /etc/default/grub
echo 'GRUB_TOP_LEVEL="/boot/vmlinuz-linux-zen"' >> /etc/default/grub
sed -i 's/^GRUB_CMDLINE_LINUX_DEFAULT=.*/GRUB_CMDLINE_LINUX_DEFAULT="loglevel=3 quiet"/' /etc/default/grub
sed -i "s|^GRUB_CMDLINE_LINUX=.*|GRUB_CMDLINE_LINUX=\"$CRYPT_CMDLINE\"|" /etc/default/grub
if [[ $BOOTMODE == uefi ]]; then
    grub-install --target=x86_64-efi --efi-directory=/boot --bootloader-id=ZenNiri
    # copia en la ruta por defecto: algunos firmwares/VMs ignoran la entrada NVRAM
    grub-install --target=x86_64-efi --efi-directory=/boot --removable
else
    grub-install --target=i386-pc "$DISK"
fi
grub-mkconfig -o /boot/grub/grub.cfg

# Snapper (config "root" sobre @snapshots ya montado en /.snapshots)
install -Dm644 /usr/share/snapper/config-templates/default /etc/snapper/configs/root
sed -i -e 's/^SUBVOLUME=.*/SUBVOLUME="\/"/' \
       -e "s/^ALLOW_GROUPS=.*/ALLOW_GROUPS=\"wheel\"/" \
       -e 's/^TIMELINE_LIMIT_HOURLY=.*/TIMELINE_LIMIT_HOURLY="5"/' \
       -e 's/^TIMELINE_LIMIT_DAILY=.*/TIMELINE_LIMIT_DAILY="7"/' \
       -e 's/^TIMELINE_LIMIT_WEEKLY=.*/TIMELINE_LIMIT_WEEKLY="2"/' \
       -e 's/^TIMELINE_LIMIT_MONTHLY=.*/TIMELINE_LIMIT_MONTHLY="1"/' \
       -e 's/^TIMELINE_LIMIT_YEARLY=.*/TIMELINE_LIMIT_YEARLY="0"/' \
       -e 's/^NUMBER_LIMIT=.*/NUMBER_LIMIT="10"/' \
    /etc/snapper/configs/root
if [[ -f /etc/conf.d/snapper ]]; then
    sed -i 's/^SNAPPER_CONFIGS=.*/SNAPPER_CONFIGS="root"/' /etc/conf.d/snapper
else
    install -Dm644 /dev/stdin /etc/conf.d/snapper <<< 'SNAPPER_CONFIGS="root"'
fi
chmod 750 /.snapshots
chown :wheel /.snapshots

# Bases de datos: inicializadas pero NO arrancan solas (systemctl start mariadb / postgresql)
chattr +C /var/lib/mysql /var/lib/postgres 2>/dev/null || true
mariadb-install-db --user=mysql --basedir=/usr --datadir=/var/lib/mysql >/dev/null
install -d -o postgres -g postgres /var/lib/postgres/data
runuser -u postgres -- initdb --locale=C.UTF-8 --encoding=UTF8 -D /var/lib/postgres/data >/dev/null

# PHP: extensiones para MariaDB/PostgreSQL y frameworks comunes
for ext in mysqli pdo_mysql pgsql pdo_pgsql gd intl sqlite3 pdo_sqlite iconv bcmath zip sodium; do
    sed -i "s/^;extension=$ext$/extension=$ext/" /etc/php/php.ini
done
sed -i "s|^;date.timezone =.*|date.timezone = $TIMEZONE|" /etc/php/php.ini

# Podman: imágenes cortas resuelven a Docker Hub
mkdir -p /etc/containers/registries.conf.d
echo 'unqualified-search-registries = ["docker.io"]' > /etc/containers/registries.conf.d/10-docker-hub.conf

# Servicios
systemctl enable greetd NetworkManager bluetooth systemd-timesyncd fstrim.timer \
    reflector.timer paccache.timer snapper-timeline.timer snapper-cleanup.timer grub-btrfsd
systemctl --global enable podman.socket

# Hardware: thermald, perfiles de energía, ahorro de Wi-Fi y GPU NVIDIA en reposo
/usr/local/bin/zen-hwsetup --auto

# Seguridad "caja fuerte": cortafuegos, DNS cifrado, sin SSH ni servicios escuchando en la red
systemctl enable nftables systemd-resolved
systemctl mask sshd.service sshd.socket sshd@.service avahi-daemon.service avahi-daemon.socket \
    cups.service cups.socket 2>/dev/null
# sudo: contraseña cada 5 min y registro de lo que se ejecuta
cat > /etc/sudoers.d/20-zen-hardening <<'EOF'
Defaults timestamp_timeout=5
Defaults use_pty
Defaults logfile="/var/log/sudo.log"
EOF
chmod 440 /etc/sudoers.d/20-zen-hardening
# bloqueo tras 5 contraseñas fallidas durante 10 minutos (login, sudo, swaylock)
sed -i 's/^#\? *deny = .*/deny = 5/; s/^#\? *unlock_time = .*/unlock_time = 600/' /etc/security/faillock.conf
CHROOT

# resolv.conf → resolved (arch-chroot lo tenía montado, por eso se hace fuera)
ln -sf ../run/systemd/resolve/stub-resolv.conf "$MNT/etc/resolv.conf"

log "Snapshot inicial"
arch-chroot "$MNT" snapper --no-dbus -c root create -d "instalación limpia" || warn "No se pudo crear el snapshot inicial"

umount -R "$MNT"
cryptsetup close cryptroot
echo
log "Instalación completa. Retira el USB y reinicia:  reboot"
log "Al encender te pedirá la contraseña de CIFRADO del disco y luego tu usuario."
log "En el primer inicio de sesión se instalarán Claude Code y herdr (instaladores oficiales)."
