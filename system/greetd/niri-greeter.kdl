// niri mínimo solo para el greeter: lanza ReGreet y sale al iniciar sesión.
input {
    keyboard {
        xkb {
            layout "latam"
        }
        numlock
    }
    touchpad {
        tap
    }
}

hotkey-overlay {
    skip-at-startup
}

cursor {
    xcursor-theme "Adwaita"
    xcursor-size 24
}

layout {
    background-color "#11111b"
}

animations {
    off
}

// el usuario greeter no tiene home escribible: caché de fuentes en /var/cache/regreet (tmpfiles)
environment {
    XDG_CACHE_HOME "/var/cache/regreet"
}

spawn-at-startup "sh" "-c" "regreet; niri msg action quit --skip-confirmation"

binds {
}
