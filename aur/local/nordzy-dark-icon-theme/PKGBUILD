# Solo la variante Nordzy-dark (el paquete nordzy-icon-theme del AUR trae las 18 variantes, ~1.6 GB)
pkgname=nordzy-dark-icon-theme
pkgver=1.8.7
pkgrel=1
pkgdesc="Nordzy-dark icon theme (sola variante)"
arch=('any')
url="https://github.com/alvatip/Nordzy-icon"
license=('GPL-3.0-only')
depends=('hicolor-icon-theme')
conflicts=('nordzy-icon-theme')
options=('!strip')
source=("Nordzy-dark-$pkgver.tar.gz::$url/releases/download/$pkgver/Nordzy-dark.tar.gz")
sha256sums=('ad752b5ce70577408431734fc8004f928a00027a8fce6dd131ae2d0c3dc82069')

package() {
    install -d -m755 "$pkgdir/usr/share/icons/Nordzy-dark"
    cp -a --no-preserve=ownership "$srcdir/Nordzy-dark/." "$pkgdir/usr/share/icons/Nordzy-dark"
}
