# Calendario de la barra (Rust). El código está en apps/zen-calendar; install.sh lo
# copia junto a este PKGBUILD como src-app/.
pkgname=zen-calendar
pkgver=1.0.0
pkgrel=4
pkgdesc="Calendario de la barra: feriados del Perú, agenda y alarmas (GTK4 + layer-shell)"
arch=('x86_64')
license=('GPL-3.0-only')
depends=('gtk4' 'gtk4-layer-shell' 'pipewire' 'sound-theme-freedesktop')
makedepends=('cargo')
options=('!lto' '!debug')

build() {
    cd "$startdir/src-app"
    export CARGO_TARGET_DIR="$srcdir/target"
    cargo build --release --locked
}

check() {
    cd "$startdir/src-app"
    export CARGO_TARGET_DIR="$srcdir/target"
    cargo test --release --locked
}

package() {
    install -Dm755 "$srcdir/target/release/zen-calendar" "$pkgdir/usr/bin/zen-calendar"
}
