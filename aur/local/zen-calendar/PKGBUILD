# Calendario de la barra (Python + GTK4, sin compilar). El código está en apps/zen-calendar;
# install.sh lo copia junto a este PKGBUILD como src-app/.
pkgname=zen-calendar
pkgver=1.1.0
pkgrel=3
pkgdesc="Calendario de la barra: feriados del Perú, agenda y alarmas (Python + GTK4 + layer-shell)"
arch=('any')
license=('GPL-3.0-only')
depends=('python' 'python-gobject' 'gtk4' 'gtk4-layer-shell' 'pipewire' 'sound-theme-freedesktop')

check() {
    cd "$startdir/src-app"
    PYTHONDONTWRITEBYTECODE=1 python -m unittest -q test_logica
}

package() {
    cd "$startdir/src-app"
    install -Dm755 zen-calendar "$pkgdir/usr/lib/zen-calendar/zen-calendar"
    install -Dm644 -t "$pkgdir/usr/lib/zen-calendar" tareas.py feriados.py style.css
    install -d "$pkgdir/usr/bin"
    ln -s /usr/lib/zen-calendar/zen-calendar "$pkgdir/usr/bin/zen-calendar"
}
