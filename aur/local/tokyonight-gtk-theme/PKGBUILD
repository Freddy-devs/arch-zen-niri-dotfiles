# Tema GTK Tokyonight de su autor original (Fausto-Korpsvart), variante oscura azul, + paleta Qt
pkgname=tokyonight-gtk-theme
_commit=6c340e058e84c1975a038a8e5d1e384477225dc0
pkgver=0.0.r20251023
pkgrel=1
pkgdesc="Tokyonight GTK theme (TokyoNight-Dark) y paleta qt6ct a juego"
arch=('any')
url="https://github.com/Fausto-Korpsvart/Tokyonight-GTK-Theme"
license=('GPL-3.0-only')
makedepends=('sassc')
optdepends=('gtk-engine-murrine: tema GTK2')
source=("Tokyonight-GTK-Theme-$_commit.tar.gz::$url/archive/$_commit.tar.gz"
        "TokyoNight.conf")
sha256sums=('ecb39f8ca86a0e460a8bde52173a21f656f2740fc17bf393a21411c17378fd6c'
            'SKIP')

package() {
    install -d "$pkgdir/usr/share/themes"
    cd "$srcdir/Tokyonight-GTK-Theme-$_commit/themes"
    bash install.sh -d "$pkgdir/usr/share/themes" -n TokyoNight -c dark
    install -Dm644 "$srcdir/TokyoNight.conf" "$pkgdir/usr/share/qt6ct/colors/TokyoNight.conf"
}
