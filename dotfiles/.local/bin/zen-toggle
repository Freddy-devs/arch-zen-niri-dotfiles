#!/bin/sh
# zen-toggle audio|media|bluetooth|network|brightness|ram — abre o cierra un panel de la barra.
# Si el panel está abierto se le manda SIGUSR1 y se cierra (termina, no queda oculto); si no, se abre
# y se cierra cualquier otro panel abierto (se encimaban en la misma esquina).
# El pid se comprueba contra /proc: un pid viejo podría ser ya de otro proceso.
alive() {
    pid=$(cat "${XDG_RUNTIME_DIR:-/tmp}/$1.pid" 2>/dev/null)
    [ -n "$pid" ] && tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | grep -q "$1"
}
if alive "zen-$1"; then
    kill -USR1 "$pid"
    exit 0
fi
for f in "${XDG_RUNTIME_DIR:-/tmp}"/zen-*.pid; do
    [ -e "$f" ] || continue
    name=$(basename "$f" .pid)
    alive "$name" && kill -USR1 "$pid"
done
exec "$HOME/.local/bin/zen-$1"
