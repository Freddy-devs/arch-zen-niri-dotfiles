#!/usr/bin/env python3
"""zen-1password-pedir — pide la contraseña de 1Password con el mismo diseño que zen-polkit.

La escribe en stdout (sin salto de línea) y sale con 0; Esc o Cancelar salen con 1.
Pide la contraseña dos veces para no guardar una con errores. Lo usa zen-1password-unlock --guardar.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from zen_panel import preload_layer_shell, load_css  # noqa: E402

preload_layer_shell()

import gi  # noqa: E402
gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
gi.require_version("Gtk4LayerShell", "1.0")
from gi.repository import Gdk, Gtk, Gtk4LayerShell as Layer  # noqa: E402

CSS = """
window.zen-1p { background: rgba(20, 23, 29, 0.55); }
.card {
  background: #2e3440; border: 1px solid #434c5e; border-radius: 18px;
  padding: 28px 28px 22px; box-shadow: 0 18px 48px rgba(0,0,0,0.55);
}
.badge {
  min-width: 84px; min-height: 84px; border-radius: 42px;
  background: rgba(94, 129, 172, 0.18); color: #88c0d0;
}
.badge.fail { background: rgba(191, 97, 106, 0.18); color: #bf616a; animation: shake 0.4s; }
@keyframes shake { 0% { margin-left: 0; } 20% { margin-left: -12px; } 40% { margin-left: 12px; }
                   60% { margin-left: -8px; } 80% { margin-left: 8px; } 100% { margin-left: 0; } }
.title  { color: #eceff4; font-size: 17px; font-weight: 700; }
.body   { color: #d8dee9; font-size: 13px; }
.status { font-size: 13px; font-weight: 600; color: #81a1c1; }
.status.fail { color: #bf616a; }
entry.pass {
  min-height: 40px; border-radius: 10px; background: #3b4252; color: #eceff4;
  border: 1px solid #4c566a; padding: 0 12px; caret-color: #88c0d0;
}
entry.pass:focus-within { border-color: #88c0d0; }
button.ghost, button.main { min-height: 36px; border-radius: 10px; padding: 0 18px; font-weight: 600; }
button.ghost { background: #3b4252; color: #d8dee9; }
button.ghost:hover { background: #434c5e; }
button.main { background: #5e81ac; color: #eceff4; }
button.main:hover { background: #81a1c1; }
button.main:disabled { background: #3b4252; color: #616e88; }
"""


def icon(*names):
    theme = Gtk.IconTheme.get_for_display(Gdk.Display.get_default())
    return next((n for n in names if theme.has_icon(n)), names[-1])


class Pedir(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="zen.onepassword.pedir")
        self.result = None

    def do_activate(self):
        load_css(CSS)
        win = self.win = Gtk.ApplicationWindow(application=self)
        win.add_css_class("zen-1p")
        Layer.init_for_window(win)
        Layer.set_namespace(win, "zen-1password")
        Layer.set_layer(win, Layer.Layer.OVERLAY)
        for e in (Layer.Edge.TOP, Layer.Edge.BOTTOM, Layer.Edge.LEFT, Layer.Edge.RIGHT):
            Layer.set_anchor(win, e, True)
        Layer.set_exclusive_zone(win, -1)
        Layer.set_keyboard_mode(win, Layer.KeyboardMode.EXCLUSIVE)

        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", lambda _c, k, *_: k == Gdk.KEY_Escape and (self.quit() or True))
        win.add_controller(keys)

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14,
                       halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
        card.add_css_class("card")
        card.set_size_request(420, -1)

        self.badge = Gtk.Box(halign=Gtk.Align.CENTER)
        self.badge.add_css_class("badge")
        self.badge.append(Gtk.Image(icon_name=icon("1password", "dialog-password-symbolic"), pixel_size=44,
                                    hexpand=True, vexpand=True, halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER))
        card.append(self.badge)

        title = Gtk.Label(label="Desbloqueo de 1Password con huella")
        title.add_css_class("title")
        card.append(title)
        body = Gtk.Label(label="Escribe la contraseña de tu cuenta de 1Password. Se guarda cifrada con el TPM "
                               "de esta laptop y al encender se usará tras tu huella.",
                         wrap=True, justify=Gtk.Justification.CENTER, max_width_chars=48)
        body.add_css_class("body")
        card.append(body)

        self.p1 = Gtk.PasswordEntry(show_peek_icon=True, placeholder_text="Contraseña de 1Password")
        self.p2 = Gtk.PasswordEntry(show_peek_icon=True, placeholder_text="Repítela")
        for e in (self.p1, self.p2):
            e.add_css_class("pass")
            e.connect("changed", lambda *_: self._sync())
            card.append(e)
        self.p1.connect("activate", lambda *_: self.p2.grab_focus())
        self.p2.connect("activate", lambda *_: self._ok())

        self.status = Gtk.Label(label="", wrap=True, justify=Gtk.Justification.CENTER)
        self.status.add_css_class("status")
        card.append(self.status)

        row = Gtk.Box(spacing=8, homogeneous=True, margin_top=4)
        cancel = Gtk.Button(label="Cancelar")
        cancel.add_css_class("ghost")
        cancel.connect("clicked", lambda *_: self.quit())
        self.btn = Gtk.Button(label="Guardar", sensitive=False)
        self.btn.add_css_class("main")
        self.btn.connect("clicked", lambda *_: self._ok())
        row.append(cancel)
        row.append(self.btn)
        card.append(row)

        win.set_child(card)
        win.present()
        self.p1.grab_focus()

    def _sync(self):
        self.btn.set_sensitive(bool(self.p1.get_text()) and bool(self.p2.get_text()))
        self.status.set_label("")
        self.status.remove_css_class("fail")
        self.badge.remove_css_class("fail")

    def _ok(self):
        a, b = self.p1.get_text(), self.p2.get_text()
        if not a:
            return
        if a != b:
            self.status.set_label("Las contraseñas no coinciden")
            self.status.add_css_class("fail")
            self.badge.add_css_class("fail")
            self.p2.set_text("")
            self.p2.grab_focus()
            return
        self.result = a
        self.quit()


def main():
    app = Pedir()
    app.run([])
    if app.result is None:
        return 1
    sys.stdout.write(app.result)
    sys.stdout.flush()
    return 0


if __name__ == "__main__":
    sys.exit(main())
