#!/usr/bin/env python3
"""zen-bluetooth — panel de Bluetooth debajo de la barra (mismo estilo que zen-calendar).

Clic en el ícono de Bluetooth de waybar lo abre; otro clic (o Esc) lo cierra.
Habla directo con BlueZ por D-Bus y registra su propio agente, así que el
emparejamiento acepta solo la confirmación del código de lo que se empareja desde el panel.
El menú (󰇙) de cada dispositivo emparejado decide si se reconecta solo (Trusted) y lo renombra (Alias).
"""
import os
import secrets
import sys

# lo común de los paneles vive en zen_panel.py, junto al script real (~/.local/bin o el repo)
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import zen_panel  # noqa: E402

zen_panel.preload_layer_shell()     # re-exec con gtk4-layer-shell, antes de importar Gtk

import dbus  # noqa: E402
import dbus.service  # noqa: E402
from dbus.mainloop.glib import DBusGMainLoop  # noqa: E402
import gi  # noqa: E402

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
from gi.repository import Gdk, GLib, Gtk  # noqa: E402

BLUEZ = "org.bluez"
ADAPTER = "org.bluez.Adapter1"
DEVICE = "org.bluez.Device1"
BATTERY = "org.bluez.Battery1"
PROPS = "org.freedesktop.DBus.Properties"
AGENT_PATH = "/pe/zen/bluetooth/agent"
NOISE = {"RSSI", "TxPower", "ManufacturerData", "ServiceData", "AdvertisingFlags"}

ICONS = {
    "input-mouse": "󰍽", "input-keyboard": "󰌌", "input-gaming": "󰊴",
    "audio-headset": "󰋋", "audio-headphones": "󰋋", "audio-card": "󰓃",
    "phone": "󰏲", "computer": "󰍹", "input-tablet": "󰓶",
}

ROWS_VISIBLE, ROW_HEIGHT = 5, 51     # filas de la lista sin scroll y alto de cada una (con su margen)
VISIBLE_SECS = 120                   # "Visible para otros dispositivos" se apaga solo a los 2 min
# batería de 0 a 100 % en pasos de 10 (Nerd Font: vacía, 10 %… 90 %, llena)
BATTERY_ICONS = "\U000f008e\U000f007a\U000f007b\U000f007c\U000f007d\U000f007e\U000f007f\U000f0080\U000f0081\U000f0082\U000f0079"

