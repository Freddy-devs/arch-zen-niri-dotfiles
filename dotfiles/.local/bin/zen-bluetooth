row.dev.new { border-left-color: #b48ead; }
.dev-icon { font-family: "Symbols Nerd Font", "JetBrainsMono Nerd Font"; font-size: 20px; color: #d8dee9; margin-right: 10px; }
row.dev.connected .dev-icon { color: #88c0d0; }
.dev-name { font-weight: 700; color: #eceff4; }
.dev-sub { color: #7b88a1; font-size: 11px; font-weight: 600; }
row.dev.connected .dev-sub { color: #88c0d0; }
