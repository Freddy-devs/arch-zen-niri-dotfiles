    background: #3b4252; color: #eceff4; border-radius: 8px; border: none; box-shadow: none;
    padding: 4px 10px; font-weight: 700; font-size: 12px; min-height: 0;
}
button.act:hover { background: #434c5e; color: #eceff4; }
