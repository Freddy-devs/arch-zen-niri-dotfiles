#!/usr/bin/env python3
"""zen-bluetooth — panel de Bluetooth debajo de la barra (mismo estilo que zen-calendar).

Clic en el ícono de Bluetooth de waybar lo abre; otro clic (o Esc) lo cierra.
Habla directo con BlueZ por D-Bus y registra su propio agente, así que el
emparejamiento acepta solo la confirmación del código de lo que se empareja desde el panel.
"""
import os
import secrets
import signal
import sys
import traceback

# gtk4-layer-shell debe cargarse antes que libwayland; en Python solo se logra con LD_PRELOAD
# dibujo por CPU (cairo): para un panel chico basta y usa la mitad de RAM que el renderizador GL
os.environ.setdefault("GSK_RENDERER", "cairo")

LAYER_LIB = "/usr/lib/libgtk4-layer-shell.so"
if LAYER_LIB not in os.environ.get("LD_PRELOAD", ""):
    os.environ["LD_PRELOAD"] = ":".join(filter(None, [LAYER_LIB, os.environ.get("LD_PRELOAD")]))
    os.execv(sys.executable, [sys.executable] + sys.argv)

import dbus  # noqa: E402
import dbus.service  # noqa: E402
from dbus.mainloop.glib import DBusGMainLoop  # noqa: E402
import gi  # noqa: E402

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
gi.require_version("Gtk4LayerShell", "1.0")
from gi.repository import Gdk, GLib, Gtk, Gtk4LayerShell as Layer  # noqa: E402

BLUEZ = "org.bluez"
ADAPTER = "org.bluez.Adapter1"
DEVICE = "org.bluez.Device1"
BATTERY = "org.bluez.Battery1"
PROPS = "org.freedesktop.DBus.Properties"
AGENT_PATH = "/pe/zen/bluetooth/agent"
NOISE = {"RSSI", "TxPower", "ManufacturerData", "ServiceData", "AdvertisingFlags"}

ICONS = {
    "input-mouse": "󰍽", "input-keyboard": "󰌌", "input-gaming": "󰊴",
    "audio-headset": "󰋋", "audio-headphones": "󰋋", "audio-card": "󰓃",
    "phone": "󰏲", "computer": "󰍹", "input-tablet": "󰓶",
}

ROWS_VISIBLE, ROW_HEIGHT = 5, 51     # filas de la lista sin scroll y alto de cada una (con su margen)

PIDFILE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "zen-bluetooth.pid")


def write_pidfile():
    with open(PIDFILE, "w") as f:
        f.write(str(os.getpid()))


def remove_pidfile():
    try:
        os.unlink(PIDFILE)
    except FileNotFoundError:
        pass

CSS = """
