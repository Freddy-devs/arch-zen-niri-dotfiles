#!/usr/bin/env python3
"""zen-gpu — supervisor de las dos gráficas (Intel UHD 620 + NVIDIA MX150).

  zen-gpu --daemon   lo corre zen-gpu.service: cada 2 s mide la Intel (tiempo por motor en
                     /proc/<pid>/fdinfo, sin root) y la NVIDIA (nvidia-smi, si el driver está),
                     anota qué apps usa cada una y lo deja en $XDG_RUNTIME_DIR/zen-gpu.json.
                     zen-run lee ese archivo para decidir en qué gráfica abre cada app.
  zen-gpu            para waybar (custom/gpu): una línea JSON cada 2 s a partir de ese archivo.
"""
import json
import os
import re
import subprocess
import sys
import time

INTERVALO = 2
REBUSCAR = 5                      # cada 5 vueltas (10 s) busca programas nuevos que usen la GPU
ESTADO = os.path.join(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"), "zen-gpu.json")
CELESTE, VERDE, AMARILLO, ROJO, GRIS = "#78c2ff", "#a3be8c", "#ebcb8b", "#bf616a", "#616e88"
ICONO = "\U000F08AE"              # 󰢮 tarjeta de expansión (Nerd Font)
NOMBRES = {"render": "dibujo", "video": "video", "video-enhance": "video (escalado)", "copy": "copia"}
NVIDIA_PCI = "/sys/bus/pci/devices/0000:01:00.0"
MOTOR = re.compile(r"^drm-engine-([\w-]+):\s*(\d+) ns", re.M)
CLIENTE = re.compile(r"^drm-client-id:\s*(\d+)", re.M)


# ---------------------------------------------------------------- Intel
def buscar():
    """Descriptores abiertos sobre /dev/dri (Intel) y /dev/nvidia* (NVIDIA), por proceso."""
    dri, nv = [], {}
    for pid in filter(str.isdigit, os.listdir("/proc")):
        try:
            for fd in os.listdir(f"/proc/{pid}/fd"):
                destino = os.readlink(f"/proc/{pid}/fd/{fd}")
                if destino.startswith("/dev/dri/"):
                    dri.append((pid, fd))
                elif re.fullmatch(r"/dev/nvidia\d+", destino):
                    nv[pid] = open(f"/proc/{pid}/comm").read().strip()
        except OSError:
            pass
    return dri, nv


def leer_intel(fds):
    """Tiempo acumulado por motor, contando cada cliente DRM una sola vez."""
    total, vistos, vivos = {}, set(), []
    for pid, fd in fds:
        try:
            info = open(f"/proc/{pid}/fdinfo/{fd}").read()
        except OSError:
            continue
        if "drm-driver:\ti915" not in info:
            continue
        vivos.append((pid, fd))
        cliente = CLIENTE.search(info)
        if not cliente or cliente.group(1) in vistos:
            continue
        vistos.add(cliente.group(1))
        for motor, ns in MOTOR.findall(info):
            total[motor] = total.get(motor, 0) + int(ns)
    return total, vivos


# ---------------------------------------------------------------- NVIDIA
class Nvidia:
    """Lee la NVIDIA con un solo nvidia-smi que queda corriendo (no uno por medición)."""

    def __init__(self):
        self.proc = None
        self.ultimo = None

    def driver(self):
        return os.path.exists("/proc/driver/nvidia/version")

    def leer(self):
        if not self.driver():
            return None
        if self.proc is None or self.proc.poll() is not None:
            try:
                self.proc = subprocess.Popen(
                    ["nvidia-smi", "--query-gpu=utilization.gpu,utilization.decoder,temperature.gpu,power.draw,memory.used",
                     "--format=csv,noheader,nounits", f"--loop-ms={INTERVALO * 1000}"],
                    stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
                os.set_blocking(self.proc.stdout.fileno(), False)
            except OSError:
                return None
        try:
            for linea in self.proc.stdout:
                self.ultimo = linea
        except (BlockingIOError, TypeError):
            pass
        if not self.ultimo:
            return None
        def num(x):
            try:
                return float(x)
            except ValueError:
                return None
        uso, dec, temp, watts, vram = (num(x.strip()) for x in self.ultimo.split(","))
        return {"uso": uso or 0, "video": dec or 0, "temp": temp, "watts": watts, "vram": vram}


def estado_pci():
    try:
        return open(f"{NVIDIA_PCI}/power/runtime_status").read().strip()
    except OSError:
        return "?"


# ---------------------------------------------------------------- servicio
def daemon():
    nvidia = Nvidia()
    dri, apps_nv = buscar()
    antes, dri = leer_intel(dri)
    t0, vuelta = time.monotonic(), 0
    while True:
        time.sleep(INTERVALO)
        vuelta += 1
        if vuelta % REBUSCAR == 0:
            dri, apps_nv = buscar()
        ahora, dri = leer_intel(dri)
        t1 = time.monotonic()
        dt = (t1 - t0) * 1e9
        motores = {m: max(0.0, min(100.0, (ns - antes.get(m, ns)) / dt * 100)) for m, ns in ahora.items()}
        antes, t0 = ahora, t1
        estado = {
            "hora": time.time(),
            "intel": {"uso": round(max(motores.values(), default=0)),
                      "motores": {NOMBRES[m]: round(u) for m, u in motores.items() if m in NOMBRES}},
            "nvidia": {"driver": nvidia.driver(), "energia": estado_pci(),
                       "apps": sorted(set(apps_nv.values()) - {"nvidia-smi"}), **(nvidia.leer() or {})},
        }
        tmp = ESTADO + ".tmp"
        with open(tmp, "w") as f:
            json.dump(estado, f)
        os.replace(tmp, ESTADO)


# ---------------------------------------------------------------- waybar
def color(pct, base):
    return ROJO if pct >= 90 else AMARILLO if pct >= 60 else base


def waybar():
    while True:
        try:
            e = json.load(open(ESTADO))
            if time.time() - e["hora"] > 10:
                raise ValueError("viejo")
        except (OSError, ValueError, KeyError):
            print(json.dumps({"text": f"<span color='{GRIS}'>{ICONO}</span>  --",
                              "tooltip": "zen-gpu.service no está corriendo"}, ensure_ascii=False), flush=True)
            time.sleep(INTERVALO)
            continue
        i, n = e["intel"], e["nvidia"]
        texto = f"<span color='{color(i['uso'], CELESTE)}' rise='0pt'>{ICONO}</span>  {i['uso']}%"
        tip = ["Intel UHD 620 (escritorio, Brave, video)"]
        tip += [f"  {m}: {u}%" for m, u in sorted(i["motores"].items())]
        if n["driver"]:
            uso = round(n.get("uso", 0))
            texto += f"  <span color='{color(uso, VERDE)}' rise='0pt'>{ICONO}</span>  {uso}%"
            tip.append("NVIDIA MX150 (apps pesadas y desborde)")
            tip.append(f"  uso: {uso}%   video: {round(n.get('video', 0))}%")
            if n.get("temp") is not None:
                tip.append(f"  {n['temp']:.0f} °C · {n.get('watts') or 0:.1f} W · {n.get('vram') or 0:.0f} MiB")
            tip.append("  apps: " + (", ".join(n["apps"]) if n["apps"] else "ninguna"))
        else:
            tip.append("NVIDIA MX150: sin driver propietario (sudo zen-hwsetup --nvidia)")
        alto = i["uso"] >= 90 or (n["driver"] and n.get("uso", 0) >= 90)
        print(json.dumps({"text": texto, "tooltip": "\n".join(tip), "class": "high" if alto else ""},
                         ensure_ascii=False), flush=True)
        time.sleep(INTERVALO)


if __name__ == "__main__":
    try:
        daemon() if "--daemon" in sys.argv else waybar()
    except (BrokenPipeError, KeyboardInterrupt):
        sys.exit(0)
