#!/usr/bin/env python3
"""zen-brightness — panel de brillo debajo de la barra (mismo estilo que zen-audio).

Un slider por pantalla: la de la laptop (brightnessctl) y los monitores externos por DDC/CI
(ddcutil, el monitor cambia su propio brillo). Clic en el brillo de waybar o Super+I lo abre;
otro clic, Super+I, Super+C o Esc lo cierra y el proceso termina. Lo que encuentra `ddcutil detect`
(lento: 1-5 s) se guarda en $XDG_RUNTIME_DIR y se reusa mientras no cambien las pantallas conectadas.
Rueda del ratón sobre un slider o ↑/↓: ±5 %. Con varias pantallas, "Todas las pantallas" mueve todas.
El último brillo puesto a cada monitor externo se guarda en ~/.local/state/zen-brightness.json; si
el monitor vuelve con otro valor, su fila ofrece "Restaurar N %" (no se aplica solo).
"""
import glob
import json
import os
import re
import shutil
import subprocess
import sys
import threading
import time
import traceback

# lo común de los paneles vive en zen_panel.py, junto al script real (~/.local/bin o el repo)
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import zen_panel  # noqa: E402

zen_panel.preload_layer_shell()     # re-exec con gtk4-layer-shell, antes de importar Gtk

import gi  # noqa: E402

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
from gi.repository import Gdk, GLib, Gtk  # noqa: E402

CSS = """
window.zen-brightness { background: transparent; }
.panel {
    background: #1a1b26; border: 1px solid #292e42; border-radius: 14px; padding: 14px 14px 8px;
    color: #eceff4; font-family: Inter, sans-serif; font-size: 13px;
}
.title { font-size: 15px; font-weight: 800; color: #eceff4; }
.title-icon { font-family: "Symbols Nerd Font", "JetBrainsMono Nerd Font"; font-size: 17px; color: #ebcb8b; margin-right: 8px; }
.screen { margin-top: 12px; }
.screen-icon { font-family: "Symbols Nerd Font", "JetBrainsMono Nerd Font"; font-size: 15px; color: #616e88; margin-right: 8px; }
.screen-name { font-weight: 700; color: #d8dee9; font-size: 12px; }
.note { color: #616e88; font-size: 11px; margin-top: 2px; }
.vol { padding: 2px 0 2px; }
.pct { font-size: 12px; font-weight: 700; color: #d8dee9; min-width: 38px; }
.sun { font-family: "Symbols Nerd Font", "JetBrainsMono Nerd Font"; color: #ebcb8b; font-size: 15px; padding: 0 6px; }
.sun.low { color: #616e88; font-size: 13px; }
scale { padding: 0 4px; }
scale trough { background: #3b4252; border-radius: 4px; min-height: 4px; border: none; }
scale highlight { background: #ebcb8b; border-radius: 4px; }
scale:disabled highlight { background: #434c5e; }
scale slider {
    background: #eceff4; border-radius: 50%; min-width: 12px; min-height: 12px;
    margin: -4px; border: none; box-shadow: none;
}
scale:hover slider { background: #eceff4; }
.screen.all { padding-bottom: 10px; border-bottom: 1px solid #292e42; }
.screen.all .screen-icon { color: #ebcb8b; }
button.restore {
    background: #3b4252; color: #ebcb8b; border: none; box-shadow: none; border-radius: 6px;
    font-size: 11px; font-weight: 700; padding: 1px 8px; min-height: 0;
}
button.restore:hover { background: #434c5e; }
"""

MIN_LAPTOP = 1     # 0 % apaga la pantalla de la laptop: no dejar llegar ahí
DDC_CACHE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "zen-brightness-ddc.json")
INTERNAL = ("eDP", "LVDS", "DSI")     # conectores de la pantalla propia de la laptop
DDC_CACHE_VERSION = 2                 # 2: guarda la serie del monitor (clave del brillo recordado)
STATE = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"),
                     "zen-brightness.json")
STEP = 5                              # rueda del ratón y ↑/↓


def run(*cmd, timeout=6):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout).stdout
    except (subprocess.SubprocessError, OSError):
        return ""


# ---------- pantallas ----------
class Laptop:
    icon, kind = "󰌢", "laptop"

    def __init__(self, device):
        self.device, self.name = device, "Pantalla de la laptop"

    def get(self):
        # brightnessctl -m: dispositivo,clase,actual,porcentaje,máximo
        parts = run("brightnessctl", "-m", "-d", self.device).strip().split(",")
        return int(parts[3].rstrip("%")) if len(parts) > 3 else None

    def set(self, pct):
        run("brightnessctl", "-q", "-d", self.device, "set", f"{max(MIN_LAPTOP, pct)}%")


class Monitor:
    icon, kind = "󰍹", "ddc"

    def __init__(self, bus, name, serial=""):
        self.bus, self.name, self.serial = bus, name, serial
        self.max = None          # máximo que informa el monitor (no siempre 100)

    @property
    def key(self):
        # el bus i2c cambia según el puerto o el orden de arranque: el monitor se reconoce por nombre y serie
        return f"{self.name} #{self.serial}" if self.serial else self.name

    def get(self):
        # "VCP 10 C 50 100" = brillo actual 50 de máximo 100
        out = run("ddcutil", "--bus", self.bus, "--brief", "getvcp", "10").split()
        try:
            cur, self.max = int(out[3]), int(out[4])
            return round(cur * 100 / self.max)
        except (IndexError, ValueError, ZeroDivisionError):
            return None

    def set(self, pct):
        # se lee escalado por el máximo: se escribe igual, si no un monitor de 0-50 queda al doble
        value = round(pct * self.max / 100) if self.max else pct
        run("ddcutil", "--bus", self.bus, "--noverify", "setvcp", "10", str(value))


def connected_outputs():
    """Conectores DRM con algo enchufado, p. ej. ["eDP-1", "HDMI-A-1"]."""
    outs = []
    for path in sorted(glob.glob("/sys/class/drm/card*-*/status")):
        try:
            with open(path) as f:
                if f.read().strip() == "connected":
                    outs.append(os.path.basename(os.path.dirname(path)).split("-", 1)[1])
        except OSError:
            pass
    return outs


def has_external(outputs):
    return any(not o.startswith(INTERNAL) for o in outputs)


def laptops():
    """Pantallas con backlight (brightnessctl responde al instante)."""
    return [Laptop(line.split(",")[0])
            for line in run("brightnessctl", "-l", "-m", "-c", "backlight").splitlines() if line]


def monitors(outputs):
    """Monitores DDC/CI; `ddcutil detect` tarda segundos, así que se cachea por lista de conectores."""
    if not shutil.which("ddcutil") or not has_external(outputs):
        return []          # sin monitor externo no hay a quién preguntar
    try:
        with open(DDC_CACHE) as f:
            cache = json.load(f)
        if cache.get("v") == DDC_CACHE_VERSION and cache.get("outputs") == outputs:
            return [Monitor(m["bus"], m["name"], m.get("serial", "")) for m in cache["monitors"]]
    except (OSError, ValueError, KeyError, TypeError):
        pass
    found = ddc_detect()
    if found:              # vacío no se guarda: quizá el DDC/CI se activa luego en el OSD
        try:
            with open(DDC_CACHE + ".part", "w") as f:
                json.dump({"v": DDC_CACHE_VERSION, "outputs": outputs,
                           "monitors": [{"bus": m.bus, "name": m.name, "serial": m.serial} for m in found]}, f)
            os.replace(DDC_CACHE + ".part", DDC_CACHE)
        except OSError:
            pass
    return found


def forget_monitors():
    try:
        os.unlink(DDC_CACHE)
    except OSError:
        pass


def load_state():
    """Último brillo puesto a cada monitor externo: {clave del monitor: %}."""
    try:
        with open(STATE) as f:
            data = json.load(f).get("monitors", {})
        return {str(k): int(v) for k, v in data.items()}
    except (OSError, ValueError, AttributeError, TypeError):
        return {}


def save_state(values):
    try:
        os.makedirs(os.path.dirname(STATE), exist_ok=True)
        with open(STATE + ".part", "w") as f:
            json.dump({"monitors": values}, f, indent=1)
        os.replace(STATE + ".part", STATE)
    except OSError:
        pass


def ddc_detect():
    screens = []
    if shutil.which("ddcutil"):
        # solo bloques "Display N": "Invalid display" es la pantalla de la laptop (sin DDC/CI)
        valid = False
        bus = model = brand = serial = None
        for line in run("ddcutil", "detect", timeout=20).splitlines() + [""]:
            line = line.strip()
            if line.startswith("Display "):
                valid = True
            elif line.startswith("Invalid display"):
                valid = False
            elif m := re.search(r"/dev/i2c-(\d+)", line):
                bus = m.group(1)
            elif line.startswith("Model:"):
                model = line.split(":", 1)[1].strip()
            elif line.startswith("Mfg id:") and " - " in line:
                brand = line.split(" - ", 1)[1].split()[0]        # "SAM - Samsung Electric…" → Samsung
            elif line.startswith("Serial number:"):
                serial = line.split(":", 1)[1].strip() or serial
            elif line.startswith("Binary serial number:") and not serial:
                binary = line.split(":", 1)[1].split()[:1]       # "0 (0x00000000)" = sin serie
                serial = binary[0] if binary and binary[0] != "0" else None
            elif not line:
                if valid and bus:
                    name = " ".join(x for x in (brand or "Monitor", model) if x) or f"Monitor (i2c-{bus})"
                    screens.append(Monitor(bus, name, serial or ""))
                valid, bus, model, brand, serial = False, None, None, None, None
    return screens


class Row:
    """Nombre de la pantalla + slider de brillo. Aplica con una pausa corta: DDC es lento.

    on_value(): avisa al panel de un valor nuevo (leído o movido), para "Todas las pantallas".
    on_sent(row, pct): el valor que se le mandó a la pantalla (el panel lo recuerda).
    remembered: el último brillo guardado de este monitor; si el leído es otro, ofrece restaurarlo.
    """

    def __init__(self, screen, on_value=None, on_sent=None, remembered=None):
        self.screen, self.updating, self.pending, self.busy = screen, False, None, False
        self.on_value, self.on_sent, self.remembered = on_value, on_sent, remembered
        self.touched = 0.0       # último movimiento del usuario: una lectura vieja no lo pisa
        self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.box.add_css_class("screen")
        head = Gtk.Box()
        icon = Gtk.Label(label=screen.icon)
        icon.add_css_class("screen-icon")
        name = Gtk.Label(label=screen.name, xalign=0, ellipsize=3, hexpand=True)
        name.add_css_class("screen-name")
        self.restore = Gtk.Button(valign=Gtk.Align.CENTER, visible=False,
                                  tooltip_text="Brillo que tenía la última vez que lo cambiaste")
        self.restore.add_css_class("restore")
        self.restore.connect("clicked", lambda b: self.do_restore())
        head.append(icon)
        head.append(name)
        head.append(self.restore)
        self.box.append(head)

        row = Gtk.Box()
        row.add_css_class("vol")
        low = Gtk.Label(label="󰃞")
        low.add_css_class("sun")
        low.add_css_class("low")
        self.scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        self.scale.set_hexpand(True)
        self.scale.set_draw_value(False)
        self.scale.set_sensitive(False)      # hasta la primera lectura no se sabe el valor real
        self.scale.connect("value-changed", self.on_change)
        self.pct = Gtk.Label(xalign=1)
        self.pct.add_css_class("pct")
        high = Gtk.Label(label="󰃠")
        high.add_css_class("sun")
        for w in (low, self.scale, high, self.pct):
            row.append(w)
        # rueda: ±5 % (la de GtkRange da pasos raros); en captura para que el slider no la use también
        scroll = Gtk.EventControllerScroll(flags=Gtk.EventControllerScrollFlags.VERTICAL
                                           | Gtk.EventControllerScrollFlags.DISCRETE,
                                           propagation_phase=Gtk.PropagationPhase.CAPTURE)
        scroll.connect("scroll", lambda c, dx, dy: bool(dy) and (self.nudge(-STEP if dy > 0 else STEP) or True))
        row.add_controller(scroll)
        self.box.append(row)

    def nudge(self, delta):
        if self.scale.get_sensitive():
            self.scale.set_value(max(0, min(100, int(self.scale.get_value()) + delta)))

    def show_restore(self, pct):
        # ±1 % es redondeo del máximo del monitor, no otro valor
        offer = self.remembered is not None and pct is not None and abs(pct - self.remembered) > 1
        self.restore.set_label(f"Restaurar {self.remembered} %" if offer else "")
        self.restore.set_visible(offer)

    def do_restore(self):
        self.restore.set_visible(False)
        self.scale.set_value(self.remembered)      # por on_change: mismo flush que un arrastre

    def load(self):
        def work():
            pct = self.screen.get()
            GLib.idle_add(self.show_value, pct)
        threading.Thread(target=work, daemon=True).start()

    def show_value(self, pct):
        if pct is None:
            self.scale.set_sensitive(False)
            self.pct.set_label("—")
            if self.screen.kind == "ddc":
                forget_monitors()    # quizá cambió el bus: la próxima apertura vuelve a detectar
            return False
        self.scale.set_sensitive(True)
        # con un setvcp en vuelo o un toque reciente lo leído ya es viejo: no devolver el slider
        if self.pending is None and not self.busy and time.monotonic() - self.touched > 1.5:
            self.updating = True
            self.scale.set_value(pct)
            self.updating = False
            self.pct.set_label(f"{pct}%")
            self.show_restore(pct)
        if self.on_value:
            self.on_value()
        return False

    def on_change(self, scale):
        pct = int(scale.get_value())
        self.pct.set_label(f"{pct}%")
        if self.updating:
            return
        self.touched = time.monotonic()
        self.restore.set_visible(False)      # el usuario eligió otro valor: ese es el que se recuerda
        self.pending = pct
        if not self.busy:
            self.flush()
        if self.on_value:
            self.on_value()

    def flush(self):
        """Un solo comando a la vez; al terminar manda el último valor pedido (sin cola de pasos)."""
        if self.pending is None:
            self.busy = False
            return
        pct, self.pending, self.busy = self.pending, None, True
        if self.on_sent:
            self.on_sent(self, pct)

        def work():
            self.screen.set(pct)
            GLib.idle_add(self.flush)
        threading.Thread(target=work, daemon=True).start()


class AllScreens(Row):
    """"Todas las pantallas": mueve el slider de cada fila, y cada una manda su valor con su propio flush."""

    icon, kind, name = "\U000f037a", "all", "Todas las pantallas"

    def __init__(self, panel):
        super().__init__(self)       # hace de su propia "pantalla": solo icono y nombre
        self.panel = panel
        self.box.add_css_class("all")
        self.box.set_visible(False)  # solo con más de una pantalla

    def on_change(self, scale):
        pct = int(scale.get_value())
        self.pct.set_label(f"{pct}%")
        if self.updating:
            return
        self.touched = time.monotonic()
        for row in self.panel.rows:
            if row.scale.get_sensitive():
                row.scale.set_value(pct)

    def sync(self):
        """Muestra el promedio de las pantallas, salvo mientras el usuario lo arrastra."""
        values = [int(r.scale.get_value()) for r in self.panel.rows if r.scale.get_sensitive()]
        self.scale.set_sensitive(bool(values))
        if values and time.monotonic() - self.touched > 1.5:
            pct = round(sum(values) / len(values))
            self.updating = True
            self.scale.set_value(pct)
            self.updating = False
            self.pct.set_label(f"{pct}%")


class Panel:
    def __init__(self, app):
        self.app = app
        self.rows = []
        self.remembered = load_state()
        self.save_pending = False
        self.build()
        # la laptop aparece ya; los monitores DDC llegan después (detect puede tardar segundos)
        self.fill(laptops())
        outputs = connected_outputs()

        def work():
            try:
                found = monitors(outputs)
            except Exception:
                traceback.print_exc()
                found = []
            GLib.idle_add(self.fill, found, outputs)
        threading.Thread(target=work, daemon=True).start()

    def build(self):
        zen_panel.load_css(CSS)
        win = zen_panel.layer_window(self.app, "zen-brightness", "zen-brightness", on_escape=self.hide)

        panel = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        panel.add_css_class("panel")
        panel.set_size_request(320, -1)
        head = Gtk.Box()
        icon = Gtk.Label(label="󰃟")
        icon.add_css_class("title-icon")
        title = Gtk.Label(label="Brillo", xalign=0, hexpand=True)
        title.add_css_class("title")
        head.append(icon)
        head.append(title)
        panel.append(head)
        self.all = AllScreens(self)
        panel.append(self.all.box)
        self.list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        panel.append(self.list)
        self.note = Gtk.Label(xalign=0, wrap=True, max_width_chars=40)
        self.note.add_css_class("note")
        self.note.set_visible(False)
        panel.append(self.note)

        # ↑/↓: ±5 % a la pantalla con el foco o a la primera. En captura: el slider enfocado
        # movería solo 1 %
        keys = Gtk.EventControllerKey(propagation_phase=Gtk.PropagationPhase.CAPTURE)
        keys.connect("key-pressed", self.on_key)
        win.add_controller(keys)

        win.set_child(panel)
        self.win = win
        win.realize()                    # prepara el renderizador ahora y no en el primer clic

    def fill(self, screens, outputs=None):
        """Añade filas; con `outputs` es la tanda de monitores y decide la nota."""
        for s in screens:
            row = Row(s, on_value=self.all.sync, on_sent=self.remember,
                      remembered=self.remembered.get(s.key) if s.kind == "ddc" else None)
            self.rows.append(row)
            self.list.append(row.box)
            if self.win.get_visible():
                row.load()
        self.all.box.set_visible(len(self.rows) > 1)
        self.all.sync()
        if outputs is None or not has_external(outputs):
            return False     # la nota solo tiene sentido si hay un monitor externo enchufado
        if not shutil.which("ddcutil"):
            self.note.set_label("Para el brillo del monitor externo instala ddcutil (ver README).")
            self.note.set_visible(True)
        elif not screens:
            self.note.set_label("El monitor externo no responde por DDC/CI: actívalo en su menú (OSD).")
            self.note.set_visible(True)
        return False

    def on_key(self, ctrl, key, code, state):
        if key not in (Gdk.KEY_Up, Gdk.KEY_Down) or not self.rows:
            return False
        focus = self.win.get_focus()
        rows = ([self.all] if self.all.box.get_visible() else []) + self.rows
        target = next((r for r in rows if focus is not None and focus.is_ancestor(r.box)), self.rows[0])
        target.nudge(STEP if key == Gdk.KEY_Up else -STEP)
        return True

    def remember(self, row, pct):
        """Guarda el último brillo mandado a cada monitor externo (con pausa: un arrastre manda muchos)."""
        if row.screen.kind != "ddc":
            return
        self.remembered[row.screen.key] = row.remembered = pct
        if not self.save_pending:
            self.save_pending = True
            GLib.timeout_add(1000, self.save)

    def save(self):
        if self.save_pending:
            self.save_pending = False
            save_state(self.remembered)
        return False

    def toggle(self):
        self.hide() if self.win.get_visible() else self.show()

    def show(self):
        self.win.present()
        for row in self.rows:
            row.load()

    def hide(self):
        self.save()                  # lo pendiente de recordar, antes de terminar
        self.app.quit()          # Esc, Super+C u otro clic: se cierra, no queda oculto
        return True


def main():
    zen_panel.run("pe.zen.Brightness", "zen-brightness", Panel)


if __name__ == "__main__":
    main()
