#!/usr/bin/env bash
# zen-1password-unlock: desbloquea 1Password con la huella al iniciar sesión.
# 1Password en Linux exige la contraseña en el primer desbloqueo tras arrancar; aquí la huella
# (polkit -> zen-polkit) libera la contraseña cifrada con el TPM y wtype la teclea en la app.
#   zen-1password-unlock            desbloquea (lo lanza niri al iniciar sesión)
#   zen-1password-unlock --guardar  guarda o cambia la contraseña (pide huella)
#   zen-1password-unlock --borrar   la elimina
set -uo pipefail

LLAVE=/usr/local/bin/zen-1password-llave
LOG="$HOME/.config/1Password/logs/1Password_rCURRENT.log"
avisa() { notify-send -a 1Password -i 1password "1Password" "$1" 2>/dev/null || true; }

case ${1:-} in
    --guardar)
        pass=$("$HOME/.local/bin/zen-1password-pedir") || exit 1
        [[ -n $pass ]] || exit 1
        if printf '%s' "$pass" | pkexec "$LLAVE" guardar; then
            avisa "Contraseña guardada: al encender se desbloqueará con tu huella"
        else
            avisa "No se pudo guardar la contraseña"; exit 1
        fi
        exit 0 ;;
    --borrar)
        pkexec "$LLAVE" borrar && avisa "Contraseña borrada"; exit ;;
    "") ;;
    *) echo "uso: zen-1password-unlock [--guardar|--borrar]" >&2; exit 1 ;;
esac

# sin contraseña guardada no hay nada que hacer
[[ -f /var/lib/zen-1password/$(id -u).cred ]] || exit 0

# esperar a que 1Password arranque (autostart --silent)
for _ in $(seq 60); do pgrep -u "$USER" -x 1password >/dev/null && break; sleep 1; done
pgrep -u "$USER" -x 1password >/dev/null || exit 0
sleep 2

bloqueado() {
    local ultimo
    ultimo=$(rg -o 'Lock state changed: \w+' "$LOG" 2>/dev/null | tail -1)
    [[ $ultimo != *Unlocked ]]
}
bloqueado || exit 0

# huella primero; la contraseña solo pasa por tuberías, nunca por argumentos
pass=$(pkexec "$LLAVE" leer) || {
    avisa "No se pudo desbloquear con la huella (si cambiaste BIOS/Secure Boot: zen-1password-unlock --guardar)"
    exit 1
}
bloqueado || exit 0

# mostrar la ventana de 1Password (pantalla de bloqueo) y enfocarla
/opt/1Password/1password >/dev/null 2>&1 &
id=""
for _ in $(seq 40); do
    id=$(niri msg -j windows 2>/dev/null | jq -r '[.[] | select(.app_id | test("onepassword|1password"; "i"))][0].id // empty')
    [[ -n $id ]] && break
    sleep 0.25
done
[[ -n $id ]] || { avisa "No apareció la ventana de 1Password"; exit 1; }
niri msg action focus-window --id "$id"
sleep 1

# teclear solo si la ventana enfocada sigue siendo 1Password
foco=$(niri msg -j focused-window 2>/dev/null | jq -r '.app_id // empty')
[[ ${foco,,} == *onepassword* || ${foco,,} == *1password* ]] || { avisa "1Password perdió el foco; desbloquéalo a mano"; exit 1; }
printf '%s' "$pass" | wtype -
unset pass
wtype -k Return

for _ in $(seq 20); do bloqueado || exit 0; sleep 0.5; done
avisa "1Password no se desbloqueó; si cambiaste la contraseña: zen-1password-unlock --guardar"
exit 1
