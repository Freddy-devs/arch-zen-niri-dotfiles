#!/usr/bin/env python3
"""zen-polkit — agente de autenticación polkit de arch-zen-niri (reemplaza a polkit-gnome).

Muestra qué se está pidiendo de un vistazo:
  · huella  → icono de huella que late y "Pon tu dedo en el lector"
  · clave   → icono de candado y campo de contraseña
  · error   → el icono se pone rojo y tiembla; éxito → verde y se cierra

La verificación la hace polkit con PAM (/etc/pam.d/polkit-1); este programa solo pinta el diálogo.
Ventana de capa OVERLAY con teclado exclusivo (con focus-follows-mouse lo escrito no se escapa).

    zen-polkit            registrarse como agente de la sesión (lo lanza niri al iniciar)
    zen-polkit --preview  vista previa del diálogo sin polkit (Esc para salir)
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from zen_panel import preload_layer_shell, load_css  # noqa: E402

preload_layer_shell()

import gi  # noqa: E402
gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
gi.require_version("Gtk4LayerShell", "1.0")
gi.require_version("Polkit", "1.0")
gi.require_version("PolkitAgent", "1.0")
from gi.repository import Gdk, Gio, GLib, Gtk, Gtk4LayerShell as Layer, Polkit, PolkitAgent  # noqa: E402

PREVIEW = "--preview" in sys.argv
# candidatos por orden: el primero que tenga el tema de iconos (Nordzy no trae los de Adwaita)
ICONS = {
    "finger": ("fingerprint-symbolic", "auth-fingerprint-symbolic", "fingerprint"),
    "lock": ("changes-prevent-symbolic", "system-lock-screen-symbolic", "dialog-password-symbolic"),
    "fail": ("dialog-error-symbolic", "process-stop-symbolic"),
    "ok": ("object-select-symbolic", "emblem-ok-symbolic"),
}


def icon_for(mode):
    theme = Gtk.IconTheme.get_for_display(Gdk.Display.get_default())
    names = ICONS.get(mode, ICONS["lock"])
    return next((n for n in names if theme.has_icon(n)), names[0])

CSS = """
window.zen-polkit { background: rgba(20, 23, 29, 0.55); }
.card {
  background: #2e3440; border: 1px solid #434c5e; border-radius: 18px;
  padding: 28px 28px 22px; box-shadow: 0 18px 48px rgba(0,0,0,0.55);
}
.badge {
  min-width: 84px; min-height: 84px; border-radius: 42px;
  background: rgba(136, 192, 208, 0.14); color: #88c0d0;
  transition: background 200ms, color 200ms;
}
.badge.finger { animation: pulse 1.6s ease-in-out infinite; }
.badge.lock   { background: rgba(235, 203, 139, 0.14); color: #ebcb8b; }
.badge.fail   { background: rgba(191, 97, 106, 0.18); color: #bf616a; animation: shake 0.4s; }
.badge.ok     { background: rgba(163, 190, 140, 0.18); color: #a3be8c; }
@keyframes pulse { 0% { background: rgba(136,192,208,0.10); } 50% { background: rgba(136,192,208,0.30); }
                   100% { background: rgba(136,192,208,0.10); } }
@keyframes shake { 0% { margin-left: 0; } 20% { margin-left: -12px; } 40% { margin-left: 12px; }
                   60% { margin-left: -8px; } 80% { margin-left: 8px; } 100% { margin-left: 0; } }
