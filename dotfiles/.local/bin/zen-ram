REFRESH = 2            # segundos entre lecturas con el panel abierto
TOP = 40               # apps en la lista
VISIBLE = 10           # filas a la vista; el resto con scroll
ROW_H = 48             # alto de una fila (px)
FORCE_AFTER = 4        # segundos sin cerrarse tras SIGTERM → ofrecer SIGKILL
CONFIRM_FOR = 3        # segundos que dura el «¿Cerrar?»
GIB = 1024 * 1024      # kB por GiB

INTERP = re.compile(r"^(python[\d.]*|node|bash|sh|zsh|dash|perl|ruby|java|lua[\d.]*)$")
VERSION = re.compile(r"^[\d.]+$")   # binarios con versión por nombre (claude → 2.1.312)
# lo esencial del escritorio: cerrarlo deja la sesión rota (se ve, pero sin botón)
PROTECTED = {
    "niri", "waybar", "Xwayland", "xwayland-satellite", "pipewire", "pipewire-pulse", "wireplumber",
    "systemd", "dbus-daemon", "dbus-broker", "dbus-broker-launch", "gnome-keyring-daemon",
    "polkit-gnome-authentication-agent-1", "swaybg", "swayidle", "mako", "at-spi-bus-launcher",
    "at-spi2-registryd", "zen-ram",
}
SHELLS = {"bash", "zsh", "sh", "dash", "fish"}   # sin script: es una shell interactiva de una terminal
SESSION_FLAGS = ("--waybar", "--daemon")         # módulos de la barra y residentes del escritorio


def kb(n):
    return f"{n / GIB:.1f} GiB" if n >= GIB / 10 else f"{n / 1024:.0f} MiB"


def read(path):
    try:
        with open(path, "rb") as f:
            return f.read()
    except OSError:
        return b""


def meminfo():
    m = {}
    for line in read("/proc/meminfo").decode().splitlines():
        k, _, v = line.partition(":")
        m[k] = int(v.split()[0]) if v.split() else 0
    total, avail = m.get("MemTotal", 1), m.get("MemAvailable", 0)
    return {
        "total": total, "used": total - avail, "avail": avail,
        "cache": m.get("Cached", 0) + m.get("Buffers", 0) + m.get("SReclaimable", 0),
        "swap_total": m.get("SwapTotal", 0), "swap_used": m.get("SwapTotal", 0) - m.get("SwapFree", 0),
    }


def app_name(pid, exe):
    comm = read(f"/proc/{pid}/comm").decode(errors="replace").strip()
    if VERSION.match(exe):
        return comm or exe
    if INTERP.match(exe):
        # scripts: el nombre que se puso el proceso (zen-calendar) o el del script (zen-audio)
        if comm and not INTERP.match(comm):
            return comm
        for arg in read(f"/proc/{pid}/cmdline").decode(errors="replace").split("\0")[1:]:
            if arg and not arg.startswith("-"):
                return os.path.basename(arg)
    return exe


def mem_of(pid):
    """PSS en kB (RSS si no se puede leer smaps_rollup)."""
    for line in read(f"/proc/{pid}/smaps_rollup").decode().splitlines():
        if line.startswith("Pss:"):
            return int(line.split()[1])
    statm = read(f"/proc/{pid}/statm").split()
    return int(statm[1]) * (os.sysconf("SC_PAGE_SIZE") // 1024) if len(statm) > 1 else 0


def tmpfs_used():
    """kB ocupados en tmpfs (/tmp y compañía): son archivos, pero viven en la RAM."""
    used = 0
    for line in read("/proc/mounts").decode().splitlines():
        f = line.split()
        if len(f) > 2 and f[2] == "tmpfs":
            try:
                s = os.statvfs(f[1])
                used += (s.f_blocks - s.f_bfree) * s.f_frsize // 1024
            except OSError:
                pass
    return used


def unit_of(pid):
    """Unidad de systemd del proceso (app-niri-foot-1234.scope, mako.service…) o "" si no hay."""
    for line in read(f"/proc/{pid}/cgroup").decode(errors="replace").splitlines():
        if line.startswith("0::"):
            for part in reversed(line[3:].split("/")):
                if part.endswith((".scope", ".service")):
                    return part
    return ""


def unit_label(unit):
    """Nombre corto de la unidad para distinguir filas: app-niri-alacritty-1162.scope → alacritty."""
    u = re.sub(r"\.(scope|service)$", "", unit)
    u = re.sub(r"^app-(niri-)?", "", u)
    u = re.sub(r"(@[^@]*|-\d+)$", "", u)
    return re.sub(r"\\x([0-9a-f]{2})", lambda m: chr(int(m[1], 16)), u)   # escapes de systemd (\x2d = -)


def locked(pid, name, unit):
    """Motivo por el que no se ofrece cerrar el proceso, o None si se puede."""
    if name in PROTECTED or name.startswith(("xdg-", "gvfs")):
        return "Parte del escritorio: no se cierra desde aquí"
    if name in SHELLS:
        return "Shell de una terminal: ciérrala desde su terminal"
    args = read(f"/proc/{pid}/cmdline").decode(errors="replace").split("\0")
    if any(a in SESSION_FLAGS for a in args):
        return "Módulo de la barra o servicio del escritorio: no se cierra desde aquí"
    if (unit in ("niri.service", "init.scope") or unit.startswith(("session-", "app-niri-waybar-"))
            or (unit.endswith(".service") and not unit.startswith(("app-", "dbus-:")))):
        # la sesión, la barra y lo que cuelga de ella, y los servicios de systemd (los reinicia él)
        return "Parte de la sesión: no se cierra desde aquí"
    return None


def group_of(pid):
    """(clave del grupo, nombre, unidad, motivo de bloqueo) de un proceso del usuario, o None."""
    try:
        exe = os.path.basename(os.readlink(f"/proc/{pid}/exe")).removesuffix(" (deleted)")
    except OSError:
        return None
    name = app_name(pid, exe)
    unit = unit_of(pid)
    lock = locked(pid, name, unit)
    # nombre + unidad: las zsh de cada terminal o cada app electron van aparte; lo bloqueado
    # también, para que cerrar el panel de zen-media no arrastre al zen-media --waybar
    return (name, unit, lock is not None), name, unit, lock


def snapshot():
    """Memoria del sistema (con el desglose de lo usado) + apps del usuario agrupadas, de mayor a menor."""
    uid, me = os.getuid(), os.getpid()
    page_kb = os.sysconf("SC_PAGE_SIZE") // 1024
    apps, others = {}, 0
    for d in os.listdir("/proc"):
        if not d.isdigit() or int(d) == me:
            continue
        try:
            if os.stat(f"/proc/{d}").st_uid != uid:
                # root y servicios: solo su RSS (smaps no es legible sin permisos)
                statm = read(f"/proc/{d}/statm").split()
                others += int(statm[1]) * page_kb if len(statm) > 1 else 0
                continue
        except OSError:
            continue
        g = group_of(d)
        if g is None:
            continue
        key, name, unit, lock = g
        a = apps.setdefault(key, {"kb": 0, "pids": [], "name": name, "unit": unit, "lock": lock})
        a["kb"] += mem_of(d)
        a["pids"].append(int(d))
    mem = meminfo()
    mem["mine"] = sum(a["kb"] for a in apps.values())
    mem["others"] = others
    mem["tmpfs"] = tmpfs_used()
    mem["kernel"] = max(0, mem["used"] - mem["mine"] - mem["others"] - mem["tmpfs"])
    return mem, sorted(apps.items(), key=lambda kv: -kv[1]["kb"])


def desktop_index():
    """nombre de proceso → (nombre bonito, icono) según los .desktop instalados."""
    idx = {}
    dirs = [os.path.expanduser("~/.local/share/applications"), "/usr/share/applications"]
    for path in [p for d in dirs for p in sorted(glob.glob(os.path.join(d, "*.desktop")))]:
        cp = configparser.ConfigParser(interpolation=None, strict=False)
        try:
            cp.read(path, encoding="utf-8")
            e = cp["Desktop Entry"]
        except (configparser.Error, KeyError, UnicodeDecodeError):
            continue
        if e.get("NoDisplay", "").lower() == "true":   # accesos ocultos (manejadores de URL…)
            continue
        entry = (e.get("Name", ""), e.get("Icon", ""))
        keys = {os.path.basename(path)[:-8], e.get("Icon", ""), e.get("StartupWMClass", ""),
                os.path.basename((e.get("Exec", "").split() or [""])[0])}
        for k in keys:
            if k:
                idx.setdefault(k.lower(), entry)
    return idx


class AppRow:
    def __init__(self, panel, key, info):
        self.panel, self.key, self.pids, self.mem = panel, key, [], 0
        self.name, self.unit = info["name"], info["unit"]
        self.confirm_until = 0
        self.term_at = 0
        self.box = Gtk.Box()
        self.box.add_css_class("app")
        # icono y glifo existen los dos: al llegar los .desktop se cambia cuál se ve, sin recrear
        self.img = Gtk.Image(pixel_size=22)
        self.img.add_css_class("app-icon")
        self.glyph = Gtk.Label(label="\U000f08c6")   # nf-md-application_outline
        self.glyph.add_css_class("app-glyph")
        self.box.append(self.img)
        self.box.append(self.glyph)
        info_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, hexpand=True, valign=Gtk.Align.CENTER)
        self.title = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END, max_width_chars=24)
        self.title.add_css_class("app-name")
        self.meta = Gtk.Label(xalign=0)
        self.meta.add_css_class("app-meta")
        self.bar = Gtk.ProgressBar(valign=Gtk.Align.CENTER)
        self.bar.set_margin_top(3)
        info_box.append(self.title)
        info_box.append(self.meta)
        info_box.append(self.bar)
        self.box.append(info_box)
        self.mem_lbl = Gtk.Label(xalign=1, valign=Gtk.Align.CENTER)
        self.mem_lbl.add_css_class("app-mem")
        self.box.append(self.mem_lbl)
        self.identity()
        if info["lock"]:
            lock = Gtk.Label(label="\U000f033e", tooltip_text=info["lock"])
            lock.add_css_class("lock")
            self.box.append(lock)
            self.btn = None
        else:
            self.btn = Gtk.Button(valign=Gtk.Align.CENTER)
            self.btn.add_css_class("kill")
            self.btn.connect("clicked", self.on_kill)
            self.box.append(self.btn)

    def identity(self):
        """Nombre e icono según los .desktop (se repite cuando termina de leerlos el hilo)."""
        pretty, icon = self.panel.lookup(self.name)
        self.title.set_label(pretty or self.name)
        theme = Gtk.IconTheme.get_for_display(Gdk.Display.get_default())
        cand = [i for i in (icon, self.name, self.name.lower()) if i and theme.has_icon(i)]
        if cand:
            self.img.set_from_icon_name(cand[0])
        self.img.set_visible(bool(cand))
        self.glyph.set_visible(not cand)

    def update(self, info, total, twin=False):
        self.pids, self.mem = info["pids"], info["kb"]
        n = len(self.pids)
        meta = f"{n} proceso{'s' if n != 1 else ''}"
        where = unit_label(self.unit)
        if twin and where and where.lower() != self.name.lower():
            meta += f" · {where}"   # hay otra fila con el mismo nombre: de dónde se lanzó cada una
        self.meta.set_label(meta)
        self.mem_lbl.set_label(kb(self.mem))
        frac = self.mem / total
        self.bar.set_fraction(min(1.0, frac))
        for c in ("warn", "crit"):
            self.bar.remove_css_class(c)
        self.mem_lbl.remove_css_class("big")
        if frac >= 0.25:
            self.bar.add_css_class("crit")
            self.mem_lbl.add_css_class("big")
        elif frac >= 0.10:
            self.bar.add_css_class("warn")
        self.sync_button()

    def sync_button(self):
        if self.btn is None:
            return
        now = time.monotonic()
        for c in ("confirm", "force"):
            self.btn.remove_css_class(c)
        if self.term_at and now - self.term_at >= FORCE_AFTER:
            self.btn.set_label("Forzar")
            self.btn.add_css_class("force")
            self.btn.set_tooltip_text("No se cerró: terminarlo a la fuerza (SIGKILL, pierde lo no guardado)")
        elif now < self.confirm_until:
            self.btn.set_label("¿Cerrar?")
            self.btn.add_css_class("confirm")
            self.btn.set_tooltip_text("Clic otra vez para cerrar")
        else:
            self.btn.set_label("\U000f0156")   # nf-md-close
            self.btn.set_tooltip_text("Cerrar esta app (todos sus procesos)")

    def on_kill(self, _btn):
        now = time.monotonic()
        if self.term_at and now - self.term_at >= FORCE_AFTER:
            self.panel.signal_app(self, signal.SIGKILL)
        elif now < self.confirm_until:
            self.confirm_until = 0
            self.term_at = now
            self.panel.signal_app(self, signal.SIGTERM)
        else:
            self.confirm_until = now + CONFIRM_FOR
            GLib.timeout_add_seconds(CONFIRM_FOR, lambda: self.sync_button() or False)
        self.sync_button()


class Panel:
    def __init__(self, app):
        self.app = app
        self.rows = {}
        self.order = []
        self.timer = 0
        self.busy = False
        self.freed = {}   # app cerrada → memoria que usaba (para el aviso al desaparecer)
        self.pkexec = None        # «Liberar caché» en curso (esperando la contraseña)
        self.quit_after = False   # se pidió cerrar mientras pkexec esperaba: terminar al acabar
        self.index = {}
        # el dict se arma entero en el hilo y se asigna de una vez: lookup() nunca lo ve a medias
        threading.Thread(target=lambda: GLib.idle_add(self.set_index, desktop_index()), daemon=True).start()
        self.build()

    def set_index(self, idx):
        self.index = idx
        for row in self.rows.values():
            row.identity()
        return False

    def lookup(self, name):
        for k in (name.lower(), name.lower().split("-")[0]):
            if k in self.index:
                return self.index[k]
        for k, v in self.index.items():
            if k.startswith(name.lower() + "-"):
                return v
        return (name, name)

    def build(self):
        zen_panel.load_css(CSS)
        # a la izquierda, bajo el módulo de RAM de la barra
        win = zen_panel.layer_window(self.app, "zen-ram", "zen-ram", anchors=("TOP", "LEFT"), on_escape=self.hide)

        panel = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        panel.add_css_class("panel")
        panel.set_size_request(400, -1)
        head = Gtk.Box()
        icon = Gtk.Label(label="")   # nf-fa-memory (mismo chip que la barra)
        icon.add_css_class("title-icon")
        title = Gtk.Label(label="Memoria", xalign=0, hexpand=True)
        title.add_css_class("title")
        self.total = Gtk.Label()
        self.total.add_css_class("total")
        head.append(icon)
        head.append(title)
        head.append(self.total)
        panel.append(head)
        self.main_bar = Gtk.ProgressBar()
        self.main_bar.add_css_class("main")
        panel.append(self.main_bar)

        # de dónde sale lo usado (fila 1) y lo que no cuenta como usado (fila 2)
        self.stat = {}
        for row in ((("mine", "Tus apps", "Todas tus apps sumadas (las de la lista de abajo)"),
                     ("others", "Sistema", "Servicios de root: Xorg, NetworkManager, sddm…"),
                     ("tmpfs", "/tmp", "Archivos temporales: en Linux /tmp vive en la RAM"),
                     ("kernel", "Kernel", "Kernel, drivers y buffers de la gráfica")),
                    (("cache", "Caché", "Archivos recientes guardados en RAM: se libera sola cuando hace falta"),
                     ("avail", "Disponible", "Lo que todavía pueden usar las apps"),
                     ("swap", "Swap", "Memoria movida a zram/disco"))):
            stats = Gtk.Box(spacing=4)
            for key, name, tip in row:
                lbl = Gtk.Label(label=name, tooltip_text=tip)
                lbl.add_css_class("stats")
                val = Gtk.Label(tooltip_text=tip)
                val.add_css_class("stats-val")
                val.set_margin_end(8)
                stats.append(lbl)
                stats.append(val)
                self.stat[key] = val
            panel.append(stats)

        section = Gtk.Label(label="LO QUE MÁS USA", xalign=0)
        section.add_css_class("section")
        panel.append(section)
        # alto fijo para VISIBLE filas: con propagate-natural-height, como la lista está vacía al
        # abrir, el panel se quedaba con alto para una sola fila
        self.list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        panel.append(Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER,
                                        min_content_height=VISIBLE * ROW_H, max_content_height=VISIBLE * ROW_H,
                                        child=self.list))

        self.toast = Gtk.Label(xalign=0, wrap=True, max_width_chars=50)
        self.toast.add_css_class("toast")
        self.toast.set_visible(False)
        panel.append(self.toast)

        foot = Gtk.Box(spacing=6)
        foot.set_margin_top(10)
        drop = Gtk.Button(label="\U000f00e2  Liberar caché",
                          tooltip_text="Vacía la caché de archivos del kernel (pide tu contraseña).\n"
                                       "No cierra nada; la caché vuelve a llenarse con el uso.")
        drop.add_css_class("foot")
        drop.connect("clicked", self.drop_caches)
        btop = Gtk.Button(label="\U000f0128  btop", tooltip_text="Monitor completo de procesos en una terminal")
        btop.add_css_class("foot")
        btop.connect("clicked", self.open_btop)
        spacer = Gtk.Box(hexpand=True)
        foot.append(drop)
        foot.append(spacer)
        foot.append(btop)
        panel.append(foot)

        win.set_child(panel)
        self.win = win
        win.realize()                    # prepara el renderizador ahora y no en el primer clic

    # ---------- mostrar / ocultar

    @staticmethod
    def focused_monitor():
        try:
            out = subprocess.run(["niri", "msg", "-j", "focused-output"], capture_output=True, timeout=2).stdout
            name = json.loads(out).get("name")
        except (OSError, ValueError, AttributeError, subprocess.TimeoutExpired):
            return None
        monitors = Gdk.Display.get_default().get_monitors()
        for i in range(monitors.get_n_items()):
            if monitors.get_item(i).get_connector() == name:
                return monitors.get_item(i)
        return None

    def toggle(self):
        self.hide() if self.win.get_visible() else self.show()

    def show(self):
        mon = self.focused_monitor()
        if mon is not None:
            Layer.set_monitor(self.win, mon)
        self.quit_after = False
        if self.pkexec is None:
            self.toast.set_visible(False)
        self.win.present()
        self.refresh()
        if not self.timer:
            self.timer = GLib.timeout_add_seconds(REFRESH, self.refresh)

    def hide(self):
        if self.timer:
            GLib.source_remove(self.timer)
            self.timer = 0
        if self.pkexec is not None:
            # matar el panel ahora dejaría pkexec sin nadie que reciba el resultado: se oculta y
            # termina cuando pkexec acabe (el resultado llega como notificación)
            self.quit_after = True
            self.win.set_visible(False)
            return True
        self.app.quit()          # Esc, Super+C u otro clic: se cierra, no queda oculto
        return True

    # ---------- datos

    def refresh(self):
        if not self.busy:                 # la lectura de /proc va en un hilo: la UI no se traba
            self.busy = True
            threading.Thread(target=lambda: GLib.idle_add(self.apply, *snapshot()), daemon=True).start()
        return True

    def apply(self, mem, apps):
        self.busy = False
        total = mem["total"]
        self.total.set_label(f"{mem['used'] / GIB:.1f} / {total / GIB:.1f} GiB")
        frac = mem["used"] / total
        self.main_bar.set_fraction(frac)
        for c in ("warn", "crit"):
            self.main_bar.remove_css_class(c)
        if frac >= 0.90:
            self.main_bar.add_css_class("crit")
        elif frac >= 0.75:
            self.main_bar.add_css_class("warn")
        for key in ("mine", "others", "tmpfs", "kernel"):
            self.stat[key].set_label(kb(mem[key]))
        self.stat["cache"].set_label(kb(mem["cache"]))
        self.stat["avail"].set_label(kb(mem["avail"]))
        self.stat["swap"].set_label(f"{kb(mem['swap_used'])}" if mem["swap_total"] else "—")

        alive = {key for key, _ in apps}
        for key in [k for k in self.freed if k not in alive]:
            name, mem = self.freed.pop(key)
            self.say(f"{self.lookup(name)[0] or name} se cerró · liberó ~{kb(mem)}")
        top = apps[:TOP]
        names = [key for key, _ in top]
        count = {}
        for key, _ in top:
            count[key[0]] = count.get(key[0], 0) + 1
        for key, info in top:
            if key not in self.rows:
                self.rows[key] = AppRow(self, key, info)
            self.rows[key].update(info, total, twin=count[key[0]] > 1)
        if names != self.order:           # reordenar sin recrear filas: no parpadea ni pierde el hover
            child = self.list.get_first_child()
            while child is not None:
                nxt = child.get_next_sibling()
                self.list.remove(child)
                child = nxt
            for name in names:
                self.list.append(self.rows[name].box)
            self.order = names
        for name in [n for n in self.rows if n not in alive]:
            del self.rows[name]
        return False

    # ---------- acciones

    def signal_app(self, row, sig):
        if row.btn is None:
            return
        uid = os.getuid()
        for pid in row.pids:
            # el pid se vuelve a comprobar: entre lectura y clic pudo morir y reusarse para otro proceso
            try:
                if os.stat(f"/proc/{pid}").st_uid != uid:
                    continue
            except OSError:
                continue
            g = group_of(pid)
            if g is None or g[0] != row.key:
                continue
            try:
                os.kill(pid, sig)
            except (ProcessLookupError, PermissionError):
                pass
        self.freed[row.key] = (row.name, row.mem)
        pretty = self.lookup(row.name)[0] or row.name
        self.say(f"Cerrando {pretty}…" if sig == signal.SIGTERM else f"Forzando el cierre de {pretty}…")
        GLib.timeout_add(1200, lambda: self.refresh() and False)
        if sig == signal.SIGTERM:
            GLib.timeout_add_seconds(FORCE_AFTER, lambda: self.refresh() and False)

    def drop_caches(self, _btn):
        if self.pkexec is not None:
            return
        before = meminfo()["cache"]
        # sync no necesita root (lo sucio en caché no se puede soltar); en un hilo: puede tardar y
        # mientras tanto se escribe la contraseña
        threading.Thread(target=os.sync, daemon=True).start()
        try:
            # solo tee sobre drop_caches (con "3" por stdin), no una shell de root para cualquier cosa
            proc = Gio.Subprocess.new(["pkexec", "/usr/bin/tee", "/proc/sys/vm/drop_caches"],
                                      Gio.SubprocessFlags.STDIN_PIPE | Gio.SubprocessFlags.STDOUT_SILENCE
                                      | Gio.SubprocessFlags.STDERR_SILENCE)
        except GLib.Error:
            self.say("No se pudo pedir permiso (pkexec)", error=True)
            return
        self.pkexec = proc
        # con teclado exclusivo el diálogo de polkit no recibiría la contraseña: se suelta mientras dure
        Layer.set_keyboard_mode(self.win, Layer.KeyboardMode.NONE)
        self.say("Escribe tu contraseña en la ventana de autorización…")

        def done(p, res):
            try:
                p.communicate_utf8_finish(res)
                ok = p.get_if_exited() and p.get_exit_status() == 0
            except GLib.Error:
                ok = False
            self.pkexec = None
            if ok:
                text, err = f"Caché liberada: {kb(max(0, before - meminfo()['cache']))}", False
            else:
                text, err = "Cancelado: no se liberó la caché", True
            if self.quit_after:
                # el panel se cerró mientras esperaba: el resultado va como notificación y termina
                subprocess.Popen(["notify-send", "-a", "Memoria", "-i", "memory", text],
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                self.app.quit()
                return
            Layer.set_keyboard_mode(self.win, Layer.KeyboardMode.EXCLUSIVE)
            self.say(text, error=err)
            self.refresh()

        proc.communicate_utf8_async("3\n", None, done)

    def open_btop(self, _btn):
        self.hide()
        subprocess.Popen([os.path.expanduser("~/.local/bin/zen-term"), "-e", "btop"], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def say(self, text, error=False):
        self.toast.set_label(text)
        (self.toast.add_css_class if error else self.toast.remove_css_class)("err")
        self.toast.set_visible(True)


def main():
    zen_panel.run("pe.zen.Ram", "zen-ram", Panel)


if __name__ == "__main__":
    main()
