#!/usr/bin/env python3
"""zen-ram — panel de memoria debajo de la barra (mismo estilo que zen-audio).

Muestra cuánta RAM se usa y qué apps consumen más (todos sus procesos sumados, en PSS: la
memoria compartida se reparte y no se cuenta dos veces). Cada app se puede cerrar desde aquí:
primer clic pide confirmación, el segundo le manda SIGTERM (cierre normal, guarda su estado);
si no se cierra en unos segundos aparece «Forzar» (SIGKILL). Lo esencial del escritorio no se
puede cerrar. «Liberar caché» vacía la caché de archivos del kernel (pide la contraseña).

Los procesos se agrupan por app y por la unidad de systemd que los lanzó (/proc/<pid>/cgroup):
dos terminales o dos apps electron son filas distintas. Shells interactivas, procesos de la sesión
(niri, la barra, servicios de systemd, los --waybar / --daemon) y este panel no tienen botón.

Clic en la RAM de waybar o Super+Shift+M lo abre; otro clic, Super+Shift+M, Super+C o Esc lo cierra
(termina, no queda oculto).
"""
import configparser
import glob
import json
import os
import re
import signal
import subprocess
import sys
import threading
import time

# lo común de los paneles vive en zen_panel.py, junto al script real (~/.local/bin o el repo)
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import zen_panel  # noqa: E402

zen_panel.preload_layer_shell()     # re-exec con gtk4-layer-shell, antes de importar Gtk

import gi  # noqa: E402

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
gi.require_version("Gtk4LayerShell", "1.0")
from gi.repository import Gdk, Gio, GLib, Gtk, Pango, Gtk4LayerShell as Layer  # noqa: E402

