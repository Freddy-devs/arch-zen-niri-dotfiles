#!/usr/bin/env python3
"""zen-ram — panel de memoria debajo de la barra (mismo estilo que zen-audio).

Muestra cuánta RAM se usa y qué apps consumen más (todos sus procesos sumados, en PSS: la
memoria compartida se reparte y no se cuenta dos veces). Cada app se puede cerrar desde aquí:
primer clic pide confirmación, el segundo le manda SIGTERM (cierre normal, guarda su estado);
si no se cierra en unos segundos aparece «Forzar» (SIGKILL). Lo esencial del escritorio no se
puede cerrar. «Liberar caché» vacía la caché de archivos del kernel (pide la contraseña).

Clic en la RAM de waybar o Super+Shift+M lo abre; otro clic, Super+Shift+M o Esc lo cierra.
Queda residente: zen-toggle ram lo muestra al instante.
"""
import configparser
import glob
import json
import os
import re
import signal
import subprocess
import sys
import threading
import time

# gtk4-layer-shell debe cargarse antes que libwayland; en Python solo se logra con LD_PRELOAD
# dibujo por CPU (cairo): para un panel chico basta y usa la mitad de RAM que el renderizador GL
os.environ.setdefault("GSK_RENDERER", "cairo")

LAYER_LIB = "/usr/lib/libgtk4-layer-shell.so"
if LAYER_LIB not in os.environ.get("LD_PRELOAD", ""):
    os.environ["LD_PRELOAD"] = ":".join(filter(None, [LAYER_LIB, os.environ.get("LD_PRELOAD")]))
    os.execv(sys.executable, [sys.executable] + sys.argv)

import gi  # noqa: E402

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
gi.require_version("Gtk4LayerShell", "1.0")
from gi.repository import Gdk, Gio, GLib, Gtk, Pango, Gtk4LayerShell as Layer  # noqa: E402

CSS = """
window.zen-ram { background: transparent; }
.panel {
    background: #1a1b26; border: 1px solid #292e42; border-radius: 14px; padding: 14px 14px 10px;
    color: #eceff4; font-family: Inter, sans-serif; font-size: 13px;
}
.title { font-size: 15px; font-weight: 800; color: #eceff4; }
.title-icon { font-family: "Symbols Nerd Font", "JetBrainsMono Nerd Font"; font-size: 17px; color: #8fbcbb; margin-right: 8px; }
.total { font-family: "JetBrainsMono Nerd Font", monospace; font-weight: 700; color: #d8dee9; }
progressbar.main { margin: 10px 0 6px; }
progressbar.main trough { min-height: 8px; }
progressbar.main progress { min-height: 8px; }
progressbar trough { background: #3b4252; border-radius: 4px; min-height: 3px; border: none; }
progressbar progress { background: #8fbcbb; border-radius: 4px; min-height: 3px; border: none; }
progressbar.warn progress { background: #d08770; }
progressbar.crit progress { background: #bf616a; }
.stats { color: #7b88a1; font-size: 11px; }
