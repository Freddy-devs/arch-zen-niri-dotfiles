#!/usr/bin/env bash
# tunel — expone un servicio local por ngrok para recibir webhooks. No trae proyectos fijos:
# cada proyecto define el suyo cuando lo necesita.
#   tunel 8100             abre un túnel a ese puerto
#   tunel                  usa el archivo .tunel del proyecto (se busca desde la carpeta actual hacia
#                          arriba); si no hay, pide el puerto
#   tunel url              muestra la URL pública del túnel abierto
#
# .tunel (opcional, en la raíz de un proyecto):
#   puerto=8100
#   opciones=--host-header=rewrite      # p. ej. para Vite, que rechaza Hosts desconocidos
#
# La URL es siempre la misma (dominio fijo de tu cuenta ngrok): se configura una vez en el
# proveedor del webhook. Cada petición que llega se ve y se puede repetir en http://127.0.0.1:4040
# Solo hay un túnel a la vez (cuenta gratuita: el dominio fijo admite un túnel).

INSPECTOR=http://127.0.0.1:4040
c_b=$'\033[1;34m'; c_g=$'\033[1;32m'; c_y=$'\033[1;33m'; c_r=$'\033[1;31m'; c_d=$'\033[2m'; c_0=$'\033[0m'

command -v ngrok >/dev/null || { echo "${c_r}ngrok no está instalado:${c_0} zen-apps ngrok"; exit 1; }

case ${1:-} in
    -h|--help) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    url)
        curl -fsS "$INSPECTOR/api/tunnels" 2>/dev/null |
            python3 -c 'import json,sys; [print(t["public_url"], "→", t["config"]["addr"]) for t in json.load(sys.stdin)["tunnels"]]' 2>/dev/null \
            || echo "No hay ningún túnel abierto."
        exit ;;
esac

if ! grep -q "authtoken:" "${XDG_CONFIG_HOME:-$HOME/.config}/ngrok/ngrok.yml" 2>/dev/null; then
    echo "${c_y}Falta tu authtoken de ngrok.${c_0}"
    echo "  1. Entra a https://dashboard.ngrok.com/get-started/your-authtoken (crea la cuenta si no tienes)"
    echo "  2. Copia el token y ejecuta:  ngrok config add-authtoken <token>"
    exit 1
fi

puerto=${1:-} opciones="" origen="argumento"
if [[ -z $puerto ]]; then
    dir=$PWD
    while [[ $dir != / && ! -f $dir/.tunel ]]; do dir=${dir%/*}; dir=${dir:-/}; done
    if [[ -f $dir/.tunel ]]; then
        # solo se leen estas dos claves (el archivo no se ejecuta)
        puerto=$(sed -n 's/^puerto=//p' "$dir/.tunel" | head -1)
        opciones=$(sed -n 's/^opciones=//p' "$dir/.tunel" | head -1)
        origen="$dir/.tunel"
    else
        read -rp "Puerto local a exponer: " puerto
    fi
fi
[[ $puerto =~ ^[0-9]+$ ]] || { echo "${c_r}Puerto inválido:${c_0} «$puerto»"; exit 1; }

if curl -fsS "$INSPECTOR/api/tunnels" >/dev/null 2>&1; then
    echo "${c_y}Ya hay un túnel abierto:${c_0} $("$0" url)"
    echo "Ciérralo (Ctrl+C en su terminal) antes de abrir otro."
    exit 1
fi

# avisa si el servicio no está levantado (el túnel igual se abre y espera a que arranque)
if ! (exec 3<>"/dev/tcp/127.0.0.1/$puerto") 2>/dev/null; then
    echo "${c_y}Aviso:${c_0} nada escucha en el puerto $puerto todavía; los webhooks darán 502 hasta que lo levantes."
fi

read -ra extra <<<"$opciones"
echo "${c_b}==>${c_0} Túnel → ${c_g}localhost:$puerto${c_0}   ${c_d}($origen · inspector: $INSPECTOR · Ctrl+C para cerrar)${c_0}"
exec ngrok http "$puerto" --log=false "${extra[@]}"
