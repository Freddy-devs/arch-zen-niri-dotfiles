#!/usr/bin/env python3
"""zen-network — panel de red debajo de la barra (mismo estilo que zen-bluetooth).

Clic en el ícono de red de waybar lo abre; otro clic (o Esc) lo cierra.
Habla directo con NetworkManager por libnm: muestra la conexión actual, busca redes
Wi-Fi y conecta (la contraseña se escribe en la misma fila). Cada red guardada tiene su menú (⋮):
conectar sola, preferida, ver o compartir la contraseña (QR). Abajo: red oculta y compartir Wi-Fi
(punto de acceso). VPN y WireGuard guardadas se conectan desde su sección. Lo avanzado (802.1X,
IP fija) sigue en nmtui con clic derecho en la barra.
"""
import os
import secrets
import shutil
import socket
import subprocess
import sys

# lo común de los paneles vive en zen_panel.py, junto al script real (~/.local/bin o el repo)
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import zen_panel  # noqa: E402

zen_panel.preload_layer_shell()     # re-exec con gtk4-layer-shell, antes de importar Gtk

import gi  # noqa: E402

gi.require_version("Gtk", "4.0")
gi.require_version("NM", "1.0")
gi.require_version("Gdk", "4.0")
from gi.repository import Gdk, GLib, Gtk, NM  # noqa: E402

ApFlags = getattr(NM, "80211ApFlags")
Sec = getattr(NM, "80211ApSecurityFlags")
ACState = NM.ActiveConnectionState
# fallas de activación que significan "contraseña incorrecta"
BAD_PASSWORD = {NM.ActiveConnectionStateReason.NO_SECRETS, NM.ActiveConnectionStateReason.LOGIN_FAILED}

SIGNAL_ICONS = ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"]
TYPE_ICONS = {"802-3-ethernet": "󰈀", "802-11-wireless": "󰖩", "wireguard": "󰒃", "vpn": "󰒃"}
TYPE_NAMES = {"802-3-ethernet": "Cable", "802-11-wireless": "Wi-Fi", "wireguard": "WireGuard", "vpn": "VPN"}

ROWS_VISIBLE, ROW_HEIGHT = 5, 51     # filas de la lista sin scroll y alto de cada una (con su margen)

# un perfil nuevo vive solo en memoria hasta que conecta: así una clave mala nunca llega al disco
IN_MEMORY = GLib.Variant("a{sv}", {"persist": GLib.Variant("s", "memory")})
FINAL_STATES = (ACState.ACTIVATED, ACState.DEACTIVATED)

NAME = "zen-network"     # pidfile: hide() lo borra antes de salir si espera una conexión

SEC = NM.SETTING_WIRELESS_SECURITY_SETTING_NAME      # "802-11-wireless-security": donde vive la clave
VPN_TYPES = ("vpn", "wireguard")
HOTSPOT_ID = "Compartir Wi-Fi"                       # nombre del perfil de punto de acceso que crea el panel
# sin caracteres que se confunden al dictarla o leerla en el móvil (0/O, 1/l/I, 8/B)
HOTSPOT_CHARS = "abcdefghijkmnpqrstuvwxyzACDEFGHJKLMNPQRTUVWXY2345679"
HIDDEN_KINDS = [("WPA2", "wpa-psk"), ("WPA3", "sae"), ("Abierta", None)]

