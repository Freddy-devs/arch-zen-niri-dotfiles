.empty { color: #565f89; padding: 6px 2px; }
.card {
    background: #222330; border-radius: 10px; padding: 8px 10px; margin-bottom: 5px;
    border-left: 3px solid #7aa2f7;
}
.card.muted { border-left-color: #3b4261; }
.card.mic { border-left-color: #bb9af7; }
