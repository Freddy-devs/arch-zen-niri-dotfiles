def pactl(*args):
    """Comando de pactl sin esperar (clics sueltos: silencio, dispositivo por defecto)."""
    try:
        subprocess.Popen(["pactl", *args], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


def pactl_run(*args, timeout=5):
    """Comando de pactl esperando, con tope: un pactl colgado no debe trabar el panel."""
    try:
        return subprocess.run(["pactl", *args], capture_output=True, text=True, timeout=timeout).stdout
    except (subprocess.SubprocessError, OSError):
        return ""


def pactl_json(what):
    try:
        return json.loads(pactl_run("-f", "json", "list", what, timeout=3) or "[]")
    except ValueError:
        return []


def pactl_get(what):
    return pactl_run(what, timeout=3).strip()


def volume(obj):
    vals = [int(c["value_percent"].rstrip("%")) for c in obj.get("volume", {}).values()]
    return round(sum(vals) / len(vals)) if vals else 0


def port_icon(text):
    text = text.lower()
    if any(w in text for w in ("headphone", "headset", "bluez", "auricular", "a2dp", "hands")):
        return "󰋋"
    if "hdmi" in text or "displayport" in text:
        return "󰡁"
    return "󰓃"


def is_input_port(name, port, profiles):
    """Puerto de micrófono: está en algún perfil solo de entrada (sin sinks) o se llama así.

    No basta con mirar el prefijo: los perfiles Bluetooth (a2dp-sink, headset-head-unit…) no empiezan
    por "output:", y los mixtos "output:…+input:…" también contienen al micrófono analógico.
    """
    for pp in port.get("profiles", []):
        prof = profiles.get(pp, {})
        if pp.startswith("input:") or (prof.get("sinks") == 0 and prof.get("sources", 0) > 0):
            return True
    return "input" in name or port.get("type", "").lower() in ("mic", "line-in")


def output_ports(cards, sinks):
    """Todas las salidas físicas: cada puerto de cada tarjeta, aunque su perfil no esté activo.

    PipeWire solo crea el sink del perfil activo (p. ej. altavoces/auriculares O HDMI), por eso
    listar sinks no basta. Se ocultan los puertos que ni existen en esta máquina (HDMI 2, HDMI 3…).
    """
    by_card = {s.get("properties", {}).get("device.name"): s for s in sinks}
    outs = []
    for card in cards:
        profiles = card.get("profiles", {})
        sink = by_card.get(card["name"])
        for pname, port in card.get("ports", {}).items():
            pprofs = [pp for pp in port.get("profiles", []) if pp != "off"]
            if not pprofs or is_input_port(pname, port, profiles):
                continue     # puerto de entrada (micrófono)
            usable = [pp for pp in pprofs if profiles.get(pp, {}).get("available")]
            plugged = port.get("availability") != "not available"
            if not usable or (not plugged and not any(pname == p["name"] for p in (sink or {}).get("ports", [])
                                                      ) and "hdmi" in pname):
                continue
            outs.append({
                "card": card["name"], "port": pname, "plugged": plugged,
                "label": port.get("description") or pname,
                "card_label": card.get("properties", {}).get("device.description", ""),
                "profile": pick_profile(card, usable),
                "sink": sink["name"] if sink and any(p["name"] == pname for p in sink.get("ports", [])) else None,
                "active_port": sink.get("active_port") if sink else None,
            })
    known = set(by_card)
    for s in sinks:     # sinks sin tarjeta (virtuales, de red…)
        if s.get("properties", {}).get("device.name") not in known or not s.get("ports"):
            if not any(o["sink"] == s["name"] for o in outs):
                outs.append({"card": None, "port": None, "plugged": True, "label": s["description"],
                             "card_label": "", "profile": None, "sink": s["name"], "active_port": None})
    return outs


def pick_profile(card, usable):
    """Perfil para activar un puerto: el actual si sirve; si no, uno que conserve el micrófono y en estéreo."""
    active = card.get("active_profile", "")
    if active in usable:
        return active
    inp = active.split("+", 1)[1] if "+" in active else (active if active.startswith("input:") else None)
    return max(usable, key=lambda p: (inp is not None and p.endswith("+" + inp), "surround" not in p,
                                      p != "pro-audio", -len(p)))


def choose_output(out, done):
    """Cambia el perfil de la tarjeta si hace falta, espera a que aparezca el sink y lo deja por defecto."""
    def run():
        try:
            card_now = next((c for c in pactl_json("cards") if c["name"] == out["card"]), None) if out["card"] else None
            if card_now and card_now.get("active_profile") != out["profile"]:
                pactl_run("set-card-profile", out["card"], out["profile"])
            sink = out["sink"] if not out["card"] else None
            for _ in range(30):
                if sink:
                    break
                for s in pactl_json("sinks"):
                    if (s.get("properties", {}).get("device.name") == out["card"]
                            and any(p["name"] == out["port"] for p in s.get("ports", []))):
                        sink = s["name"]
                time.sleep(0.1)
            if sink:
                if out["port"]:
                    pactl_run("set-sink-port", sink, out["port"])
                pactl_run("set-default-sink", sink)
        finally:
            GLib.idle_add(done)      # pase lo que pase, la lista vuelve a estar activa
    threading.Thread(target=run, daemon=True).start()


class VolumeCard:
    """Tarjeta con botón de silencio, slider y porcentaje. kind: 'sink', 'source' o 'sink-input'."""

    def __init__(self, kind, icon_on, icon_off, extra_class=None, lead=None):
        self.kind, self.icon_on, self.icon_off = kind, icon_on, icon_off
        self.target, self.muted, self.updating = None, False, False
        self.touched = 0.0       # último movimiento del usuario: no pisar su arrastre
        self.pending, self.busy = None, False
        self.box = row = Gtk.Box()
        self.box.add_css_class("vol")
        if extra_class:
            self.box.add_css_class(extra_class)
        for w in lead or []:
            row.append(w)
        self.mute_btn = Gtk.Button(valign=Gtk.Align.CENTER, tooltip_text="Silenciar")
        self.mute_btn.add_css_class("mute")
        self.mute_btn.connect("clicked", self.on_mute)
        self.scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, MAX_VOL, 1)
        self.scale.set_hexpand(True)
        self.scale.set_draw_value(False)
        self.scale.connect("value-changed", self.on_scale)
        self.pct = Gtk.Label(xalign=1)
        self.pct.add_css_class("pct")
        if not lead:
            row.append(self.mute_btn)
        row.append(self.scale)
        row.append(self.pct)

    def set(self, target, vol, muted):
        self.target, self.muted = target, muted
        # con un comando en vuelo el valor leído ya es viejo: no devolver el slider atrás
        idle = not self.busy and self.pending is None and time.monotonic() - self.touched > 0.6
        self.updating = True
        if idle and abs(self.scale.get_value() - vol) >= 1:
            self.scale.set_value(vol)
        self.updating = False
        if idle:
            self.pct.set_label(f"{vol}%")
        self.mute_btn.set_label(self.icon_off if muted else self.icon_on)
        (self.box.add_css_class if muted else self.box.remove_css_class)("muted")

    def on_scale(self, scale):
        vol = int(scale.get_value())
        self.pct.set_label(f"{vol}%")
        if self.updating or self.target is None:
            return
        self.touched = time.monotonic()
        self.pending = vol
        if not self.busy:
            self.flush()

    def flush(self):
        """Un solo pactl a la vez; al terminar manda el último valor pedido (en orden, sin cola)."""
        if self.pending is None:
            self.busy = False
            return False
        vol, self.pending, self.busy = self.pending, None, True
        kind, target, unmute = self.kind, str(self.target), self.muted and vol > 0

        def work():
            pactl_run(f"set-{kind}-volume", target, f"{vol}%")
            if unmute:
                pactl_run(f"set-{kind}-mute", target, "0")
            GLib.idle_add(self.flush)
        threading.Thread(target=work, daemon=True).start()
        return False

    def on_mute(self, _):
        if self.target is not None:
            pactl(f"set-{self.kind}-mute", str(self.target), "toggle")


class Panel:
    def __init__(self, app):
        self.app = app
        self.refresh_pending = False     # hay un refresh programado
        self.fetching = False            # hay una consulta en curso
        self.dirty = False               # llegó un evento durante la consulta: repetirla
        self.layout_key = None
        self.app_cards = {}
        self.build_window()
        self.refresh()
        self.watch()

    # ---------- ventana ----------
    def build_window(self):
        zen_panel.load_css(CSS)
        win = zen_panel.layer_window(self.app, "zen-audio", "zen-audio", on_escape=self.close)

        panel = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        panel.add_css_class("panel")
        panel.set_size_request(340, -1)

        head = Gtk.Box()
        icon = Gtk.Label(label="󰕾")
        icon.add_css_class("title-icon")
        title = Gtk.Label(label="Sonido", xalign=0, hexpand=True)
        title.add_css_class("title")
        head.append(icon)
        head.append(title)
        panel.append(head)

        stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE, transition_duration=120,
                          vhomogeneous=False, interpolate_size=True)
        tabs = Gtk.Box(homogeneous=True)
        tabs.add_css_class("tabs")
        first = None
        for name, label in (("out", "Salida"), ("in", "Entrada")):
            btn = Gtk.ToggleButton(label=label, group=first)
            btn.connect("toggled", lambda b, n=name: b.get_active() and stack.set_visible_child_name(n))
            tabs.append(btn)
            first = first or btn
        panel.append(tabs)

        out = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.out_card = VolumeCard("sink", "󰕾", "󰝟")
        out.append(self.out_card.box)
        self.sink_list = self.listbox()
        out.append(self.sink_list)
        out.append(self.section("APLICACIONES"))
        self.apps_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        scroller = Gtk.ScrolledWindow(propagate_natural_height=True, max_content_height=200,
                                      hscrollbar_policy=Gtk.PolicyType.NEVER)
        scroller.set_child(self.apps_box)
        self.apps_empty = Gtk.Label(label="Ninguna aplicación está sonando", xalign=0)
        self.apps_empty.add_css_class("empty")
        out.append(self.apps_empty)
        out.append(scroller)
        self.apps_scroller = scroller
        stack.add_named(out, "out")

        inp = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        inp.add_css_class("mic")
        self.in_card = VolumeCard("source", "󰍬", "󰍭", "mic")
        inp.append(self.in_card.box)
        self.source_list = self.listbox()
        inp.append(self.source_list)
        stack.add_named(inp, "in")
        panel.append(stack)
        first.set_active(True)

        win.set_child(panel)
        self.win = win
        win.realize()                    # prepara el renderizador ahora y no en el primer clic

    def section(self, text):
        lbl = Gtk.Label(label=text, xalign=0)
        lbl.add_css_class("section")
        return lbl

    def listbox(self):
        lb = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
        lb.connect("row-activated", lambda l, row: row.activate_action())
        return lb

    # ---------- PipeWire ----------
    def watch(self):
        """pactl subscribe avisa de cada cambio (otra app, teclas de volumen, auriculares nuevos)."""
        self.sub = Gio.Subprocess.new(["pactl", "subscribe"], Gio.SubprocessFlags.STDOUT_PIPE)
        self.sub_out = Gio.DataInputStream.new(self.sub.get_stdout_pipe())
        self.sub_out.read_line_async(GLib.PRIORITY_DEFAULT, None, self.on_event)

    def on_event(self, stream, res):
        line, _ = stream.read_line_finish_utf8(res)
        if line is None:
            return
        # cada pactl que corremos abre y cierra un "client": reaccionar a eso sería un bucle sin fin
        if " on client " not in line:
            self.queue_refresh()
        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, self.on_event)

    def queue_refresh(self):
        if self.fetching:
            self.dirty = True            # lo leído ya puede ser viejo: otra vuelta al terminar
        elif not self.refresh_pending:
            self.refresh_pending = True
            GLib.timeout_add(120, self.refresh)

    def refresh(self):
        """Consulta PipeWire en un hilo (unos 130 ms) para no congelar la ventana; luego aplica."""
        self.refresh_pending = False
        if self.fetching:
            self.dirty = True
            return False
        self.fetching, self.dirty = True, False

        def fetch():
            try:
                data = (pactl_json("sinks"), pactl_json("cards"), pactl_json("sources"), pactl_json("sink-inputs"),
                        pactl_get("get-default-sink"), pactl_get("get-default-source"))
                GLib.idle_add(self.apply, *data)
            except Exception:
                traceback.print_exc()
                GLib.idle_add(self.fetched)
        threading.Thread(target=fetch, daemon=True).start()
        return False

    def fetched(self):
        self.fetching = False
        if self.dirty:
            self.dirty = False
            self.queue_refresh()
        return False

    def apply(self, *data):
        try:
            self.apply_data(*data)
        finally:
            self.fetched()
        return False

    def apply_data(self, sinks, cards, sources, inputs, def_sink, def_source):
        outputs = output_ports(cards, sinks)
        sources = [s for s in sources if not s.get("name", "").endswith(".monitor")]

        sink = next((s for s in sinks if s["name"] == def_sink), sinks[0] if sinks else None)
        source = next((s for s in sources if s["name"] == def_source), sources[0] if sources else None)
        if sink:
            self.out_card.set(sink["name"], volume(sink), sink.get("mute", False))
        if source:
            self.in_card.set(source["name"], volume(source), source.get("mute", False))

        # las listas solo se rehacen si cambian los dispositivos, así no se corta un arrastre;
        # las apps van aparte y por diferencia (una app que empieza a sonar no toca las demás)
        key = (tuple((o["card"], o["port"], o["plugged"], o["sink"], o["active_port"]) for o in outputs), def_sink,
               tuple((s["name"], s["description"]) for s in sources), def_source)
        if key != self.layout_key:
            self.layout_key = key
            self.fill_outputs(outputs, def_sink)
            self.fill_devices(self.source_list, sources, def_source, "set-default-source", True)
        self.sync_apps(inputs)
        for i in inputs:
            card = self.app_cards.get(i["index"])
            if card:
                card.set(i["index"], volume(i), i.get("mute", False))

    def fill_outputs(self, outputs, default):
        lb = self.sink_list
        while (child := lb.get_first_child()) is not None:
            lb.remove(child)
        lb.set_visible(len(outputs) > 1)
        multi_card = len({o["card"] for o in outputs if o["card"]}) > 1
        for out in outputs:
            active = out["sink"] == default and (out["port"] is None or out["port"] == out["active_port"])
            row = Gtk.ListBoxRow()
            row.add_css_class("dev")
            if active:
                row.add_css_class("active")
            if not out["plugged"]:
                row.add_css_class("unplugged")
            box = Gtk.Box()
            icon = Gtk.Label(label=port_icon(out["port"] or out["label"]))
            icon.add_css_class("dev-icon")
            text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, hexpand=True, valign=Gtk.Align.CENTER)
            name = Gtk.Label(label=out["label"], xalign=0, ellipsize=3)
            name.add_css_class("dev-name")
            text.append(name)
            sub = [out["card_label"]] if multi_card and out["card_label"] else []
            if not out["plugged"]:
                sub.append("sin conectar")
            if sub:
                sl = Gtk.Label(label=" · ".join(sub), xalign=0, ellipsize=3)
                sl.add_css_class("dev-sub")
                text.append(sl)
            box.append(icon)
            box.append(text)
            if active:
                check = Gtk.Label(label="󰄬")
                check.add_css_class("check")
                box.append(check)
            row.set_child(box)
            row.activate_action = (lambda o=out: self.select_output(o))
            lb.append(row)

    def select_output(self, out):
        self.sink_list.set_sensitive(False)
        choose_output(out, lambda: self.sink_list.set_sensitive(True) or self.queue_refresh())

    def fill_devices(self, lb, devices, default, command, mic):
        while (child := lb.get_first_child()) is not None:
            lb.remove(child)
        lb.set_visible(len(devices) > 1)      # con un solo dispositivo no hay nada que elegir
        for dev in devices:
            active = dev["name"] == default
            row = Gtk.ListBoxRow()
            row.add_css_class("dev")
            if mic:
                row.add_css_class("mic")
            if active:
                row.add_css_class("active")
            box = Gtk.Box()
            icon = Gtk.Label(label="󰍬" if mic else port_icon(dev["name"]))
            icon.add_css_class("dev-icon")
            name = Gtk.Label(label=dev.get("description") or dev["name"], xalign=0, hexpand=True, ellipsize=3)
            name.add_css_class("dev-name")
            box.append(icon)
            box.append(name)
            if active:
                check = Gtk.Label(label="󰄬")
                check.add_css_class("check")
                box.append(check)
            row.set_child(box)
            row.activate_action = (lambda n=dev["name"]: pactl(command, n))
            lb.append(row)

    def sync_apps(self, inputs):
        """Quita las tarjetas de apps que dejaron de sonar y añade las nuevas; las demás no se tocan."""
        alive = {i["index"] for i in inputs}
        for idx in [k for k in self.app_cards if k not in alive]:
            self.apps_box.remove(self.app_cards.pop(idx).box)
        self.apps_empty.set_visible(not inputs)
        self.apps_scroller.set_visible(bool(inputs))   # vacío, el scroller igual reserva alto
        theme = Gtk.IconTheme.get_for_display(Gdk.Display.get_default())
        for i in inputs:
            if i["index"] in self.app_cards:
                continue
            props = i.get("properties", {})
            app = props.get("application.name") or props.get("application.process.binary") or "Aplicación"
            media = props.get("media.name", "")
            icon_name = props.get("application.icon_name") or props.get("application.process.binary", "").lower()
            if not theme.has_icon(icon_name):
                icon_name = "audio-x-generic"
            img = Gtk.Image.new_from_icon_name(icon_name)
            img.set_pixel_size(18)
            img.add_css_class("app-icon")
            nl = Gtk.Label(label=app, xalign=0, ellipsize=3, max_width_chars=12,
                           tooltip_text=f"{app} · {media}" if media and media != app else app)
            nl.add_css_class("app-name")
            card = VolumeCard("sink-input", "󰕾", "󰝟", "app", lead=[img, nl])
            self.app_cards[i["index"]] = card
            self.apps_box.append(card.box)

    def toggle(self):
        self.hide() if self.win.get_visible() else self.show()

    def show(self):
        self.win.present()               # primero se muestra (ya está al día), luego se confirma
        self.queue_refresh()

    def hide(self):
        self.sub.force_exit()    # el pactl subscribe no debe sobrevivir al panel
        self.app.quit()          # Esc, Super+C u otro clic: se cierra, no queda oculto

    def close(self):
        self.hide()
        return True


def main():
    zen_panel.run("pe.zen.Audio", "zen-audio", Panel)

if __name__ == "__main__":
    main()
