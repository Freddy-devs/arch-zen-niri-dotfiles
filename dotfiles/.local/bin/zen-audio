scale highlight { background: #7aa2f7; border-radius: 6px; }
.card.mic scale highlight { background: #bb9af7; }
.card.muted scale highlight { background: #3b4261; }
scale slider {
    background: #f1f1f1; border-radius: 50%; min-width: 14px; min-height: 14px;
    margin: -5px; border: none; box-shadow: none;
}
