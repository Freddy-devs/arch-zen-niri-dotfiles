#!/usr/bin/env python3
"""zen-audio — panel de sonido debajo de la barra (mismo estilo que zen-bluetooth y zen-calendar).

Clic en el volumen de waybar lo abre; otro clic (o Esc) lo cierra.
Volumen y silencio de la salida y del micrófono, elegir el dispositivo de cada uno
y el volumen de cada aplicación. Habla con PipeWire a través de pactl.
"""
import json
import os
import subprocess
import sys
import threading
import time
import traceback

# lo común de los paneles vive en zen_panel.py, junto al script real (~/.local/bin o el repo)
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import zen_panel  # noqa: E402

zen_panel.preload_layer_shell()     # re-exec con gtk4-layer-shell, antes de importar Gtk

import gi  # noqa: E402

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
from gi.repository import Gdk, Gio, GLib, Gtk  # noqa: E402

MAX_VOL = 150   # como pavucontrol: permite subir sobre 100 %

