#!/usr/bin/env python3
"""zen-audio — panel de sonido debajo de la barra (mismo estilo que zen-bluetooth y zen-calendar).

Clic en el volumen de waybar lo abre; otro clic (o Esc) lo cierra.
Volumen y silencio de la salida y del micrófono, elegir el dispositivo de cada uno
y el volumen de cada aplicación. Habla con PipeWire a través de pactl.
"""
import json
import os
import subprocess
import sys
import time

# gtk4-layer-shell debe cargarse antes que libwayland; en Python solo se logra con LD_PRELOAD
LAYER_LIB = "/usr/lib/libgtk4-layer-shell.so"
if LAYER_LIB not in os.environ.get("LD_PRELOAD", ""):
    os.environ["LD_PRELOAD"] = ":".join(filter(None, [LAYER_LIB, os.environ.get("LD_PRELOAD")]))
    os.execv(sys.executable, [sys.executable] + sys.argv)

import gi  # noqa: E402

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
gi.require_version("Gtk4LayerShell", "1.0")
from gi.repository import Gdk, Gio, GLib, Gtk, Gtk4LayerShell as Layer  # noqa: E402

MAX_VOL = 150   # como pavucontrol: permite subir sobre 100 %

CSS = """
window.zen-audio { background: transparent; }
.panel {
    background: #1a1b26; border-radius: 14px; padding: 14px;
    color: #c0caf5; font-family: Inter, sans-serif; font-size: 13px;
}
