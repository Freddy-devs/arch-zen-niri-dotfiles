#!/bin/sh
# zen-lock — bloquea la pantalla con zen-locker: el escritorio visible tras un velo translúcido,
# anillo con la hora y el texto en tu idioma, y visualizador de música alrededor del anillo.
# Lo usan swayidle (inactividad y antes de suspender) y Super+Alt+L.
#
# Respaldo: si zen-locker no logra bloquear o se cae, entra swaylock (nunca se queda sin bloquear).
# Termina recién cuando la pantalla ya está bloqueada (swayidle -w espera esto antes de suspender).

pgrep -f '/zen-locker$' >/dev/null && exit 0
pgrep -x swaylock >/dev/null && exit 0

dir="${XDG_RUNTIME_DIR:?}/zen-lock"
rm -f "$dir/locked"

setsid -f sh -c '"$HOME/.local/bin/zen-locker" || swaylock -f' >/dev/null 2>&1

i=0
while [ $i -lt 60 ]; do
    [ -e "$dir/locked" ] && exit 0
    pgrep -x swaylock >/dev/null && exit 0
    sleep 0.1
    i=$((i + 1))
done
exit 0
