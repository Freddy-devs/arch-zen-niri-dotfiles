// fastfetch — diseño Nord (niri + alacritty); "neofetch" es un alias
// Los colores son nombres de la paleta del terminal (blue, magenta...), así que
// siguen la paleta de alacritty. Iconos: JetBrainsMono Nerd Font.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "arch",
    "color": { "1": "blue", "2": "magenta" },
    "padding": { "top": 1, "left": 2, "right": 5 }
  },
  "display": {
    "separator": "  ",
    "key": { "width": 14 },
    "color": { "keys": "blue", "title": "magenta", "separator": "bright_black" },
    "bar": { "border": { "left": "", "right": "" }, "char": { "elapsed": "━", "total": "━" }, "width": 14 },
    "percent": { "type": 3 },
    "size": { "ndigits": 1 }
  },
  "modules": [
    "break",
    { "type": "title", "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}", "color": { "user": "magenta", "at": "bright_black", "host": "blue" } },
    { "type": "custom", "format": "{#bright_black}────────────────────────────────────" },

    { "type": "os",        "key": "󰣇  OS",        "format": "{name} {arch}" },
    { "type": "host",      "key": "󰌢  Host" },
    { "type": "kernel",    "key": "  Kernel",    "format": "{release}" },
    { "type": "uptime",    "key": "󰅐  Uptime" },
    { "type": "packages",  "key": "󰏖  Packages" },
    { "type": "shell",     "key": "  Shell" },

    "break",
    { "type": "display",   "key": "󰍹  Display",   "format": "{width}x{height} @ {refresh-rate}Hz" },
    { "type": "wm",        "key": "  WM" },
    { "type": "theme",     "key": "󰉼  Theme",     "format": "{theme2}" },
    { "type": "icons",     "key": "󰀻  Icons",     "format": "{icons2}" },
    { "type": "cursor",    "key": "󰇀  Cursor" },
    { "type": "terminal",  "key": "  Terminal" },
    { "type": "terminalfont", "key": "  Font" },

    "break",
    { "type": "cpu",       "key": "  CPU",       "format": "{name} ({cores-logical}) @ {freq-max}", "temp": true },
    { "type": "gpu",       "key": "󰢮  GPU",       "format": "{name}" },
    { "type": "memory",    "key": "󰑭  Memory" },
    { "type": "swap",      "key": "󰓡  Zram" },
    { "type": "disk",      "key": "󰋊  Disk",      "folders": "/" },
    { "type": "localip",   "key": "󰩟  Local IP",  "showIpv6": false, "compact": true },

    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}
