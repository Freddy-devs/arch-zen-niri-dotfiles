// Waybar — arch-zen-niri: barra de vidrio translúcido (desenfoque de niri) con borde suave y
// esquinas de 8 px; dentro, una "isla" redondeada por grupo (Nord).
// Izquierda: logo + CPU, RAM y disco · Centro: escritorios estilo Pac-Man
// Derecha: conexiones, controles, bandeja, la hora (clic = calendario), idioma y energía al final.
// Sale en todas las pantallas; los escritorios son los de cada pantalla.
{
    "layer": "top",
    "position": "top",
    "height": 40,
    "spacing": 0,
    "margin-top": 6,
    "margin-bottom": 2,
    "margin-left": 10,
    "margin-right": 10,
    "reload_style_on_change": true,

    "modules-left": ["custom/arch", "group/stats"],
    "modules-center": ["niri/workspaces"],
    "modules-right": ["group/bt", "group/netbat", "group/controls", "custom/updates", "tray", "clock", "niri/language", "custom/power"],

    // logo: abre el lanzador (igual que Super+Space)
    "custom/arch": {
        "format": "󰣇",
        "tooltip-format": "Aplicaciones  (Super+Space)",
        "on-click": "rofi -show drun"
    },

    // escritorios estilo Pac-Man: 󰮯 actual · 󰊠 con ventanas (fantasmas de colores)
    // · 󰝥 vacío (bolitas) · fantasma azul parpadeando = pide atención
    "niri/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "urgent": "󰊠",
            "focused": "󰮯",
            "active": "󰮯",
            "empty": "󰝥",
            "default": "󰊠"
        }
    },

    // clic: abre/cierra el calendario (feriados del Perú, agenda y alarmas).
    // Sin "format-alt" ni "mode": el clic nunca cambia lo que muestra el reloj.
    "clock": {
        "format": "<span color='#b48ead'>󰥔</span>  {:%I:%M %p}",
        "tooltip-format": "{:%A %d de %B de %Y}",
        "on-click": "zen-calendar"
    },

    // ---------- sistema ----------
    "group/stats": {
        "orientation": "horizontal",
        "modules": ["cpu", "custom/gpu", "memory", "disk"]
    },

    "cpu": {
        "format": "<span color='#bf616a' size='large' rise='-1pt'>󰍛</span>  {usage}%",
        "interval": 2,
        "states": { "high": 80 },
        "on-click": "~/.local/bin/zen-term -e btop"
    },

    // uso de la gráfica Intel (motor más ocupado: dibujo o video); la NVIDIA va apagada
    "custom/gpu": {
        "exec": "~/.local/bin/zen-gpu",
        "return-type": "json",
        "on-click": "~/.local/bin/zen-term -e btop"
    },

    "memory": {
        "format": "<span color='#8fbcbb' rise='0pt'></span>  {used:0.1f} GiB",
        "interval": 3,
        "states": { "high": 85 },
        "tooltip-format": "{used:0.2f} / {total:0.2f} GiB · swap {swapUsed:0.2f} GiB",
        "on-click": "~/.local/bin/zen-term -e btop"
    },

    "disk": {
        "format": "<span color='#ebcb8b' rise='0pt'>󰟜</span>  {percentage_used}%",
        "path": "/",
        "interval": 60,
        "tooltip-format": "{used} usados de {total} · libre {free}",
        "on-click": "~/.local/bin/zen-term --class zen-tui -e sh -c 'df -h -x tmpfs -x devtmpfs; read -p \"Enter para cerrar\" _'"
    },

    // ---------- conexiones ----------
    // ---------- Bluetooth: icono, batería de cada dispositivo y reproductor ----------
    "group/bt": {
        "orientation": "horizontal",
        "modules": ["bluetooth", "custom/btbattery", "custom/media"]
    },

    // ---------- red y batería de la laptop ----------
    "group/netbat": {
        "orientation": "horizontal",
        "modules": ["network", "battery"]
    },

    // reproductor: abre zen-media (mini ventana abajo al centro) con lo que suene en Brave, Spotify, VLC…
    "custom/media": {
        "exec": "~/.local/bin/zen-media --waybar",
        "return-type": "json",
        "restart-interval": 5,
        "on-click": "~/.local/bin/zen-toggle media",
        "on-click-right": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-connected": "󰂱",
        "format-connected-battery": "󰂱",
        "tooltip-format": "{controller_alias} · {status}",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias} · {device_battery_percentage}%",
        "on-click": "~/.local/bin/zen-toggle bluetooth",
        "on-click-right": "~/.local/bin/zen-term --class zen-tui -e bluetui"
    },

    // batería de cada dispositivo Bluetooth conectado (mouse, audífonos…); se oculta si no hay ninguno
    "custom/btbattery": {
        "exec": "~/.local/bin/zen-bt-battery",
        "return-type": "json",
        "escape": false,
        "restart-interval": 5,
        "on-click": "~/.local/bin/zen-toggle bluetooth"
    },

    "network": {
        "interval": 3,
        "format-wifi": "<span color='#a3be8c'>󰖩</span> {bandwidthTotalBytes}",
        "format-ethernet": "<span color='#a3be8c'>󰈀</span> {bandwidthTotalBytes}",
        "format-disconnected": "󰖪 Sin red",
        "tooltip-format-wifi": "{essid} ({signalStrength}%) · {ipaddr}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}\nClic: redes Wi-Fi · clic derecho: avanzado (nmtui)",
        "tooltip-format-ethernet": "{ifname} · {ipaddr}/{cidr}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}\nClic: redes Wi-Fi · clic derecho: avanzado (nmtui)",
        "on-click": "~/.local/bin/zen-toggle network",
        "on-click-right": "~/.local/bin/zen-term --class zen-tui -e nmtui"
    },

    "battery": {
        "full-at": 99,
        "states": { "warning": 25, "critical": 10 },
        // batería horizontal (se llena de izquierda a derecha); rayo = cargando, enchufe = conectado y llena
        "format": "<span color='#88c0d0'>{icon}</span> {capacity}%",
        "format-charging": "<span color='#a3be8c'>{icon} 󱐋</span> {capacity}%",
        "format-plugged": "<span color='#a3be8c'>{icon} </span> {capacity}%",
        "format-not-charging": "<span color='#a3be8c'>{icon} </span> {capacity}%",
        "format-full": "<span color='#a3be8c'>{icon} </span> {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "Batería · {timeTo}",
        "tooltip-format-charging": "Cargando · {timeTo}",
        "tooltip-format-plugged": "Cargador conectado · batería en reposo (rango 60–90 %)",
        "tooltip-format-not-charging": "Cargador conectado · batería en reposo (rango 60–90 %)",
        "tooltip-format-full": "Cargador conectado · batería llena"
    },

    // ---------- controles ----------
    "group/controls": {
        "orientation": "horizontal",
        "modules": ["pulseaudio", "backlight"]
    },

    "pulseaudio": {
        "format": "<span color='#88c0d0'>{icon}</span> {volume}%",
        "format-muted": "󰝟 Mudo",
        "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
        "scroll-step": 5,
        "on-click": "~/.local/bin/zen-toggle audio",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    "backlight": {
        "format": "<span color='#ebcb8b'>󰖨</span> {percent}%",
        "tooltip-format": "Brillo {percent}% · clic: brillo de cada pantalla",
        "on-click": "~/.local/bin/zen-toggle brightness",
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%- -n 1%"
    },

    "custom/updates": {
        "format": "<span color='#a3be8c'>󰚰</span> {}",
        "exec": "command -v checkupdates >/dev/null && checkupdates 2>/dev/null | wc -l",
        "exec-if": "command -v checkupdates",
        "interval": 1800,
        "tooltip-format": "{} actualizaciones · clic para actualizar",
        "on-click": "~/.local/bin/zen-term -e sh -c 'sudo pacman -Syu; read -rp \"Enter para cerrar\" _'"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 10
    },

    // idioma del teclado: latam (por defecto) / inglés. Clic o Super+Alt+Space = alternar
    "niri/language": {
        "format": "<span color='#8fbcbb'>󰌌</span> {short}",
        "tooltip-format": "{long} · clic o Super+Alt+Space para cambiar",
        "on-click": "niri msg action switch-layout next"
    },

    "custom/power": {
        "format": "󰐥",
        "tooltip-format": "Apagar · reiniciar · cerrar sesión  (Super+Shift+C)",
        "on-click": "zen-power"
    }
}
