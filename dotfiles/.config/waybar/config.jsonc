// Waybar — arch-zen-niri: barra de "islas" flotantes (TokyoNight)
// Izquierda: logo + escritorios + barra de tareas (iconos de las apps abiertas)
// Centro: reloj · Derecha: sistema, conexiones, controles, bandeja y energía.
// Sale en todas las pantallas; escritorios y tareas son los de cada pantalla.
{
    "layer": "top",
    "position": "top",
    "height": 36,
    "spacing": 0,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    "reload_style_on_change": true,

    "modules-left": ["custom/arch", "niri/workspaces", "wlr/taskbar"],
    "modules-center": ["clock"],
    "modules-right": ["group/stats", "group/netbat", "group/controls", "custom/updates", "tray", "niri/language", "custom/power"],

    // logo: abre el lanzador (igual que Super+Space)
    "custom/arch": {
        "format": "󰣇",
        "tooltip-format": "Aplicaciones  (Super+Space)",
        "on-click": "rofi -show drun"
    },

    // escritorios: píldora ancha = actual · punto = con ventanas · anillo = vacío
    "niri/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "urgent": "󰀨",
            "empty": "",
            "focused": "",
            "active": "",
            "default": ""
        }
    },

    // barra de tareas: iconos de las apps abiertas en esta pantalla
    // clic = enfocar · clic central = cerrar
    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 20,
        "icon-theme": "Papirus-Dark",
        "all-outputs": false,
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close",
        "ignore-list": ["zen-calendar"],
        "app_ids-mapping": {
            "zen-tui": "utilities-terminal",
            "zen-installer": "system-software-install"
        }
    },

    // clic: calendario (feriados del Perú, agenda y alarmas)
    "clock": {
        "format": "<span color='#bb9af7'></span>  {:%I:%M %p}",
        "format-alt": "<span color='#bb9af7'></span>  {:%a %d %b · %I:%M %p}",
        "tooltip-format": "{:%A %d de %B de %Y}",
        "on-click": "zen-calendar",
        "on-click-right": "mode"
    },

    // ---------- sistema ----------
    "group/stats": {
        "orientation": "horizontal",
        "modules": ["cpu", "memory", "disk"]
    },

    "cpu": {
        "format": "<span color='#f7768e'>\uf4bc</span> {usage}%",
        "interval": 2,
        "states": { "high": 80 },
        "on-click": "alacritty -e btop"
    },

    "memory": {
        "format": "<span color='#7dcfff'>\uf2db</span> {used:0.1f}G",
        "interval": 3,
        "states": { "high": 85 },
        "tooltip-format": "{used:0.2f} / {total:0.2f} GiB · swap {swapUsed:0.2f} GiB",
        "on-click": "alacritty -e btop"
    },

    "disk": {
        "format": "<span color='#e0af68'>\uf0a0</span> {percentage_used}%",
        "path": "/",
        "interval": 60,
        "tooltip-format": "{used} usados de {total} · libre {free}"
    },

    // ---------- conexiones ----------
    "group/netbat": {
        "orientation": "horizontal",
        "modules": ["bluetooth", "network", "battery"]
    },

    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-connected": "󰂱",
        "format-connected-battery": "󰂱 {device_battery_percentage}%",
        "tooltip-format": "{controller_alias} · {status}",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias} · {device_battery_percentage}%",
        "on-click": "alacritty --class zen-tui -e bluetui"
    },

    "network": {
        "interval": 3,
        "format-wifi": "<span color='#9ece6a'>󰖩</span> {bandwidthTotalBytes}",
        "format-ethernet": "<span color='#9ece6a'>󰈀</span> {bandwidthTotalBytes}",
        "format-disconnected": "󰖪 Sin red",
        "tooltip-format-wifi": "{essid} ({signalStrength}%) · {ipaddr}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
        "tooltip-format-ethernet": "{ifname} · {ipaddr}/{cidr}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
        "on-click": "alacritty --class zen-tui -e nmtui"
    },

    "battery": {
        "full-at": 99,
        "states": { "warning": 25, "critical": 10 },
        "format": "<span color='#7aa2f7'>{icon}</span> {capacity}%",
        "format-charging": "<span color='#9ece6a'>󰂄</span> {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
        "tooltip-format": "{timeTo}"
    },

    // ---------- controles ----------
    "group/controls": {
        "orientation": "horizontal",
        "modules": ["pulseaudio", "backlight"]
    },

    "pulseaudio": {
        "format": "<span color='#7aa2f7'>{icon}</span> {volume}%",
        "format-muted": "󰝟 Mudo",
        "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
        "scroll-step": 5,
        "on-click": "alacritty --class zen-tui -e wiremix",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    "backlight": {
        "format": "<span color='#e0af68'>󰖨</span> {percent}%",
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-"
    },

    "custom/updates": {
        "format": "<span color='#9ece6a'>󰚰</span> {}",
        "exec": "command -v checkupdates >/dev/null && checkupdates 2>/dev/null | wc -l",
        "exec-if": "command -v checkupdates",
        "interval": 1800,
        "tooltip-format": "{} actualizaciones · clic para actualizar",
        "on-click": "alacritty -e sh -c 'sudo pacman -Syu; read -rp \"Enter para cerrar\" _'"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 10
    },

    "niri/language": {
        "format": "<span color='#7dcfff'>󰌌</span> {short}",
        "on-click": "niri msg action switch-layout next"
    },

    "custom/power": {
        "format": "󰐥",
        "tooltip-format": "Apagar · reiniciar · cerrar sesión  (Super+Shift+C)",
        "on-click": "zen-power"
    }
}
