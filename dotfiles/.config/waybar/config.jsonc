// Waybar — arch-zen-niri: barra de vidrio translúcido (desenfoque de niri) con borde suave y
// esquinas de 8 px; dentro, una "isla" redondeada por grupo (TokyoNight).
// Izquierda: logo + CPU, RAM y disco · Centro: escritorios estilo Pac-Man
// Derecha: conexiones, controles, bandeja, la hora (clic = calendario) y energía al final.
// Sale en todas las pantallas; los escritorios son los de cada pantalla.
{
    "layer": "top",
    "position": "top",
    "height": 40,
    "spacing": 0,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    "reload_style_on_change": true,

    "modules-left": ["custom/arch", "group/stats"],
    "modules-center": ["niri/workspaces"],
    "modules-right": ["group/netbat", "group/controls", "custom/updates", "tray", "niri/language", "clock", "custom/power"],

    // logo: abre el lanzador (igual que Super+Space)
    "custom/arch": {
        "format": "󰣇",
        "tooltip-format": "Aplicaciones  (Super+Space)",
        "on-click": "rofi -show drun"
    },

    // escritorios estilo Pac-Man: 󰮯 actual · 󰊠 con ventanas (fantasmas de colores)
    // · 󰝥 vacío (bolitas) · fantasma azul parpadeando = pide atención
    "niri/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "urgent": "󰊠",
            "focused": "󰮯",
            "active": "󰮯",
            "empty": "󰝥",
            "default": "󰊠"
        }
    },

    // clic: abre/cierra el calendario (feriados del Perú, agenda y alarmas).
    // Sin "format-alt" ni "mode": el clic nunca cambia lo que muestra el reloj.
    "clock": {
        "format": "<span color='#bb9af7'>󰥔</span>  {:%I:%M %p}",
        "tooltip-format": "{:%A %d de %B de %Y}",
        "on-click": "zen-calendar"
    },

    // ---------- sistema ----------
    "group/stats": {
        "orientation": "horizontal",
        "modules": ["cpu", "memory", "disk"]
    },

    "cpu": {
        "format": "<span color='#f7768e' size='large' rise='-1pt'>󰻠</span>  {usage}%",
        "interval": 2,
        "states": { "high": 80 },
        "on-click": "alacritty -e btop"
    },

    "memory": {
        "format": "<span color='#7dcfff' size='large' rise='-1pt'>󰍛</span>  {used:0.1f} GiB",
        "interval": 3,
        "states": { "high": 85 },
        "tooltip-format": "{used:0.2f} / {total:0.2f} GiB · swap {swapUsed:0.2f} GiB",
        "on-click": "alacritty -e btop"
    },

    "disk": {
        "format": "<span color='#e0af68' size='large' rise='-1pt'>󰋊</span>  {percentage_used}%",
        "path": "/",
        "interval": 60,
        "tooltip-format": "{used} usados de {total} · libre {free}",
        "on-click": "alacritty --class zen-tui -e sh -c 'df -h -x tmpfs -x devtmpfs; read -p \"Enter para cerrar\" _'"
    },

    // ---------- conexiones ----------
    "group/netbat": {
        "orientation": "horizontal",
        "modules": ["bluetooth", "network", "battery"]
    },

    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-connected": "󰂱",
        "format-connected-battery": "󰂱 {device_battery_percentage}%",
        "tooltip-format": "{controller_alias} · {status}",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias} · {device_battery_percentage}%",
        "on-click": "~/.local/bin/zen-bluetooth",
        "on-click-right": "alacritty --class zen-tui -e bluetui"
    },

    "network": {
        "interval": 3,
        "format-wifi": "<span color='#9ece6a'>󰖩</span> {bandwidthTotalBytes}",
        "format-ethernet": "<span color='#9ece6a'>󰈀</span> {bandwidthTotalBytes}",
        "format-disconnected": "󰖪 Sin red",
        "tooltip-format-wifi": "{essid} ({signalStrength}%) · {ipaddr}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
        "tooltip-format-ethernet": "{ifname} · {ipaddr}/{cidr}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
        "on-click": "alacritty --class zen-tui -e nmtui"
    },

    "battery": {
        "full-at": 99,
        "states": { "warning": 25, "critical": 10 },
        "format": "<span color='#7aa2f7'>{icon}</span> {capacity}%",
        "format-charging": "<span color='#9ece6a'>󰂄</span> {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
        "tooltip-format": "{timeTo}"
    },

    // ---------- controles ----------
    "group/controls": {
        "orientation": "horizontal",
        "modules": ["pulseaudio", "backlight"]
    },

    "pulseaudio": {
        "format": "<span color='#7aa2f7'>{icon}</span> {volume}%",
        "format-muted": "󰝟 Mudo",
        "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
        "scroll-step": 5,
        "on-click": "alacritty --class zen-tui -e wiremix",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    "backlight": {
        "format": "<span color='#e0af68'>󰖨</span> {percent}%",
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-"
    },

    "custom/updates": {
        "format": "<span color='#9ece6a'>󰚰</span> {}",
        "exec": "command -v checkupdates >/dev/null && checkupdates 2>/dev/null | wc -l",
        "exec-if": "command -v checkupdates",
        "interval": 1800,
        "tooltip-format": "{} actualizaciones · clic para actualizar",
        "on-click": "alacritty -e sh -c 'sudo pacman -Syu; read -rp \"Enter para cerrar\" _'"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 10
    },

    "niri/language": {
        "format": "<span color='#7dcfff'>󰌌</span> {short}",
        "on-click": "niri msg action switch-layout next"
    },

    "custom/power": {
        "format": "󰐥",
        "tooltip-format": "Apagar · reiniciar · cerrar sesión  (Super+Shift+C)",
        "on-click": "zen-power"
    }
}
