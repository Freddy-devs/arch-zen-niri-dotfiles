// Waybar — arch-zen-niri: barra flotante fina con módulos en píldoras
// Sale en todas las pantallas; los escritorios son los de cada pantalla.
{
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 4,
    "margin-top": 4,
    "margin-left": 4,
    "margin-right": 4,

    "modules-left": ["custom/arch", "custom/dots", "cpu", "memory", "disk"],
    "modules-center": ["niri/workspaces"],
    "modules-right": ["bluetooth", "group/netbat", "pulseaudio", "backlight", "custom/updates", "clock", "tray", "niri/language", "custom/power"],

    // solo el logo: sin lanzador de apps
    "custom/arch": {
        "format": "󰣇",
        "tooltip": false
    },

    "custom/dots": {
        "format": "󰇙",
        "tooltip": false
    },

    "cpu": {
        "format": "<span color='#f7768e'></span> {usage}%",
        "interval": 2,
        "on-click": "alacritty -e btop"
    },

    "memory": {
        "format": "<span color='#7dcfff'></span> {used:0.2f} GiB",
        "interval": 3,
        "tooltip-format": "{used:0.2f} / {total:0.2f} GiB · swap {swapUsed:0.2f} GiB",
        "on-click": "alacritty -e btop"
    },

    "disk": {
        "format": "<span color='#fbc02d'></span> {used}",
        "path": "/",
        "interval": 60,
        "tooltip-format": "{used} usados de {total} · libre {free}"
    },

    "niri/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "urgent": "󰀨",
            "empty": "󰑊",
            "focused": "󰮯",
            "active": "󰮯",
            "default": "󰊠"
        }
    },

    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-connected": "󰂱",
        "format-connected-battery": "󰂱 <span color='#f1f1f1'>{device_battery_percentage}%</span>",
        "tooltip-format": "{controller_alias} · {status}",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias} · {device_battery_percentage}%",
        "on-click": "alacritty --class zen-tui -e bluetui"
    },

    "group/netbat": {
        "orientation": "horizontal",
        "modules": ["network", "battery"]
    },

    "network": {
        "interval": 3,
        "format-wifi": "<span color='#9ece6a'>󰖩</span> <span color='#e0af68'>{bandwidthTotalBytes}</span>",
        "format-ethernet": "<span color='#9ece6a'>󰈀</span> <span color='#e0af68'>{bandwidthTotalBytes}</span>",
        "format-disconnected": "󰖪 Offline",
        "tooltip-format-wifi": "{essid} ({signalStrength}%) · {ipaddr}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
        "tooltip-format-ethernet": "{ifname} · {ipaddr}/{cidr}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
        "on-click": "alacritty --class zen-tui -e nmtui"
    },

    "battery": {
        "full-at": 99,
        "states": { "warning": 25, "critical": 10 },
        "format": "<span color='#7aa2f7'>{icon}</span> {capacity}%",
        "format-charging": "<span color='#9ece6a'>󰂄</span> {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
        "tooltip-format": "{timeTo}"
    },

    "pulseaudio": {
        "format": "<span color='#6c77bb'>{icon}</span> {volume}",
        "format-muted": "󰝟 Muted",
        "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
        "on-click": "alacritty --class zen-tui -e wiremix",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    "backlight": {
        "format": "<span color='#e0af68'>󰖨</span> {percent}%",
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-"
    },

    "custom/updates": {
        "format": "<span color='#b9c244'>󰚰</span> {}",
        "exec": "command -v checkupdates >/dev/null && checkupdates 2>/dev/null | wc -l",
        "exec-if": "command -v checkupdates",
        "interval": 1800,
        "tooltip-format": "{} actualizaciones · clic para actualizar",
        "on-click": "alacritty -e sh -c 'sudo pacman -Syu; read -rp \"Enter para cerrar\" _'"
    },

    // clic: calendario (feriados del Perú, agenda y alarmas)
    "clock": {
        "format": "{:%I:%M %p}",
        "tooltip-format": "{:%A %d de %B de %Y}",
        "on-click": "zen-calendar"
    },

    "tray": {
        "icon-size": 14,
        "spacing": 8
    },

    "niri/language": {
        "format": "<span color='#7dcfff'>󰌌</span> {short}",
        "on-click": "niri msg action switch-layout next"
    },

    "custom/power": {
        "format": "󰐥",
        "tooltip-format": "Apagar · reiniciar · cerrar sesión  (Super+Shift+C)",
        "on-click": "zen-power"
    }
}
