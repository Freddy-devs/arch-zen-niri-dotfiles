/* rofi — lanzador de aplicaciones · TokyoNight (misma paleta que la barra)
 * Super+Space / Super+D / logo de Arch en waybar
 * Cabecera con imagen (banner.png, generada por system/art/rofi-banner.py) y el buscador encima;
 * lista de dos columnas: icono, nombre y descripción. Solo colores planos, sin degradados. */

configuration {
    modi:                 "drun";
    show-icons:           true;
    icon-theme:           "Nordzy-dark";
    drun-display-format:  "{name}\n[<span size='small' alpha='60%'>{generic}</span>]";
    display-drun:         "";
    matching:             "fuzzy";
    /* sin historial: la lista sale en orden alfabético; al escribir, ordena por coincidencia */
    disable-history:      true;
    sort:                 true;
    sorting-method:       "fzf";
    case-sensitive:       false;
    drun-match-fields:    "name,generic,exec,categories,keywords";
    scroll-method:        0;
    hover-select:         true;
    kb-cancel:            "Escape,Super+space";
}

* {
    base:      #1a1b26;
    mantle:    #16161e;
    surface0:  #24283b;
    surface1:  #3b4261;
    overlay0:  #565f89;
    text:      #c0caf5;
    subtext:   #a9b1d6;
    blue:      #7aa2f7;
    purple:    #bb9af7;
    cyan:      #7dcfff;

    font:             "Inter 11";
    background-color: transparent;
    text-color:       @text;
    margin:           0;
    padding:          0;
    spacing:          0;
}

window {
    location:         center;
    anchor:           center;
    width:            600px;
    border:           1px;
    border-color:     #7aa2f759;
    border-radius:    14px;
    background-color: @base;
}

mainbox {
    padding:  16px;
    spacing:  14px;
    children: [ "header", "message", "listview" ];
}

/* ---------- cabecera: imagen hacker con el buscador encima ---------- */
header {
    orientation:      vertical;
    expand:           false;
    padding:          76px 10px 10px 10px;
    border-radius:    10px;
    border:           1px;
    border-color:     #7aa2f726;
    background-image: url("~/.config/rofi/banner.png", width);
    children:         [ "inputbar" ];
}

inputbar {
    padding:          9px 14px;
    spacing:          10px;
    border-radius:    10px;
    border:           1px;
    border-color:     #7aa2f740;
    background-color: #16161ee6;
    children:         [ "textbox-search", "entry", "num-filtered-rows" ];
}

textbox-search {
    expand:     false;
    str:        "";
    font:       "Symbols Nerd Font 13";
    text-color: @purple;
    vertical-align: 0.5;
}

entry {
    placeholder:       "Buscar aplicaciones…";
    placeholder-color: @overlay0;
    cursor:            text;
    vertical-align:    0.5;
    font:              "Inter 12";
    text-color:        @text;
}

num-filtered-rows {
    expand:     false;
    text-color: @overlay0;
    vertical-align: 0.5;
}

message {
    padding:          10px 16px;
    border-radius:    12px;
    background-color: @surface0;
}

textbox {
    text-color: @subtext;
}

/* ---------- lista de apps en dos columnas ---------- */
listview {
    columns:       2;
    lines:         6;
    spacing:       4px 8px;
    cycle:         true;
    dynamic:       true;
    fixed-height:  false;
    fixed-columns: true;
    flow:          horizontal;
    scrollbar:     false;
}

element {
    orientation:   horizontal;
    padding:       7px 10px;
    spacing:       10px;
    border-radius: 9px;
    border:        1px;
    border-color:  transparent;
    cursor:        pointer;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
}

element selected.normal {
    background-color: @surface0;
    border-color:     #7aa2f766;
}

element-icon {
    size:           32px;
    cursor:         inherit;
    vertical-align: 0.5;
}

element-text {
    highlight:        bold #bb9af7;
    horizontal-align: 0;
    vertical-align:   0.5;
    text-color:       @subtext;
    cursor:           inherit;
}

element selected.normal element-text {
    text-color: @text;
}
