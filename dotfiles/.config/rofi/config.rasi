/* rofi — lanzador de aplicaciones · TokyoNight (misma paleta que la barra)
 * Super+Space / Super+D / logo de Arch en waybar
 * Lista de dos columnas: icono, nombre y descripción; búsqueda difusa en todas las apps. */

configuration {
    modi:                 "drun";
    show-icons:           true;
    icon-theme:           "Papirus-Dark";
    drun-display-format:  "{name}\n[<span size='small' alpha='60%'>{generic}</span>]";
    display-drun:         "";
    matching:             "fuzzy";
    sort:                 true;
    sorting-method:       "fzf";
    case-sensitive:       false;
    drun-match-fields:    "name,generic,exec,categories,keywords";
    scroll-method:        0;
    hover-select:         true;
    kb-cancel:            "Escape,Super+space";
}

* {
    base:      #1a1b26f2;
    mantle:    #16161e;
    surface0:  #24283b;
    surface1:  #3b4261;
    overlay0:  #565f89;
    text:      #c0caf5;
    subtext:   #a9b1d6;
    blue:      #7aa2f7;
    purple:    #bb9af7;
    cyan:      #7dcfff;

    font:             "Inter 12";
    background-color: transparent;
    text-color:       @text;
    margin:           0;
    padding:          0;
    spacing:          0;
}

window {
    location:         center;
    anchor:           center;
    width:            860px;
    border:           1px;
    border-color:     #7aa2f759;
    border-radius:    22px;
    background-color: @base;
}

mainbox {
    padding:  28px;
    spacing:  22px;
    children: [ "inputbar", "message", "listview" ];
}

/* ---------- buscador al centro ---------- */
inputbar {
    padding:          14px 20px;
    spacing:          14px;
    border-radius:    16px;
    border:           0;
    background-image: linear-gradient(to right, #7aa2f726, #bb9af733);
    background-color: @mantle;
    children:         [ "textbox-search", "entry", "num-filtered-rows" ];
}

textbox-search {
    expand:     false;
    str:        "";
    font:       "Symbols Nerd Font 16";
    text-color: @purple;
    vertical-align: 0.5;
}

entry {
    placeholder:       "Buscar aplicaciones…";
    placeholder-color: @overlay0;
    cursor:            text;
    vertical-align:    0.5;
    font:              "Inter 14";
    text-color:        @text;
}

num-filtered-rows {
    expand:     false;
    text-color: @overlay0;
    vertical-align: 0.5;
}

message {
    padding:          10px 16px;
    border-radius:    12px;
    background-color: @surface0;
}

textbox {
    text-color: @subtext;
}

/* ---------- lista de apps en dos columnas ---------- */
listview {
    columns:       2;
    lines:         7;
    spacing:       8px 12px;
    cycle:         true;
    dynamic:       true;
    fixed-height:  false;
    fixed-columns: true;
    flow:          horizontal;
    scrollbar:     false;
}

element {
    orientation:   horizontal;
    padding:       10px 14px;
    spacing:       14px;
    border-radius: 12px;
    border:        1px;
    border-color:  transparent;
    cursor:        pointer;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
}

element selected.normal {
    background-image: linear-gradient(to right, #7aa2f726, #bb9af71f);
    background-color: @surface0;
    border-color:     #7aa2f766;
}

element-icon {
    size:           36px;
    cursor:         inherit;
    vertical-align: 0.5;
}

element-text {
    highlight:        bold #bb9af7;
    horizontal-align: 0;
    vertical-align:   0.5;
    text-color:       @subtext;
    cursor:           inherit;
}

element selected.normal element-text {
    text-color: @text;
}
