# MailCrab: correo de desarrollo (SMTP en 127.0.0.1:1025, web en https://mail.test).
# La web la atiende mail-http.socket (127.0.0.1:11080), que despierta MailCrab al primer acceso.
mail.test {
	bind 127.0.0.1
	tls internal

	# Sin compresión: en loopback solo añade CPU, también al descomprimir.
	# Los recursos con hash no cambian nunca: el navegador los guarda (y el wasm
	# compilado), así que al volver a entrar la interfaz aparece al instante.
	@conhash path_regexp ^/static/.*-[0-9a-f]{16}(_bg)?\.(js|css|wasm)$
	header @conhash Cache-Control "public, max-age=31536000, immutable"

	# La página original lleva SRI en su CSS, que por eso no se puede sustituir:
	# se añade www/mail/zen.css a su HTML. Así no depende de los hashes de la imagen.
	handle / {
		header Cache-Control no-cache
		root * /srv/mail
		rewrite * /pagina.html
		templates
		file_server
	}
	handle /__origen {
		rewrite * /
		reverse_proxy 127.0.0.1:11080
	}
	handle /zen.css {
		header Cache-Control no-cache
		root * /srv/mail
		file_server
	}
	handle {
		reverse_proxy 127.0.0.1:11080
	}
}
