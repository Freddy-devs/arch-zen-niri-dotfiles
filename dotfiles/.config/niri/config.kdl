// arch-zen-niri — config de niri con "feeling" bspwm/sxhkd
// Referencia completa: https://github.com/YaLTeR/niri/wiki/Configuration:-Introduction
// Nota: niri es scrollable-tiling (columnas en una tira horizontal), no BSP.
//       Mod+R cicla anchos 1/3 · 1/2 · 2/3 para simular las divisiones de bspwm.

input {
    keyboard {
        // teclado: latam por defecto (el primero) e inglés (us); se alterna con Super+Alt+Space
        // o con clic en el idioma de la barra
        xkb {
            layout "latam,us"
        }
        repeat-delay 300
        repeat-rate 40
        numlock
    }
    touchpad {
        tap
        natural-scroll
        dwt
    }
    mouse {
        accel-profile "flat"
    }
    // como bspwm con focus_follows_pointer
    focus-follows-mouse max-scroll-amount="0%"
    warp-mouse-to-focus
}

// sin esquina activa: estaba sobre el logo de Arch y abría la vista general (usa Super+O)
gestures {
    hot-corners {
        off
    }
}

layout {
    // separación mínima entre ventanas
    gaps 5
    center-focused-column "never"
    always-center-single-column

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }
    default-column-width { proportion 0.5; }

    preset-window-heights {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    // ventana activa: anillo con degradado azul → morado (paleta de la barra)
    // borde fino y translúcido, a juego con el 1px de la barra
    focus-ring {
        width 1
        active-gradient from="#7aa2f780" to="#bb9af780" angle=45 relative-to="workspace-view"
        inactive-color "#3b426150"
        urgent-color "#f7768e"
    }
    border {
        off
    }
    // sin sombras en las ventanas
    shadow {
        off
    }
    tab-indicator {
        width 4
        gap 4
        corner-radius 4
        active-gradient from="#7aa2f7" to="#bb9af7" angle=90
        inactive-color "#3b4261"
    }
    struts {
        left 0
        right 0
        top 0
        bottom 0
    }
}

cursor {
    xcursor-theme "Qogir-white-cursors"
    xcursor-size 24
    hide-when-typing
}

environment {
    QT_QPA_PLATFORMTHEME "qt6ct"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
}

prefer-no-csd

hotkey-overlay {
    skip-at-startup
}

animations {
    // animaciones fluidas y cortas: resortes suaves al abrir, mover y cambiar de escritorio
    slowdown 0.8
    workspace-switch {
        spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
    }
    window-open {
        duration-ms 180
        curve "ease-out-expo"
    }
    window-close {
        duration-ms 150
        curve "ease-out-quad"
    }
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
}

// vista general (Super+O): fondo oscuro con la paleta de la barra
overview {
    backdrop-color "#16161e"
}

// ---------- autostart ----------
spawn-at-startup "waybar"
// un solo proceso de Alacritty para todas las terminales (menos RAM, abre al instante)
spawn-at-startup "alacritty" "--daemon"
// mako no se lanza: D-Bus lo arranca solo con la primera notificación
// calendario: solo queda en memoria si hay tareas pendientes (clic en el reloj o Super+A)
spawn-at-startup "zen-calendar" "--daemon"
// paneles de la barra residentes y ocultos: abren al instante con zen-toggle
spawn-at-startup "sh" "-c" "~/.local/bin/zen-audio --daemon"
spawn-at-startup "sh" "-c" "~/.local/bin/zen-media --daemon"
spawn-at-startup "sh" "-c" "~/.local/bin/zen-bluetooth --daemon"
spawn-at-startup "sh" "-c" "~/.local/bin/zen-network --daemon"
spawn-at-startup "sh" "-c" "~/.local/bin/zen-brightness --daemon"
spawn-at-startup "swaybg" "-m" "fill" "-i" "/usr/share/backgrounds/zen-niri/wallpaper.jpg"
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"
// historial del portapapeles: solo en RAM ($XDG_RUNTIME_DIR), últimas 10 copias (zen-clip)
spawn-at-startup "sh" "-c" "~/.local/bin/zen-clip watch"
spawn-at-startup "swayidle" "-w" "timeout" "600" "swaylock -f" "timeout" "900" "niri msg action power-off-monitors" "before-sleep" "swaylock -f"
spawn-at-startup "sh" "-c" "gsettings set org.gnome.desktop.interface color-scheme prefer-dark; gsettings set org.gnome.desktop.interface gtk-theme TokyoNight-Dark; gsettings set org.gnome.desktop.interface icon-theme Nordzy-dark; gsettings set org.gnome.desktop.interface font-name 'Inter 11'; gsettings set org.gnome.desktop.interface cursor-theme Qogir-white-cursors"
spawn-at-startup "/usr/local/bin/zen-first-login"

// ---------- reglas de ventana ----------
window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
}

window-rule {
    match is-active=false
    opacity 0.94
}

// flotantes (como bspc rule -a ... state=floating)
window-rule {
    match app-id=r#"^pavucontrol$"#
    match app-id=r#"^org\.pulseaudio\.pavucontrol$"#
    match app-id=r#"^blueman-manager$"#
    match app-id=r#"^nm-connection-editor$"#
    match app-id=r#"^imv$"#
    match title=r#"^Picture-in-Picture$"#
    open-floating true
}

// paneles en terminal (Bluetooth, audio, red, zen-apps): flotantes y centrados
window-rule {
    match app-id=r#"^zen-tui$"#
    open-floating true
    default-column-width { fixed 900; }
    default-window-height { fixed 560; }
}

window-rule {
    match app-id=r#"^brave-browser$"#
    default-column-width { proportion 0.66667; }
}

// flameshot: su capa de selección cubre la pantalla entera, sin bordes ni animación
window-rule {
    match app-id=r#"^flameshot$"#
    open-floating true
    open-fullscreen true
    border { off; }
    focus-ring { off; }
    shadow { off; }
    geometry-corner-radius 0
}

// ventanas sensibles fuera de capturas/screencast
window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    block-out-from "screen-capture"
}

layer-rule {
    match namespace="^notifications$"
    block-out-from "screencast"
}

// barra: vidrio esmerilado (desenfoca lo que hay detrás), esquinas de 8 px, sin sombra
layer-rule {
    match namespace="^waybar$"
    geometry-corner-radius 8
    background-effect { blur true; }
    shadow { off; }
}

layer-rule {
    match namespace="^zen-bluetooth$"
    match namespace="^zen-network$"
    match namespace="^zen-audio$"
    match namespace="^zen-media$"
    match namespace="^zen-brightness$"
    match namespace="^zen-calendar$"
    geometry-corner-radius 14
    // sombra muy suave y difusa para los popups
    shadow {
        on
        softness 30
        spread 0
        offset x=0 y=4
        color "#00000030"
    }
}

// ---------- atajos (estilo sxhkd) ----------
// 10 escritorios fijos (existen aunque estén vacíos): 1-5 en el monitor externo (principal) y
// 6-10 en la pantalla de la laptop. Con una sola pantalla los 10 quedan en ella. Nombres: niri msg outputs
workspace "1" { open-on-output "HDMI-A-1"; }
workspace "2" { open-on-output "HDMI-A-1"; }
workspace "3" { open-on-output "HDMI-A-1"; }
workspace "4" { open-on-output "HDMI-A-1"; }
workspace "5" { open-on-output "HDMI-A-1"; }
workspace "6" { open-on-output "eDP-1"; }
workspace "7" { open-on-output "eDP-1"; }
workspace "8" { open-on-output "eDP-1"; }
workspace "9" { open-on-output "eDP-1"; }
workspace "10" { open-on-output "eDP-1"; }

binds {
    // lista de atajos: Super+F1 (en latam/es no hay tecla "/" sin Shift, por eso Super+Shift+/ no llega)
    Mod+F1 hotkey-overlay-title="Ver todos los atajos" { show-hotkey-overlay; }
    Mod+Shift+Slash { show-hotkey-overlay; }

    // apps
    Mod+Return hotkey-overlay-title="Terminal" { spawn-sh "~/.local/bin/zen-term"; }
    Mod+Space hotkey-overlay-title="Lanzador" { spawn "rofi" "-show" "drun"; }
    Mod+D { spawn "rofi" "-show" "drun"; }
    Mod+B hotkey-overlay-title="Lanzador de apps" { spawn "rofi" "-show" "drun"; }
    Mod+A hotkey-overlay-title="Calendario y tareas" { spawn "zen-calendar"; }
    // paneles de la barra sin mouse: la misma tecla abre y cierra (Esc también cierra)
    Mod+M hotkey-overlay-title="Reproductor de música" { spawn-sh "~/.local/bin/zen-toggle media"; }
    Mod+S hotkey-overlay-title="Sonido (volumen, salidas, micrófono)" { spawn-sh "~/.local/bin/zen-toggle audio"; }
    Mod+Shift+B hotkey-overlay-title="Bluetooth" { spawn-sh "~/.local/bin/zen-toggle bluetooth"; }
    Mod+N hotkey-overlay-title="Red y Wi-Fi" { spawn-sh "~/.local/bin/zen-toggle network"; }
    Mod+I hotkey-overlay-title="Brillo de cada pantalla" { spawn-sh "~/.local/bin/zen-toggle brightness"; }
    Mod+E hotkey-overlay-title="Archivos (Thunar)" { spawn "thunar"; }
    Mod+V hotkey-overlay-title="Portapapeles: elegir y copiar" { spawn-sh "~/.local/bin/zen-clip menu"; }
    // Alt+Shift+V: últimas 10 copias, flechas + Enter pega al instante (también en la terminal)
    Alt+Shift+V hotkey-overlay-title="Portapapeles: elegir y pegar" { spawn-sh "~/.local/bin/zen-clip pick"; }
    Mod+Alt+L hotkey-overlay-title="Bloquear" { spawn "swaylock" "-f"; }
    Mod+Alt+Space hotkey-overlay-title="Idioma del teclado (latam / inglés)" { switch-layout "next"; }

    // cerrar / salir / apagar
    Mod+C hotkey-overlay-title="Cerrar ventana" repeat=false { close-window; }
    Mod+W repeat=false { close-window; }
    Mod+Shift+C hotkey-overlay-title="Menú de energía" { spawn "zen-power"; }
    Mod+Alt+Q { quit; }
    Ctrl+Alt+Delete { quit; }
    Mod+Shift+P { power-off-monitors; }

    // foco  (super + {h,j,k,l})
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }
    Mod+J     { focus-window-or-workspace-down; }
    Mod+K     { focus-window-or-workspace-up; }
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Down  { focus-window-or-workspace-down; }
    Mod+Up    { focus-window-or-workspace-up; }
    Mod+Home  { focus-column-first; }
    Mod+End   { focus-column-last; }

    // mover  (super + shift + {h,j,k,l})
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+L     { move-column-right; }
    Mod+Shift+J     { move-window-down-or-to-workspace-down; }
    Mod+Shift+K     { move-window-up-or-to-workspace-up; }
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Down  { move-window-down-or-to-workspace-down; }
    Mod+Shift+Up    { move-window-up-or-to-workspace-up; }

    // monitores
    Mod+Ctrl+H { focus-monitor-left; }
    Mod+Ctrl+L { focus-monitor-right; }
    Mod+Ctrl+Shift+H { move-column-to-monitor-left; }
    Mod+Ctrl+Shift+L { move-column-to-monitor-right; }

    // escritorios: Super+número cambia de escritorio, Super+Shift+número lleva la ventana
    // a ese escritorio (Super+Ctrl+número también). El 0 es el escritorio 10.
    Mod+Shift+1 { move-column-to-workspace "1"; }
    Mod+Shift+2 { move-column-to-workspace "2"; }
    Mod+Shift+3 { move-column-to-workspace "3"; }
    Mod+Shift+4 { move-column-to-workspace "4"; }
    Mod+Shift+5 { move-column-to-workspace "5"; }
    Mod+Shift+6 { move-column-to-workspace "6"; }
    Mod+Shift+7 { move-column-to-workspace "7"; }
    Mod+Shift+8 { move-column-to-workspace "8"; }
    Mod+Shift+9 { move-column-to-workspace "9"; }
    Mod+Shift+0 { move-column-to-workspace "10"; }
    Mod+1 { focus-workspace "1"; }
    Mod+2 { focus-workspace "2"; }
    Mod+3 { focus-workspace "3"; }
    Mod+4 { focus-workspace "4"; }
    Mod+5 { focus-workspace "5"; }
    Mod+6 { focus-workspace "6"; }
    Mod+7 { focus-workspace "7"; }
    Mod+8 { focus-workspace "8"; }
    Mod+9 { focus-workspace "9"; }
    Mod+0 { focus-workspace "10"; }
    Mod+Ctrl+1 { move-column-to-workspace "1"; }
    Mod+Ctrl+2 { move-column-to-workspace "2"; }
    Mod+Ctrl+3 { move-column-to-workspace "3"; }
    Mod+Ctrl+4 { move-column-to-workspace "4"; }
    Mod+Ctrl+5 { move-column-to-workspace "5"; }
    Mod+Ctrl+6 { move-column-to-workspace "6"; }
    Mod+Ctrl+7 { move-column-to-workspace "7"; }
    Mod+Ctrl+8 { move-column-to-workspace "8"; }
    Mod+Ctrl+9 { move-column-to-workspace "9"; }
    Mod+Ctrl+0 { move-column-to-workspace "10"; }
    Mod+Tab { focus-workspace-previous; }
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up   { focus-workspace-up; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }
    Mod+WheelScrollRight { focus-column-right; }
    Mod+WheelScrollLeft  { focus-column-left; }

    // estados (super + {t,s,f})
    Mod+T { toggle-window-floating; }
    Mod+Shift+T { switch-focus-between-floating-and-tiling; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+G { toggle-column-tabbed-display; }
    Mod+O repeat=false { toggle-overview; }

    // columnas: apilar / separar (equivalente a preselección de bspwm)
    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    // lo mismo en latam (las teclas { y } de la derecha de la Ñ)
    Mod+BraceLeft  { consume-or-expel-window-left; }
    Mod+BraceRight { consume-or-expel-window-right; }
    Mod+Ctrl+C { center-column; }

    // tamaños
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }
    // en latam/es "=" va con Shift (y niri usa la tecla sin Shift): agrandar con la tecla "+"
    Mod+Plus { set-column-width "+10%"; }
    Mod+Shift+Plus { set-window-height "+10%"; }
    // Super+Ctrl+Shift+flechas: cambia el tamaño de la ventana con foco
    Mod+Ctrl+Shift+Left  { set-column-width "-5%"; }
    Mod+Ctrl+Shift+Right { set-column-width "+5%"; }
    Mod+Ctrl+Shift+Up    { set-window-height "-5%"; }
    Mod+Ctrl+Shift+Down  { set-window-height "+5%"; }

    // capturas con flameshot (zen-captura): copian al portapapeles y guardan en Imágenes/Capturas
    Print hotkey-overlay-title="Captura: elegir área + anotar" { spawn-sh "~/.local/bin/zen-captura area"; }
    Shift+Print hotkey-overlay-title="Captura: área de la pantalla actual + anotar" { spawn-sh "~/.local/bin/zen-captura recorte"; }
    Ctrl+Print hotkey-overlay-title="Captura de la pantalla actual (directo)" { spawn-sh "~/.local/bin/zen-captura pantalla"; }

    // multimedia
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1.0" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute        allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86AudioPlay        allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext        allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev        allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }

    // escape hatch si una app captura el teclado
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
}
