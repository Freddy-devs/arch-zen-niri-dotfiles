// arch-zen-niri — config de niri con "feeling" bspwm/sxhkd
// Referencia completa: https://github.com/YaLTeR/niri/wiki/Configuration:-Introduction
// Nota: niri es scrollable-tiling (columnas en una tira horizontal), no BSP.
//       Mod+R cicla anchos 1/3 · 1/2 · 2/3 para simular las divisiones de bspwm.

input {
    keyboard {
        xkb {
            layout "latam"
        }
        repeat-delay 300
        repeat-rate 40
        numlock
    }
    touchpad {
        tap
        natural-scroll
        dwt
    }
    mouse {
        accel-profile "flat"
    }
    // como bspwm con focus_follows_pointer
    focus-follows-mouse max-scroll-amount="0%"
    warp-mouse-to-focus
}

// sin esquina activa: estaba sobre el logo de Arch y abría la vista general (usa Super+O)
gestures {
    hot-corners {
        off
    }
}

layout {
    gaps 10
    center-focused-column "never"
    always-center-single-column

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }
    default-column-width { proportion 0.5; }

    preset-window-heights {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    // bordes sólidos tipo bspwm (normal_border_color / focused_border_color)
    focus-ring {
        off
    }
    border {
        width 2
        active-color "#89b4fa"
        inactive-color "#313244"
        urgent-color "#f38ba8"
    }
    shadow {
        off
    }
    tab-indicator {
        active-color "#89b4fa"
        inactive-color "#45475a"
    }
    struts {
        left 0
        right 0
        top 0
        bottom 0
    }
}

cursor {
    xcursor-theme "Adwaita"
    xcursor-size 24
    hide-when-typing
}

environment {
    QT_QPA_PLATFORMTHEME "qt6ct"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
}

prefer-no-csd

hotkey-overlay {
    skip-at-startup
}

screenshot-path "~/Pictures/Screenshots/%Y-%m-%d_%H-%M-%S.png"

animations {
    // animaciones cortas y discretas
    slowdown 0.7
}

// ---------- autostart ----------
spawn-at-startup "waybar"
spawn-at-startup "mako"
spawn-at-startup "swaybg" "-m" "fill" "-i" "/usr/share/backgrounds/zen-niri/wallpaper.png"
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"
spawn-at-startup "nm-applet" "--indicator"
spawn-at-startup "wl-paste" "--watch" "cliphist" "store"
spawn-at-startup "swayidle" "-w" "timeout" "600" "swaylock -f" "timeout" "900" "niri msg action power-off-monitors" "before-sleep" "swaylock -f"
spawn-at-startup "sh" "-c" "gsettings set org.gnome.desktop.interface color-scheme prefer-dark; gsettings set org.gnome.desktop.interface gtk-theme adw-gtk3-dark; gsettings set org.gnome.desktop.interface icon-theme Papirus-Dark"
spawn-at-startup "/usr/local/bin/zen-first-login"

// ---------- reglas de ventana ----------
window-rule {
    geometry-corner-radius 6
    clip-to-geometry true
}

window-rule {
    match is-active=false
    opacity 0.94
}

// flotantes (como bspc rule -a ... state=floating)
window-rule {
    match app-id=r#"^pavucontrol$"#
    match app-id=r#"^org\.pulseaudio\.pavucontrol$"#
    match app-id=r#"^blueman-manager$"#
    match app-id=r#"^nm-connection-editor$"#
    match app-id=r#"^imv$"#
    match title=r#"^Picture-in-Picture$"#
    open-floating true
}

window-rule {
    match app-id=r#"^brave-browser$"#
    default-column-width { proportion 0.66667; }
}

// ventanas sensibles fuera de capturas/screencast
window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    block-out-from "screen-capture"
}

layer-rule {
    match namespace="^notifications$"
    block-out-from "screencast"
}

// ---------- atajos (estilo sxhkd) ----------
binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // apps
    Mod+Return hotkey-overlay-title="Terminal" { spawn "alacritty"; }
    Mod+Space hotkey-overlay-title="Lanzador" { spawn "rofi" "-show" "drun"; }
    Mod+D { spawn "rofi" "-show" "drun"; }
    Mod+B hotkey-overlay-title="Brave" { spawn "brave"; }
    Mod+E hotkey-overlay-title="Archivos (Thunar)" { spawn "thunar"; }
    Mod+V hotkey-overlay-title="Portapapeles" { spawn "sh" "-c" "cliphist list | rofi -dmenu -display-columns 2 -theme ~/.config/rofi/clipboard.rasi | cliphist decode | wl-copy"; }
    Mod+Alt+L hotkey-overlay-title="Bloquear" { spawn "swaylock" "-f"; }

    // cerrar / salir / apagar
    Mod+C hotkey-overlay-title="Cerrar ventana" repeat=false { close-window; }
    Mod+W repeat=false { close-window; }
    Mod+Shift+C hotkey-overlay-title="Menú de energía" { spawn "zen-power"; }
    Mod+Alt+Q { quit; }
    Ctrl+Alt+Delete { quit; }
    Mod+Shift+P { power-off-monitors; }

    // foco  (super + {h,j,k,l})
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }
    Mod+J     { focus-window-or-workspace-down; }
    Mod+K     { focus-window-or-workspace-up; }
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Down  { focus-window-or-workspace-down; }
    Mod+Up    { focus-window-or-workspace-up; }
    Mod+Home  { focus-column-first; }
    Mod+End   { focus-column-last; }

    // mover  (super + shift + {h,j,k,l})
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+L     { move-column-right; }
    Mod+Shift+J     { move-window-down-or-to-workspace-down; }
    Mod+Shift+K     { move-window-up-or-to-workspace-up; }
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Down  { move-window-down-or-to-workspace-down; }
    Mod+Shift+Up    { move-window-up-or-to-workspace-up; }

    // monitores
    Mod+Ctrl+H { focus-monitor-left; }
    Mod+Ctrl+L { focus-monitor-right; }
    Mod+Ctrl+Shift+H { move-column-to-monitor-left; }
    Mod+Ctrl+Shift+L { move-column-to-monitor-right; }

    // escritorios  (super + {_,shift + }{1-9})
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+Tab { focus-workspace-previous; }
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up   { focus-workspace-up; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }
    Mod+WheelScrollRight { focus-column-right; }
    Mod+WheelScrollLeft  { focus-column-left; }

    // estados (super + {t,s,f})
    Mod+T { toggle-window-floating; }
    Mod+Shift+T { switch-focus-between-floating-and-tiling; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+G { toggle-column-tabbed-display; }
    Mod+O repeat=false { toggle-overview; }

    // columnas: apilar / separar (equivalente a preselección de bspwm)
    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Ctrl+C { center-column; }

    // tamaños
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // capturas
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }
    Shift+Print hotkey-overlay-title="Captura + anotar (satty)" { spawn "sh" "-c" "grim -g \"$(slurp)\" - | satty --filename - --copy-command wl-copy"; }

    // multimedia
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1.0" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute        allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86AudioPlay        allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext        allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev        allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }

    // escape hatch si una app captura el teclado
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
}
