# Caddy general (bajo demanda): lo despiertan caddy-http.socket / caddy-https.socket al primer
# acceso a un *.test y se detiene solo cuando ninguno lo necesita. Sitios: ~/.config/caddy/sites/.
[Unit]
Description=Caddy local para todos los proyectos *.test (bajo demanda)
StopWhenUnneeded=yes

[Quadlet]
# Ver mailcrab.container: no debe esperar a network-online.target al despertar.
DefaultDependencies=false

[Container]
Image=docker.io/library/caddy:2-alpine
ContainerName=caddy
Network=host
Volume=%h/.config/caddy:/etc/caddy:ro,Z
Volume=%h/.config/caddy/www:/srv:ro,Z
# CA local y certificados: deben persistir (si no, cada arranque crea una CA nueva sin confianza)
Volume=%h/.local/share/caddy:/data:Z

[Service]
ExecStartPost=/usr/bin/bash -c 'for i in {1..150}; do (exec 3<>/dev/tcp/127.0.0.1/18443) 2>/dev/null && exit 0; sleep 0.1; done; exit 1'
TimeoutStartSec=180
