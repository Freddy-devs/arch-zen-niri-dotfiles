# mako — notificaciones · Nord (misma paleta que la barra)
font=Inter 11
background-color=#242933f2
text-color=#eceff4
border-color=#88c0d0
progress-color=over #434c5e
border-size=2
border-radius=14
padding=14,16
margin=10
outer-margin=6,10
width=380
anchor=top-right
default-timeout=5000
icons=1
max-icon-size=48
icon-path=/usr/share/icons/Nordzy-dark:/usr/share/icons/Papirus-Dark
format=<b>%s</b>\n%b
# clic: acción por defecto · clic central: elegir acción (tareas: hecha / posponer) · derecho: cerrar
on-button-middle=exec makoctl menu -n "$id" rofi -dmenu -p "Acción"

[urgency=low]
border-color=#434c5e
text-color=#d8dee9

[urgency=critical]
border-color=#bf616a
background-color=#1f1a24f2
default-timeout=0
