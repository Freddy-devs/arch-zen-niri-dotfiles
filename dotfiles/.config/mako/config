font=Inter 11
background-color=#1a1b26
text-color=#c0caf5
border-color=#7aa2f7
progress-color=over #292e42
border-size=1
border-radius=12
padding=12
margin=6
outer-margin=4
width=360
anchor=top-right
default-timeout=5000
icons=1
max-icon-size=48
# clic: acción por defecto · clic central: elegir acción (tareas: hecha / posponer) · derecho: cerrar
on-button-middle=exec makoctl menu -n "$id" rofi -dmenu -p "Acción"

[urgency=low]
border-color=#292e42

[urgency=critical]
border-color=#f7768e
default-timeout=0
