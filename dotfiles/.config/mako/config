# mako — notificaciones · TokyoNight (misma paleta que la barra)
font=Inter 11
background-color=#1a1b26f2
text-color=#c0caf5
border-color=#7aa2f7
progress-color=over #3b4261
border-size=2
border-radius=14
padding=14,16
margin=10
outer-margin=6,10
width=380
anchor=top-right
default-timeout=5000
icons=1
max-icon-size=48
icon-path=/usr/share/icons/Nordzy-dark:/usr/share/icons/Papirus-Dark
format=<b>%s</b>\n%b
# clic: acción por defecto · clic central: elegir acción (tareas: hecha / posponer) · derecho: cerrar
on-button-middle=exec makoctl menu -n "$id" rofi -dmenu -p "Acción"

[urgency=low]
border-color=#3b4261
text-color=#a9b1d6

[urgency=critical]
border-color=#f7768e
background-color=#1f1a24f2
default-timeout=0
