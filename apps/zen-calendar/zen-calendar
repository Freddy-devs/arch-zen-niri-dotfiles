MONTHS = ("enero", "febrero", "marzo", "abril", "mayo", "junio", "julio", "agosto", "setiembre",
          "octubre", "noviembre", "diciembre")
DAYS = ("lunes", "martes", "miércoles", "jueves", "viernes", "sábado", "domingo")
DAYS_SHORT = ("lu", "ma", "mi", "ju", "vi", "sá", "do")
KINDS = ("feriado", "nolaborable", "fecha")   # orden de prioridad para pintar el día


def capitalize(s):
    return s[:1].upper() + s[1:]


def long_date(d):
    return f"{DAYS[d.weekday()]} {d.day} de {MONTHS[d.month - 1]}"


def hour12(h):
    return 12 if h % 12 == 0 else h % 12


def fmt_time(hhmm):
    h, _, m = hhmm.partition(":")
    try:
        h = int(h)
    except ValueError:
        h = 0
    return f"{hour12(h)}:{m or '0'} {'pm' if h >= 12 else 'am'}"


def relative_days(d, today):
    n = (d - today).days
    if n == 0:
        return "hoy"
    if n == 1:
        return "mañana"
    if n == -1:
        return "ayer"
    return f"en {n} días" if n > 0 else f"hace {-n} días"


def label(text, css=""):
    lbl = Gtk.Label(label=text, xalign=0.0)
    for c in css.split():
        lbl.add_css_class(c)
    return lbl


def hbox(spacing, css=""):
    b = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=spacing)
    for c in css.split():
        b.add_css_class(c)
    return b


def vbox(css=""):
    b = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
    for c in css.split():
        b.add_css_class(c)
    return b


def clear(box):
    while (child := box.get_first_child()) is not None:
        box.remove(child)


def now_min():
    return datetime.now().replace(second=0, microsecond=0)


def stamp(dt):
    return dt.strftime("%Y-%m-%d %H:%M")


def play(sound):
    if os.path.exists(sound):
        try:
            Gio.Subprocess.new(["pw-play", sound],
                               Gio.SubprocessFlags.STDOUT_SILENCE | Gio.SubprocessFlags.STDERR_SILENCE)
        except GLib.Error:
            pass


